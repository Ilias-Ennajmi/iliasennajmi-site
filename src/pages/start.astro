---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getStartHerePath } from '../lib/essays';

const path = await getStartHerePath();
const items = path.map(({ entry, strand }, i) => ({
  step: i + 1,
  title: entry.data.title,
  standfirst: entry.data.standfirst,
  tag: entry.data.tag,
  href: `/essays/${entry.data.id}/`,
  strand: strand === 'ulysses' ? 'Ulysses' : 'Ilias',
  accent: strand === 'ulysses' ? 'var(--tide)' : 'var(--ember)',
}));
---
<BaseLayout
  title="Start Here — Ilias Ennajmi"
  description="New here? Four essays, in a deliberate order, that show the site's whole thesis in miniature."
  active="home"
  siteFx
>
<main id="main-content">
  <header data-cursor-light style="position:relative;overflow:hidden;padding:clamp(8rem,16vh,12rem) clamp(22px,6vw,64px) clamp(3.5rem,7vw,6rem);">
    <div style="position:absolute;inset:0;z-index:0;background:radial-gradient(120% 90% at 50% 8%, rgba(117,89,56,0.10), transparent 56%), linear-gradient(180deg,var(--paper-hi) 0%,var(--paper-mid) 60%,var(--coal) 100%);"></div>
    <div style="position:relative;z-index:1;max-width:1180px;margin:0 auto;animation:cc-rise .9s ease both;">
      <div style="display:flex;align-items:center;gap:14px;font-family:var(--mono);font-size:0.68rem;letter-spacing:0.24em;text-transform:uppercase;color:var(--ash);margin-bottom:clamp(1.6rem,3vw,2.4rem);">
        <span style="width:28px;height:1px;background:var(--ember);"></span>New here? Start with these
      </div>
      <h1 style="margin:0;font-family:var(--display);font-weight:500;font-size:clamp(3rem,9vw,6.5rem);line-height:0.94;letter-spacing:-0.015em;">Start Here<span style="color:var(--ember-vivid);">.</span></h1>
      <p style="font-family:var(--body);font-weight:300;font-style:italic;font-size:clamp(1.15rem,2.2vw,1.5rem);color:var(--bone);opacity:0.82;max-width:56ch;margin:1.6rem 0 0;line-height:1.5;text-wrap:pretty;">Four essays, in this order, that show the whole idea in miniature: for every "why people act," there's a "who profits" waiting right behind it.</p>
    </div>
  </header>

  <section style="max-width:820px;margin:0 auto;padding:0 clamp(22px,6vw,64px) clamp(6rem,10vw,8rem);">
    {items.map((item, i) => (
      <Fragment>
        <a href={item.href} data-reveal class="charge start-item" style="display:block;padding:clamp(2.2rem,4vw,3rem) 0;border-bottom:1px solid var(--coal-line);">
          <div style="display:flex;align-items:center;gap:14px;margin-bottom:1rem;font-family:var(--mono);font-size:0.64rem;letter-spacing:0.18em;text-transform:uppercase;">
            <span style={`width:30px;height:30px;border:1px solid ${item.accent};color:${item.accent};display:flex;align-items:center;justify-content:center;flex:none;`}>{item.step}</span>
            <span style={`color:${item.accent};`}>{item.strand} — {item.tag}</span>
          </div>
          <div class="start-title" style="font-family:var(--display);font-weight:500;font-size:clamp(1.6rem,3.4vw,2.4rem);line-height:1.1;letter-spacing:-0.01em;transition:color .3s;text-wrap:balance;">{item.title}</div>
          <p style="font-family:var(--body);font-weight:300;font-style:italic;color:var(--ash);font-size:clamp(1rem,1.6vw,1.15rem);margin:0.7rem 0 0;line-height:1.5;text-wrap:pretty;">{item.standfirst}</p>
        </a>
        {i === 0 && (
          <div data-reveal style="padding:1.6rem 0 0;text-align:center;font-family:var(--mono);font-size:0.6rem;letter-spacing:0.16em;text-transform:uppercase;color:var(--ash);">↓ Now see who profits from exactly that ↓</div>
        )}
        {i === 2 && (
          <div data-reveal style="padding:1.6rem 0 0;text-align:center;font-family:var(--mono);font-size:0.6rem;letter-spacing:0.16em;text-transform:uppercase;color:var(--ash);">↓ And the machinery built to exploit it ↓</div>
        )}
      </Fragment>
    ))}
    <div data-reveal style="padding-top:clamp(3rem,5vw,4rem);text-align:center;">
      <p style="font-family:var(--body);font-style:italic;color:var(--ash);font-size:1.1rem;margin:0 0 1.6rem;">That's the whole shape of it. Everything else is the long version.</p>
      <a href="/ulysses/" class="charge" style="font-family:var(--mono);font-size:0.7rem;letter-spacing:0.18em;text-transform:uppercase;color:var(--tide);border:1px solid var(--coal-line);border-radius:40px;padding:14px 26px;display:inline-block;margin:0 8px;">See all Ulysses →</a>
      <a href="/ilias/" class="charge" style="font-family:var(--mono);font-size:0.7rem;letter-spacing:0.18em;text-transform:uppercase;color:var(--ember);border:1px solid var(--coal-line);border-radius:40px;padding:14px 26px;display:inline-block;margin:0 8px;">See all Ilias →</a>
    </div>
  </section>
</main>
</BaseLayout>

<style>
  .start-item:hover .start-title { color: var(--tide); }
</style>

<script>
  document.addEventListener('astro:page-load', () => {
    window.pageBoot({ strand: null, progress: 'page' });
  });
</script>
