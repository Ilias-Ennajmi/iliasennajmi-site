---
import BaseLayout from '../layouts/BaseLayout.astro';
import EssayConstellation from '../components/EssayConstellation.astro';
import { getPublishedCollection, readTimeOf } from '../lib/essays';
import { hasIllustration } from '../lib/illus';

const ulysses = (await getPublishedCollection('ulysses')).map((e) => ({
  id: e.data.id,
  title: e.data.title,
  tag: e.data.tag,
  read: readTimeOf(e),
  date: e.data.date,
  order: e.data.order,
  strand: 'Ulysses',
  accent: 'var(--tide)',
  href: `/essays/${e.data.id}/`,
}));
const ilias = (await getPublishedCollection('ilias')).map((e) => ({
  id: e.data.id,
  title: e.data.title,
  tag: e.data.tag,
  read: readTimeOf(e),
  date: e.data.date,
  order: e.data.order,
  strand: 'Ilias',
  accent: 'var(--ember)',
  href: `/essays/${e.data.id}/`,
}));

const all = [...ulysses, ...ilias].sort((a, b) => (a.order ?? 999) - (b.order ?? 999) || a.title.localeCompare(b.title));
const byTag = new Map<string, typeof all>();
all.forEach((e) => {
  const list = byTag.get(e.tag) ?? [];
  list.push(e);
  byTag.set(e.tag, list);
});
const tags = Array.from(byTag.keys()).sort((a, b) => a.localeCompare(b));

// small geometric mark per tag, from the site's diamond/Greek-key family;
// deterministic by tag order so a tag keeps its icon as others come and go
const marks = [
  // solid diamond
  '<path d="M9 2l7 7-7 7-7-7z"/>',
  // outlined diamond, solid core
  '<path d="M9 2l7 7-7 7-7-7z" fill="none" stroke="currentColor" stroke-width="1.2"/><path d="M9 6l3 3-3 3-3-3z"/>',
  // meander corner (Greek key)
  '<path d="M3 15V3h12v4H8v3h5v5z" fill="none" stroke="currentColor" stroke-width="1.4"/>',
  // diamond pair
  '<path d="M6 2l4 4-4 4-4-4z"/><path d="M12 8l4 4-4 4-4-4z" fill="none" stroke="currentColor" stroke-width="1.2"/>',
  // laurel chevron
  '<path d="M9 16V5M9 8L4 4M9 8l5-4M9 13l-5-4M9 13l5-4" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/>',
  // nested diamonds
  '<path d="M9 1l8 8-8 8-8-8z" fill="none" stroke="currentColor" stroke-width="1.1"/><path d="M9 5l4 4-4 4-4-4z" fill="none" stroke="currentColor" stroke-width="1.1"/><circle cx="9" cy="9" r="1.4"/>',
];
const markFor = (i: number) => marks[i % marks.length];
---
<BaseLayout
  title="Topics · Ilias Ennajmi"
  description="Every essay, browsable by topic, across both Ulysses and Ilias, no strand required."
  active="topics"
  siteFx
>
<main id="main-content">
  <header data-cursor-light style="position:relative;overflow:hidden;padding:clamp(8rem,16vh,12rem) clamp(22px,6vw,64px) clamp(3.5rem,7vw,6rem);">
    <div style="position:absolute;inset:0;z-index:0;background:linear-gradient(180deg,var(--paper-hi) 0%,var(--paper-mid) 60%,var(--coal) 100%);"></div>
    <div style="position:absolute;inset:-12%;z-index:0;background:radial-gradient(55% 48% at 50% 16%, rgba(117,89,56,0.10), transparent 60%);animation:cc-drift1 24s ease-in-out infinite;"></div>
    <div style="position:relative;z-index:1;max-width:1180px;margin:0 auto;animation:cc-rise .9s ease both;">
      <div style="display:flex;align-items:center;gap:14px;font-family:var(--mono);font-size:var(--fs-xs);letter-spacing:0.24em;text-transform:uppercase;color:var(--ash);margin-bottom:clamp(1.6rem,3vw,2.4rem);">
        <span style="width:28px;height:1px;background:var(--ember);"></span>Every essay, one index
      </div>
      <h1 style="margin:0;font-family:var(--display);font-weight:500;font-size:var(--fs-title);line-height:0.94;letter-spacing:-0.015em;">Topics<span style="color:var(--ember-vivid);">.</span></h1>
      <p style="font-family:var(--body);font-weight:300;font-style:italic;font-size:clamp(1.15rem,2.2vw,1.5rem);color:var(--bone);opacity:0.82;max-width:52ch;margin:1.6rem 0 0;line-height:1.5;text-wrap:pretty;">Ulysses and Ilias, side by side. Browse by theme instead of by strand.</p>
    </div>
  </header>

  <section style="max-width:1180px;margin:0 auto;padding:0 clamp(22px,6vw,64px) clamp(5rem,9vw,7.5rem);">
    <div data-reveal class="tx-map" style="padding-bottom:clamp(1.6rem,3vw,2.4rem);border-bottom:1px solid var(--coal-line);">
      <div style="display:flex;align-items:center;gap:16px;margin-bottom:clamp(1.6rem,3vw,2.4rem);font-family:var(--mono);font-size:var(--fs-2xs);letter-spacing:0.18em;text-transform:uppercase;color:var(--ash);">
        <span style="width:6px;height:6px;background:var(--ember);transform:rotate(45deg);display:inline-block;flex:none;"></span>
        <span style="color:var(--bone);font-size:0.8rem;">The map</span>
        <span class="cc-rule"></span>
      </div>
      <EssayConstellation />
    </div>

    <div data-reveal class="tx-head">
      <div class="tx-chips" role="group" aria-label="Filter by theme">
        <button type="button" class="tx-chip" data-filter="all" aria-pressed="true">All <span class="tx-chip-n">{all.length}</span></button>
        {tags.map((tag, i) => (
          <button type="button" class="tx-chip" data-filter={tag} aria-pressed="false">
            <svg aria-hidden="true" width="14" height="14" viewBox="0 0 18 18" fill="currentColor" set:html={markFor(i)} />
            {tag.replace(/^On /, '')} <span class="tx-chip-n">{byTag.get(tag)!.length}</span>
          </button>
        ))}
      </div>
      <p class="tx-count" aria-live="polite"><span data-count>{all.length}</span> essays</p>
    </div>
    <ol class="tx-list" data-list>
      {all.map((e, i) => (
        <li class="tx-row" data-tag={e.tag} data-strand={e.strand}>
          <a href={e.href} class="charge tx-link m-lift">
            <span class="tx-no">{hasIllustration(e.id) ? <img src={`/illus/${e.id}-92.png`} alt="" aria-hidden="true" class="illus illus--thumb illus--row" loading="lazy" decoding="async" /> : String(i + 1).padStart(2, '0')}</span>
            <span class="tx-main">
              <span class="tx-meta"><span style={`color:${e.accent}`}>{e.strand}</span><span>{e.tag}</span></span>
              <span class="tx-title" style={`view-transition-name:essay-${e.id}`}>{e.title}</span>
            </span>
            <span class="tx-side"><span>{e.read}</span><span>{e.date}</span></span>
          </a>
        </li>
      ))}
    </ol>
    <p class="tx-empty" data-empty hidden>Nothing filed under that yet.</p>
  </section>
</main>
</BaseLayout>

<style is:global>
  .tx-head { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 14px 24px; padding: clamp(1.8rem, 3vw, 2.6rem) 0 1.2rem; }
  .tx-chips { display: flex; flex-wrap: wrap; gap: 8px; }
  .tx-chip { display: inline-flex; align-items: center; gap: 7px; min-height: 40px; padding: 0 14px; background: none; border: 1px solid var(--coal-line); color: var(--ash); font-family: var(--mono); font-size: 0.75rem; letter-spacing: 0.14em; text-transform: uppercase; cursor: pointer; transition: color var(--dur-base), border-color var(--dur-base), background var(--dur-base); }
  .tx-chip:hover { color: var(--bone); border-color: var(--bone); }
  .tx-chip[aria-pressed="true"] { background: var(--bone); color: var(--coal); border-color: var(--bone); }
  .tx-chip svg { color: var(--ember); } .tx-chip[aria-pressed="true"] svg { color: var(--coal); }
  .tx-chip-n { opacity: .6; font-weight: 400; }
  .tx-count { margin: 0; font-family: var(--mono); font-size: 0.75rem; letter-spacing: 0.14em; text-transform: uppercase; color: var(--ash); }
  .tx-list { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--coal-line); }
  .tx-row[hidden] { display: none; }
  .tx-link { display: grid; grid-template-columns: 56px minmax(0, 1fr) auto; gap: clamp(14px, 3vw, 36px); align-items: baseline; padding: clamp(1.3rem, 2.6vw, 1.9rem) clamp(6px, 1vw, 14px); border-bottom: 1px solid var(--coal-line); color: var(--bone); text-decoration: none; transition: background var(--dur-base); }
  .tx-link:hover { background: var(--coal-soft); }
  .tx-no { font-family: var(--mono); font-size: 0.75rem; letter-spacing: 0.06em; color: var(--ash); }
  .tx-main { min-width: 0; display: flex; flex-direction: column; gap: 0.4rem; }
  .tx-meta { display: flex; flex-wrap: wrap; gap: 14px; font-family: var(--mono); font-size: 0.75rem; letter-spacing: 0.14em; text-transform: uppercase; color: var(--ash); }
  .tx-title { font-family: var(--display); font-weight: 500; font-size: clamp(1.35rem, 2.8vw, 2rem); line-height: 1.06; letter-spacing: -0.01em; text-wrap: balance; transition: color var(--dur-base); }
  .tx-link:hover .tx-title { color: var(--ember); }
  .tx-side { display: flex; flex-direction: column; align-items: flex-end; gap: 4px; font-family: var(--mono); font-size: 0.75rem; letter-spacing: 0.08em; color: var(--ash); white-space: nowrap; text-transform: uppercase; }
  .tx-empty { font-family: var(--body); font-style: italic; color: var(--ash); padding: 2rem 0; }
  @media (max-width: 560px) { .tx-link { grid-template-columns: minmax(0, 1fr) auto; } .tx-no { display: none; } .tx-side span:last-child { display: none; } }
</style>

<script>
  function setupTopics() {
    const chips = Array.from(document.querySelectorAll<HTMLButtonElement>('.tx-chip'));
    const rows = Array.from(document.querySelectorAll<HTMLElement>('.tx-row'));
    const count = document.querySelector<HTMLElement>('[data-count]');
    const empty = document.querySelector<HTMLElement>('[data-empty]');
    if (!chips.length || !rows.length) return;
    const apply = (f: string) => {
      let n = 0;
      rows.forEach((r) => { const on = f === 'all' || r.dataset.tag === f; r.hidden = !on; if (on) n++; });
      chips.forEach((c) => c.setAttribute('aria-pressed', String(c.dataset.filter === f)));
      if (count) count.textContent = String(n);
      if (empty) empty.hidden = n > 0;
      try { history.replaceState(null, '', f === 'all' ? location.pathname : location.pathname + '#' + encodeURIComponent(f)); } catch (e) { /* ignore */ }
    };
    const offs = chips.map((c) => { const h = () => apply(c.dataset.filter || 'all'); c.addEventListener('click', h); return () => c.removeEventListener('click', h); });
    const fromHash = decodeURIComponent(location.hash.slice(1));
    if (fromHash && chips.some((c) => c.dataset.filter === fromHash)) apply(fromHash);
    (window as any).__life?.onLeave(() => offs.forEach((f) => f()));
  }
  document.addEventListener('site:ready', setupTopics);
</script>

