---
import BaseLayout from '../layouts/BaseLayout.astro';
import EssayConstellation from '../components/EssayConstellation.astro';
import { getPublishedCollection, readTimeOf } from '../lib/essays';

const ulysses = (await getPublishedCollection('ulysses')).map((e) => ({
  title: e.data.title,
  tag: e.data.tag,
  read: readTimeOf(e),
  strand: 'Ulysses',
  accent: 'var(--tide)',
  href: `/essays/${e.data.id}/`,
}));
const ilias = (await getPublishedCollection('ilias')).map((e) => ({
  title: e.data.title,
  tag: e.data.tag,
  read: readTimeOf(e),
  strand: 'Ilias',
  accent: 'var(--ember)',
  href: `/essays/${e.data.id}/`,
}));

const all = [...ulysses, ...ilias];
const byTag = new Map<string, typeof all>();
all.forEach((e) => {
  const list = byTag.get(e.tag) ?? [];
  list.push(e);
  byTag.set(e.tag, list);
});
const tags = Array.from(byTag.keys()).sort((a, b) => a.localeCompare(b));

// small geometric mark per tag, from the site's diamond/Greek-key family;
// deterministic by tag order so a tag keeps its icon as others come and go
const marks = [
  // solid diamond
  '<path d="M9 2l7 7-7 7-7-7z"/>',
  // outlined diamond, solid core
  '<path d="M9 2l7 7-7 7-7-7z" fill="none" stroke="currentColor" stroke-width="1.2"/><path d="M9 6l3 3-3 3-3-3z"/>',
  // meander corner (Greek key)
  '<path d="M3 15V3h12v4H8v3h5v5z" fill="none" stroke="currentColor" stroke-width="1.4"/>',
  // diamond pair
  '<path d="M6 2l4 4-4 4-4-4z"/><path d="M12 8l4 4-4 4-4-4z" fill="none" stroke="currentColor" stroke-width="1.2"/>',
  // laurel chevron
  '<path d="M9 16V5M9 8L4 4M9 8l5-4M9 13l-5-4M9 13l5-4" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/>',
  // nested diamonds
  '<path d="M9 1l8 8-8 8-8-8z" fill="none" stroke="currentColor" stroke-width="1.1"/><path d="M9 5l4 4-4 4-4-4z" fill="none" stroke="currentColor" stroke-width="1.1"/><circle cx="9" cy="9" r="1.4"/>',
];
const markFor = (i: number) => marks[i % marks.length];
---
<BaseLayout
  title="Topics — Ilias Ennajmi"
  description="Every essay, browsable by topic — across both Ulysses and Ilias, no strand required."
  active="topics"
  siteFx
>
<main id="main-content">
  <header data-cursor-light style="position:relative;overflow:hidden;padding:clamp(8rem,16vh,12rem) clamp(22px,6vw,64px) clamp(3.5rem,7vw,6rem);">
    <div style="position:absolute;inset:0;z-index:0;background:linear-gradient(180deg,var(--paper-hi) 0%,var(--paper-mid) 60%,var(--coal) 100%);"></div>
    <div style="position:absolute;inset:-12%;z-index:0;background:radial-gradient(55% 48% at 50% 16%, rgba(122,90,76,0.10), transparent 60%);animation:cc-drift1 24s ease-in-out infinite;"></div>
    <div style="position:relative;z-index:1;max-width:1180px;margin:0 auto;animation:cc-rise .9s ease both;">
      <div style="display:flex;align-items:center;gap:14px;font-family:var(--mono);font-size:0.68rem;letter-spacing:0.24em;text-transform:uppercase;color:var(--ash);margin-bottom:clamp(1.6rem,3vw,2.4rem);">
        <span style="width:28px;height:1px;background:var(--ember);"></span>Every essay, one index
      </div>
      <h1 style="margin:0;font-family:var(--display);font-weight:500;font-size:clamp(3rem,9vw,6.5rem);line-height:0.94;letter-spacing:-0.015em;">Topics<span style="color:var(--ember);">.</span></h1>
      <p style="font-family:var(--body);font-weight:300;font-style:italic;font-size:clamp(1.15rem,2.2vw,1.5rem);color:var(--bone);opacity:0.82;max-width:52ch;margin:1.6rem 0 0;line-height:1.5;text-wrap:pretty;">Ulysses and Ilias, side by side. Browse by theme instead of by strand.</p>
    </div>
  </header>

  <section style="max-width:1180px;margin:0 auto;padding:0 clamp(22px,6vw,64px) clamp(5rem,9vw,7.5rem);">
    <div data-reveal style="padding-bottom:clamp(1.6rem,3vw,2.4rem);border-bottom:1px solid var(--coal-line);">
      <div style="display:flex;align-items:center;gap:16px;margin-bottom:clamp(1.6rem,3vw,2.4rem);font-family:var(--mono);font-size:0.66rem;letter-spacing:0.18em;text-transform:uppercase;color:var(--ash);">
        <span style="width:6px;height:6px;background:var(--ember);transform:rotate(45deg);display:inline-block;flex:none;"></span>
        <span style="color:var(--bone);font-size:0.8rem;">The map</span>
        <span class="cc-rule"></span>
      </div>
      <EssayConstellation />
    </div>

    {tags.map((tag, i) => (
      <div data-reveal style="padding:clamp(2.2rem,4vw,3.2rem) 0;border-bottom:1px solid var(--coal-line);">
        <div style="display:flex;align-items:center;gap:16px;margin-bottom:clamp(1.2rem,2vw,1.8rem);font-family:var(--mono);font-size:0.66rem;letter-spacing:0.18em;text-transform:uppercase;color:var(--ash);">
          <svg aria-hidden="true" width="18" height="18" viewBox="0 0 18 18" fill="currentColor" style="flex:none;color:var(--ember);" set:html={markFor(i)} />
          <span style="color:var(--bone);font-size:0.8rem;">{tag}</span>
          <span class="cc-rule"></span>
          <span>{byTag.get(tag)!.length} essay{byTag.get(tag)!.length > 1 ? 's' : ''}</span>
        </div>
        <div style="display:grid;gap:1px;background:var(--coal-line);border:1px solid var(--coal-line);">
          {byTag.get(tag)!.map((e) => (
            <a href={e.href} class="charge topic-row" style="background:var(--coal);display:flex;align-items:center;justify-content:space-between;gap:16px;padding:clamp(16px,2.5vw,22px) clamp(18px,3vw,28px);transition:background .3s;">
              <span style="font-family:var(--display);font-weight:500;font-size:clamp(1.1rem,2vw,1.4rem);letter-spacing:-0.005em;text-wrap:balance;">{e.title}</span>
              <span style={`display:flex;align-items:center;gap:10px;flex:none;font-family:var(--mono);font-size:0.6rem;letter-spacing:0.1em;text-transform:uppercase;color:${e.accent};white-space:nowrap;`}>
                {e.strand}
                <span style="color:var(--ash);">· {e.read}</span>
              </span>
            </a>
          ))}
        </div>
      </div>
    ))}
  </section>
</main>
</BaseLayout>

<style>
  .topic-row:hover { background: var(--coal-soft); }
</style>

<script>
  document.addEventListener('astro:page-load', () => {
    window.pageBoot({ strand: null, progress: 'page' });
  });
</script>
