---
import { render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import NewsletterSignup from '../../components/NewsletterSignup.astro';
import InteractiveAnchor from '../../components/InteractiveAnchor.astro';
import { getPublishedCollection, readMinutesOf, readTimeOf, getPairedEssay } from '../../lib/essays';
import { wordCount } from '../../lib/readTime';
import { shareLinks } from '../../lib/site';

type Strand = 'ulysses' | 'ilias';
interface Enriched {
  entry: CollectionEntry<'ulysses'> | CollectionEntry<'ilias'>;
  strand: Strand;
  accent: 'tide' | 'ember';
  strandLabel: string;
  strandHref: string;
}

export async function getStaticPaths() {
  const ulysses = await getPublishedCollection('ulysses');
  const ilias = await getPublishedCollection('ilias');

  const uly: Enriched[] = ulysses.map((entry) => ({ entry, strand: 'ulysses', accent: 'tide', strandLabel: 'Ulysses', strandHref: '/ulysses/' }));
  const il: Enriched[] = ilias.map((entry) => ({ entry, strand: 'ilias', accent: 'ember', strandLabel: 'Ilias', strandHref: '/ilias/' }));

  const build = (list: Enriched[], oppositeList: Enriched[]) => list.map((item, i) => {
    const prev = list[(i - 1 + list.length) % list.length];
    const next = list[(i + 1) % list.length];
    const pairedRaw = getPairedEssay(item.entry, oppositeList.map((o) => o.entry));
    const paired = pairedRaw ? oppositeList.find((o) => o.entry.data.id === pairedRaw.data.id) ?? null : null;
    return {
      params: { id: item.entry.data.id },
      props: { item, prev, next, paired },
    };
  });

  return [...build(uly, il), ...build(il, uly)];
}

const { item, prev, next, paired } = Astro.props;
const { entry, strand, accent, strandLabel, strandHref } = item;
const accentVar = accent === 'ember' ? 'var(--ember)' : 'var(--tide)';

const { Content, headings } = await render(entry);
const toc = headings.filter((h) => h.depth === 2);
const readMinutes = readMinutesOf(entry);
const readLabel = entry.data.read ?? `${readMinutes} min`;
const endLabel = `Ilias Ennajmi · ${strandLabel}`;
const prevHref = `/essays/${prev.entry.data.id}/`;
const nextHref = `/essays/${next.entry.data.id}/`;
const ogImage = `/og/${entry.data.id}.png`;

const publishedDate = new Date(entry.data.date);
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: entry.data.title,
  description: entry.data.standfirst,
  author: { '@type': 'Person', name: 'Ilias Ennajmi' },
  ...(isNaN(publishedDate.getTime()) ? {} : { datePublished: publishedDate.toISOString() }),
  wordCount: wordCount(entry.body ?? ''),
  articleSection: strandLabel,
  keywords: entry.data.tag,
  mainEntityOfPage: { '@type': 'WebPage', '@id': `/essays/${entry.data.id}/` },
  image: ogImage,
};

const canonicalUrl = new URL(`/essays/${entry.data.id}/`, Astro.site).toString();
const citation = `Ennajmi, Ilias. "${entry.data.title}." Ilias Ennajmi, ${entry.data.date}. ${canonicalUrl}.`;
const share = shareLinks(canonicalUrl, entry.data.title);

// Author-set only (see content.config.ts) -- absent means no tag, same as
// every other nullable-field convention on this site.
const epistemicLabel: Record<string, string> = {
  confident: 'Confident',
  exploratory: 'Still working this out',
  revised: 'Revised since publishing',
};
---
<BaseLayout
  title={`${entry.data.title} — Ilias Ennajmi`}
  description={entry.data.standfirst}
  active="essay"
  ogType="article"
  accent={accentVar}
  ogImage={ogImage}
  jsonLd={jsonLd}
  siteFx
>
<div style={`--acc:${accentVar};`}>
  <div data-reading-meter data-minutes={readMinutes} style="position:fixed;left:clamp(14px,2vw,26px);bottom:clamp(14px,2.4vh,24px);z-index:7200;opacity:0;transition:opacity .5s ease;pointer-events:none;font-family:var(--mono);font-size:0.58rem;letter-spacing:0.14em;text-transform:uppercase;color:var(--acc);display:flex;align-items:center;gap:9px;">
    <span style="width:5px;height:5px;background:var(--acc);transform:rotate(45deg);"></span>
    <span data-meter-label>—</span>
  </div>

  <div id="highlight-popover" class="no-print" style="position:absolute;display:none;z-index:9000;transform:translate(-50%,-100%);margin-top:-10px;">
    <div id="highlight-actions" style="display:flex;background:var(--bone);white-space:nowrap;">
      <button type="button" id="highlight-copy-btn" style="background:none;color:var(--coal);font-family:var(--mono);font-size:0.64rem;font-weight:500;letter-spacing:0.12em;text-transform:uppercase;border:none;border-right:1px solid rgba(41,28,15,0.2);padding:9px 16px;cursor:pointer;display:flex;align-items:center;gap:8px;">
        <span style={`width:6px;height:6px;background:${accentVar};transform:rotate(45deg);display:inline-block;`}></span>
        Copy quote
      </button>
      <button type="button" id="highlight-note-btn" style="background:none;color:var(--coal);font-family:var(--mono);font-size:0.64rem;font-weight:500;letter-spacing:0.12em;text-transform:uppercase;border:none;padding:9px 16px;cursor:pointer;">
        Note
      </button>
    </div>
    <div id="note-composer" style="display:none;background:var(--bone);padding:10px;width:240px;">
      <textarea id="note-composer-input" rows="2" placeholder="Why? (just for you)" style="width:100%;resize:vertical;background:var(--coal);color:var(--bone);border:1px solid rgba(41,28,15,0.3);font-family:var(--body);font-size:0.9rem;padding:8px;box-sizing:border-box;"></textarea>
      <div style="display:flex;justify-content:flex-end;gap:10px;margin-top:8px;">
        <button type="button" id="note-composer-cancel" style="background:none;border:none;color:var(--coal);opacity:0.7;font-family:var(--mono);font-size:0.6rem;letter-spacing:0.1em;text-transform:uppercase;cursor:pointer;padding:6px 4px;">Cancel</button>
        <button type="button" id="note-composer-save" style="background:var(--coal);color:var(--bone);border:none;font-family:var(--mono);font-size:0.6rem;letter-spacing:0.1em;text-transform:uppercase;cursor:pointer;padding:6px 12px;">Save</button>
      </div>
    </div>
  </div>

  <main id="main-content">
    <!-- ARTICLE HEADER -->
    <header data-cursor-light style="position:relative;overflow:hidden;padding:clamp(8rem,16vh,12rem) clamp(22px,6vw,64px) clamp(2.5rem,5vw,4rem);">
      <div style="position:absolute;inset:0;z-index:0;background:radial-gradient(110% 80% at 18% 6%, rgba(117,89,56,0.10), transparent 56%),linear-gradient(180deg,var(--paper-hi) 0%,var(--coal) 70%);"></div>
      <div style="position:relative;z-index:1;max-width:760px;margin:0 auto;animation:cc-rise .9s ease both;">
        <a href={strandHref} class="charge back-link" style="display:inline-flex;align-items:center;gap:9px;font-family:var(--mono);font-size:0.62rem;font-weight:500;letter-spacing:0.18em;text-transform:uppercase;color:var(--acc);margin-bottom:clamp(2rem,4vw,3rem);transition:gap .3s;">← {strandLabel}</a>
        <div style="display:flex;flex-wrap:wrap;align-items:center;gap:13px;margin-bottom:clamp(1.4rem,2.5vw,2rem);font-family:var(--mono);font-size:0.6rem;font-weight:500;letter-spacing:0.16em;text-transform:uppercase;color:var(--ash);">
          <span style="color:var(--acc);">{entry.data.tag}</span>
          <span style="width:16px;height:1px;background:var(--coal-line);"></span>
          <span>{readLabel} read</span>
          <span style="width:3px;height:3px;border-radius:50%;background:var(--coal-line);"></span>
          <span>{entry.data.date}</span>
          {entry.data.epistemicStatus && (
            <Fragment>
              <span style="width:3px;height:3px;border-radius:50%;background:var(--coal-line);"></span>
              <span style="font-style:italic;color:var(--ash);text-transform:none;letter-spacing:normal;font-family:var(--body);font-size:0.78rem;">{epistemicLabel[entry.data.epistemicStatus]}</span>
            </Fragment>
          )}
        </div>
        <h1 style="margin:0;font-family:var(--display);font-weight:500;font-size:clamp(2.5rem,6.4vw,4.6rem);line-height:1.0;letter-spacing:-0.018em;text-wrap:balance;">{entry.data.title}</h1>
        <p style="font-family:var(--body);font-weight:400;font-style:italic;font-size:clamp(1.25rem,2.4vw,1.7rem);line-height:1.42;color:var(--tide);margin:clamp(1.6rem,3vw,2.2rem) 0 0;text-wrap:pretty;">{entry.data.standfirst}</p>
      </div>
    </header>

    <!-- AUTHOR / SEAM -->
    <div style="max-width:760px;margin:0 auto;padding:0 clamp(22px,6vw,64px);">
      <div style="display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:14px 18px;padding:clamp(1.4rem,2.5vw,1.8rem) 0;border-top:1px solid var(--coal-line);border-bottom:1px solid var(--coal-line);">
        <span style="font-family:var(--mono);font-size:0.62rem;letter-spacing:0.14em;text-transform:uppercase;color:var(--ash);">By <span style="color:var(--bone);">Ilias Ennajmi</span></span>
        <div class="no-print" style="display:flex;flex-wrap:wrap;align-items:center;gap:16px;font-family:var(--mono);font-size:0.62rem;letter-spacing:0.14em;text-transform:uppercase;color:var(--ash);">
          <div style="display:flex;align-items:center;gap:14px;">
            <span>Share</span>
            <span style="width:3px;height:3px;border-radius:50%;background:var(--acc);"></span>
            <a href={share.x} class="charge share-link" target="_blank" rel="noopener noreferrer">X</a>
            <a href={share.linkedin} class="charge share-link" target="_blank" rel="noopener noreferrer">LinkedIn</a>
          </div>
          <span style="width:1px;height:14px;background:var(--coal-line);flex:none;"></span>
          <div style="display:flex;align-items:center;gap:14px;">
            <button type="button" class="charge share-link cite-btn" data-citation={citation} style="background:none;border:none;padding:0;font:inherit;letter-spacing:inherit;text-transform:inherit;color:inherit;cursor:pointer;">Cite</button>
            <span style="width:3px;height:3px;border-radius:50%;background:var(--acc);"></span>
            <button type="button" class="charge share-link save-btn" style="background:none;border:none;padding:0;font:inherit;letter-spacing:inherit;text-transform:inherit;color:inherit;cursor:pointer;">Save</button>
            <span class="listen-sep" style="width:3px;height:3px;border-radius:50%;background:var(--acc);display:none;"></span>
            <button type="button" class="charge share-link listen-btn" style="display:none;background:none;border:none;padding:0;font:inherit;letter-spacing:inherit;text-transform:inherit;color:inherit;cursor:pointer;">Listen</button>
            <span style="width:3px;height:3px;border-radius:50%;background:var(--acc);"></span>
            <button type="button" class="charge share-link print-btn" style="background:none;border:none;padding:0;font:inherit;letter-spacing:inherit;text-transform:inherit;color:inherit;cursor:pointer;">Print</button>
          </div>
        </div>
      </div>
    </div>

    {toc.length >= 3 && (
      <div class="no-print" style="max-width:680px;margin:0 auto;padding:clamp(2.4rem,4.5vw,3.4rem) clamp(22px,6vw,64px) 0;">
        <details class="essay-toc" style="border:1px solid var(--coal-line);background:var(--coal-soft);">
          <summary style="display:flex;align-items:center;gap:11px;padding:14px 18px;cursor:pointer;font-family:var(--mono);font-size:0.62rem;font-weight:600;letter-spacing:0.2em;text-transform:uppercase;color:var(--ash);list-style:none;-webkit-tap-highlight-color:transparent;">
            <span style="width:6px;height:6px;background:var(--acc);transform:rotate(45deg);display:inline-block;flex:none;"></span>
            Contents
            <span class="toc-chev" aria-hidden="true" style="margin-left:auto;transition:transform .3s;color:var(--acc);">↓</span>
          </summary>
          <ol style="margin:0;padding:4px 18px 16px 35px;list-style:none;counter-reset:toc;">
            {toc.map((h) => (
              <li style="counter-increment:toc;margin:0;padding:7px 0;border-top:1px solid var(--coal-line);">
                <a href={`#${h.slug}`} class="toc-link" style="display:flex;align-items:baseline;gap:12px;font-family:var(--display);font-weight:500;font-size:clamp(1.02rem,1.8vw,1.18rem);line-height:1.3;color:var(--bone);transition:color .25s;">
                  <span style="font-family:var(--mono);font-size:0.56rem;letter-spacing:0.08em;color:var(--acc);flex:none;">{String(toc.indexOf(h) + 1).padStart(2, '0')}</span>
                  {h.text}
                </a>
              </li>
            ))}
          </ol>
        </details>
      </div>
    )}

    <!-- BODY -->
    <article class="essay-body" style="max-width:680px;margin:0 auto;padding:clamp(3rem,6vw,5rem) clamp(22px,6vw,64px) clamp(4rem,7vw,6rem);">
      <Content />

      {/* Rendered here, then moved by JS to wherever ::interactive:: sits in the
          body. Server-rendered so there's no layout shift, and if the swap never
          runs the widget simply stays at the end rather than vanishing. */}
      {entry.data.interactive === 'anchor' && <div data-interactive-source hidden><InteractiveAnchor /></div>}

      <div data-reveal style="display:flex;align-items:center;gap:14px;margin-top:clamp(2.4rem,4vw,3.4rem);font-family:var(--mono);font-size:0.62rem;letter-spacing:0.18em;text-transform:uppercase;color:var(--ash);">
        <span style="width:8px;height:8px;background:var(--acc);transform:rotate(45deg);display:inline-block;"></span>
        <span>{endLabel}</span>
      </div>
      {/* Filled in only once the reader actually finishes -- see the
          visibility-gated timer in the script below. Never shown for a
          skim/scroll-past, only a real completion. */}
      <p data-pace-reveal class="no-print" style="margin:0.7rem 0 0;font-family:var(--body);font-style:italic;font-size:0.92rem;color:var(--ash);opacity:0;transition:opacity .6s ease;"></p>
    </article>

    {paired && (
      <section class="no-print" style="border-top:1px solid var(--coal-line);background:var(--coal-soft);">
        <div style="max-width:760px;margin:0 auto;padding:clamp(2.6rem,5vw,4rem) clamp(22px,6vw,64px);">
          <div style="display:flex;align-items:center;gap:10px;margin-bottom:1.1rem;font-family:var(--mono);font-size:0.62rem;letter-spacing:0.2em;text-transform:uppercase;color:var(--ash);">
            <span style={`width:7px;height:7px;transform:rotate(45deg);display:inline-block;background:${paired.accent === 'ember' ? 'var(--ember)' : 'var(--tide)'};`}></span>
            {strand === 'ulysses' ? 'Now see who profits' : 'Now ask why people act'}
          </div>
          <a href={`/essays/${paired.entry.data.id}/`} class="charge paired-link" data-accent={paired.accent} style="display:block;">
            <div class="paired-title" style="font-family:var(--display);font-weight:500;font-size:clamp(1.7rem,3.4vw,2.6rem);line-height:1.08;letter-spacing:-0.01em;transition:color .3s;text-wrap:balance;">{paired.entry.data.title}</div>
            <p style="font-family:var(--body);font-weight:300;font-style:italic;color:var(--ash);font-size:clamp(1rem,1.6vw,1.15rem);margin:0.8rem 0 0;line-height:1.45;text-wrap:pretty;">{paired.entry.data.standfirst}</p>
            <span style={`display:inline-flex;align-items:center;gap:8px;margin-top:1.2rem;font-family:var(--mono);font-size:0.64rem;letter-spacing:0.16em;text-transform:uppercase;color:${paired.accent === 'ember' ? 'var(--ember)' : 'var(--tide)'};`}>Read the {paired.strandLabel} counterpart →</span>
          </a>
        </div>
      </section>
    )}

    <NewsletterSignup />

    <!-- PREV / NEXT -->
    <nav aria-label="More essays" class="no-print" style="border-top:1px solid var(--coal-line);">
      <div class="kb-hint" style="max-width:1180px;margin:0 auto;padding:1.1rem clamp(22px,6vw,64px) 0;text-align:center;font-family:var(--mono);font-size:0.56rem;letter-spacing:0.2em;text-transform:uppercase;color:var(--ash);">Navigate with <span style="color:var(--acc);">←</span> <span style="color:var(--acc);">→</span></div>
      <div style="max-width:1180px;margin:0 auto;padding:0 clamp(22px,6vw,64px);display:grid;grid-template-columns:1fr 1fr;gap:1px;background:var(--coal-line);">
        <a href={prevHref} data-prev-link class="charge prevnext-link" style="background:var(--coal);display:flex;flex-direction:column;gap:0.8rem;padding:clamp(2.2rem,4vw,3.4rem) clamp(1.4rem,3vw,2.6rem);transition:background .4s;">
          <span style="font-family:var(--mono);font-size:0.6rem;font-weight:500;letter-spacing:0.16em;text-transform:uppercase;color:var(--ash);">← Previous</span>
          <span style="font-family:var(--display);font-weight:500;font-size:clamp(1.3rem,2.4vw,1.9rem);line-height:1.08;letter-spacing:-0.01em;text-wrap:balance;">{prev.entry.data.title}</span>
          <span style="font-family:var(--mono);font-size:0.58rem;letter-spacing:0.12em;text-transform:uppercase;color:var(--ash);">{prev.entry.data.tag}</span>
        </a>
        <a href={nextHref} data-next-link class="charge prevnext-link" style="background:var(--coal);display:flex;flex-direction:column;gap:0.8rem;padding:clamp(2.2rem,4vw,3.4rem) clamp(1.4rem,3vw,2.6rem);text-align:right;align-items:flex-end;transition:background .4s;">
          <span style="font-family:var(--mono);font-size:0.6rem;font-weight:500;letter-spacing:0.16em;text-transform:uppercase;color:var(--acc);">Next →</span>
          <span style="font-family:var(--display);font-weight:500;font-size:clamp(1.3rem,2.4vw,1.9rem);line-height:1.08;letter-spacing:-0.01em;text-wrap:balance;">{next.entry.data.title}</span>
          <span style="font-family:var(--mono);font-size:0.58rem;letter-spacing:0.12em;text-transform:uppercase;color:var(--ash);">{next.entry.data.tag}</span>
        </a>
      </div>
    </nav>
  </main>
</div>
</BaseLayout>

<style>
  .back-link:hover { gap: 15px; }
  #highlight-note-btn:hover, #highlight-copy-btn:hover { background: rgba(41,28,15,0.06); }
  #note-composer-save:hover { background: var(--acc, var(--ember)); }
  .reader-note {
    margin: 0.9rem 0 1.6rem;
    padding-left: clamp(16px, 3vw, 24px);
    border-left: 2px solid var(--ash);
  }
  .reader-note-label {
    display: block;
    font-family: var(--mono);
    font-size: 0.58rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ash);
    margin-bottom: 0.4rem;
  }
  .reader-note p {
    margin: 0;
    font-family: var(--body);
    font-style: italic;
    font-size: 0.98rem;
    line-height: 1.5;
    color: var(--bone);
  }
  .reader-note-remove {
    margin-top: 0.5rem;
    background: none;
    border: none;
    padding: 0;
    font-family: var(--mono);
    font-size: 0.56rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ash);
    cursor: pointer;
    transition: color .25s;
  }
  .reader-note-remove:hover { color: var(--acc, var(--ember)); }
  .essay-toc summary::-webkit-details-marker { display: none; }
  .essay-toc[open] .toc-chev { transform: rotate(180deg); }
  .toc-link:hover { color: var(--acc) !important; }
  .share-link { transition: color .25s; }
  .share-link:hover { color: var(--bone); }
  .prevnext-link:hover { background: var(--coal-soft); }
  .paired-link[data-accent="tide"]:hover .paired-title { color: var(--tide); }
  .paired-link[data-accent="ember"]:hover .paired-title { color: var(--ember); }
</style>

<script define:vars={{ strand, prevHref, nextHref, essayTitle: entry.data.title, canonicalUrl, essayMeta: { id: entry.data.id, title: entry.data.title, tag: entry.data.tag, strand: strandLabel, accent, read: readLabel, minutes: readMinutes, href: `/essays/${entry.data.id}/` } }}>
  let cleanupKeydown = null;
  let cleanupHighlight = null;
  let cleanupSidenotes = null;
  let cleanupSidenoteResize = null;
  let cleanupListen = null;
  let cleanupReadingLog = null;
  let cleanupPace = null;

  // Which direct child of .essay-body a selection/click landed in -- stable
  // across visits since published content doesn't change, so it doubles as
  // a durable address for a reader's own margin note.
  function nearestBodyChildIndex(node) {
    const body = document.querySelector('.essay-body');
    if (!body || !node) return -1;
    let el = node.nodeType === 3 ? node.parentElement : node;
    while (el && el.parentElement !== body) el = el.parentElement;
    return el ? Array.from(body.children).indexOf(el) : -1;
  }

  // ---- Listen to this essay (Web Speech API, no dependency) ----
  // Feature-detected: hidden entirely rather than shown broken on browsers
  // without speechSynthesis (notably some older/embedded WebViews).
  function setupListen() {
    if (cleanupListen) cleanupListen();
    const btn = document.querySelector('.listen-btn');
    const sep = document.querySelector('.listen-sep');
    if (!btn || !('speechSynthesis' in window)) { cleanupListen = null; return; }

    btn.style.display = '';
    if (sep) sep.style.display = '';

    let utter = null;
    const buildText = () => {
      const body = document.querySelector('.essay-body');
      if (!body) return '';
      const parts = [];
      body.querySelectorAll(':scope > p, :scope > h2, :scope > blockquote, :scope > ul, :scope > ol').forEach((el) => {
        if (el.closest('.footnotes')) return;
        const t = el.textContent.trim();
        if (t) parts.push(t);
      });
      return parts.join('. ');
    };

    const setLabel = (t) => { btn.textContent = t; };

    const onClick = () => {
      const synth = window.speechSynthesis;
      if (synth.speaking && !synth.paused) { synth.pause(); setLabel('Resume'); return; }
      if (synth.paused) { synth.resume(); setLabel('Pause'); return; }
      const text = buildText();
      if (!text) return;
      utter = new SpeechSynthesisUtterance(text);
      utter.onend = () => setLabel('Listen');
      utter.onerror = () => setLabel('Listen');
      synth.speak(utter);
      setLabel('Pause');
    };
    btn.addEventListener('click', onClick);

    cleanupListen = () => {
      btn.removeEventListener('click', onClick);
      // Never let audio keep playing after the reader navigates away —
      // cancel() is safe to call even when nothing is speaking.
      try { window.speechSynthesis.cancel(); } catch (e) {}
      setLabel('Listen');
    };
  }

  // ---- Local reading log ("Your reading, honestly" on /saved/) ----
  // Listens for the generic completion event site-fx.js's reading meter
  // dispatches; this file is where strand/tag/minutes are already known.
  function setupReadingLog() {
    if (cleanupReadingLog) cleanupReadingLog();
    const onComplete = (e) => {
      if (!e.detail || e.detail.essay !== essayMeta.id) return;
      try {
        const log = JSON.parse(localStorage.getItem('reading-log') || '[]');
        if (!log.some((r) => r.id === essayMeta.id)) {
          log.push({
            id: essayMeta.id, title: essayMeta.title, tag: essayMeta.tag,
            strand: essayMeta.strand, minutes: essayMeta.minutes, completedAt: Date.now(),
          });
          localStorage.setItem('reading-log', JSON.stringify(log));
        }
      } catch (err) { /* private mode */ }
    };
    window.addEventListener('cc:essay-complete', onComplete);
    cleanupReadingLog = () => window.removeEventListener('cc:essay-complete', onComplete);
  }

  // ---- Reading-pace reveal ----
  // Only counts time the tab was actually visible (Page Visibility API), so
  // leaving the essay open in a background tab for an hour doesn't produce
  // a dishonest "you read this in 63 minutes." Compared against the
  // displayed estimate only once the reader genuinely finishes.
  function setupPaceReveal() {
    if (cleanupPace) cleanupPace();
    let activeMs = 0;
    let lastResume = document.hidden ? null : performance.now();
    const onVisibility = () => {
      if (document.hidden) {
        if (lastResume != null) { activeMs += performance.now() - lastResume; lastResume = null; }
      } else {
        lastResume = performance.now();
      }
    };
    document.addEventListener('visibilitychange', onVisibility);

    const onComplete = (e) => {
      if (!e.detail || e.detail.essay !== essayMeta.id) return;
      if (lastResume != null) { activeMs += performance.now() - lastResume; lastResume = performance.now(); }
      const el = document.querySelector('[data-pace-reveal]');
      if (!el || !essayMeta.minutes) return;
      const actualMin = activeMs / 60000;
      const estMin = essayMeta.minutes;
      const diff = estMin - actualMin;
      let msg;
      if (actualMin < 0.2) return; // too fast to mean anything (e.g. a bounce that still fired the event)
      if (Math.abs(diff) < 0.5) msg = `You read this in almost exactly the estimated ${estMin} min.`;
      else if (diff > 0) msg = `You read this in about ${Math.max(1, Math.round(actualMin))} min — ${Math.round(diff)} faster than the estimate.`;
      else msg = `You read this in about ${Math.round(actualMin)} min — ${Math.round(-diff)} slower than the estimate. No judgment; attention isn't a stopwatch.`;
      el.textContent = msg;
      el.style.opacity = '1';
    };
    window.addEventListener('cc:essay-complete', onComplete);

    cleanupPace = () => {
      document.removeEventListener('visibilitychange', onVisibility);
      window.removeEventListener('cc:essay-complete', onComplete);
    };
  }

  // ---- Margin rebuttals ----
  // Private, this-browser-only counter-notes the reader leaves on a
  // paragraph via the same selection popover used for quoting. Addressed by
  // .essay-body child index (see nearestBodyChildIndex above), not by a
  // serialized Range, since published content never changes underneath it.
  function renderRebuttals() {
    const body = document.querySelector('.essay-body');
    if (!body) return;
    body.querySelectorAll('.reader-note').forEach((n) => n.remove());
    let notes = [];
    try { notes = JSON.parse(localStorage.getItem('rebuttals-' + essayMeta.id) || '[]'); } catch (e) { notes = []; }
    const children = Array.from(body.children);
    notes.forEach((n, i) => {
      const target = children[n.index];
      if (!target || !n.text) return;
      const wrap = document.createElement('div');
      wrap.className = 'reader-note no-print';

      const label = document.createElement('span');
      label.className = 'reader-note-label';
      label.textContent = n.quote
        ? `Your note — on "${n.quote.length > 60 ? n.quote.slice(0, 60) + '…' : n.quote}"`
        : 'Your note';

      const p = document.createElement('p');
      p.textContent = n.text;

      const removeBtn = document.createElement('button');
      removeBtn.type = 'button';
      removeBtn.className = 'reader-note-remove';
      removeBtn.textContent = 'Remove';
      removeBtn.addEventListener('click', () => {
        let list = [];
        try { list = JSON.parse(localStorage.getItem('rebuttals-' + essayMeta.id) || '[]'); } catch (e) { list = []; }
        list.splice(i, 1);
        try { localStorage.setItem('rebuttals-' + essayMeta.id, JSON.stringify(list)); } catch (e) { /* private mode */ }
        renderRebuttals();
      });

      wrap.appendChild(label);
      wrap.appendChild(p);
      wrap.appendChild(removeBtn);
      target.insertAdjacentElement('afterend', wrap);
    });
  }

  // Footnotes ([^1] syntax, supported by Astro's default GFM markdown)
  // render as a numbered ref + a list at the bottom. This rebuilds them
  // as Tufte-style margin notes on wide screens, or tap-to-reveal inline
  // notes on narrow ones — the native bottom list is always hidden (CSS).
  function setupSidenotes() {
    if (cleanupSidenotes) cleanupSidenotes();
    const article = document.querySelector('.essay-body');
    const footnotesSection = article && article.querySelector('.footnotes');
    if (!article || !footnotesSection) { cleanupSidenotes = null; return; }

    const notes = {};
    footnotesSection.querySelectorAll('li[id]').forEach((li) => {
      const clone = li.cloneNode(true);
      clone.querySelectorAll('[data-footnote-backref]').forEach((a) => a.remove());
      notes[li.id] = clone.innerHTML.trim();
    });

    const refs = Array.from(article.querySelectorAll('a[data-footnote-ref]'));
    const created = [];
    const wide = window.matchMedia('(min-width: 1280px)').matches;

    if (wide) {
      const artRect = article.getBoundingClientRect();
      refs.forEach((ref) => {
        const id = ref.getAttribute('href').slice(1);
        const content = notes[id];
        const sup = ref.closest('sup');
        if (!content || !sup) return;
        const note = document.createElement('span');
        note.className = 'sidenote';
        note.innerHTML = content;
        note.style.top = (sup.getBoundingClientRect().top - artRect.top) + 'px';
        article.appendChild(note);
        created.push(note);
        const onClick = (e) => e.preventDefault();
        ref.addEventListener('click', onClick);
        created.push({ remove: () => ref.removeEventListener('click', onClick) });
      });
    } else {
      refs.forEach((ref) => {
        const id = ref.getAttribute('href').slice(1);
        const content = notes[id];
        const sup = ref.closest('sup');
        if (!content || !sup) return;
        const onClick = (e) => {
          e.preventDefault();
          const existing = sup.parentElement.querySelector(':scope > .sidenote-inline[data-for="' + id + '"]');
          if (existing) { existing.remove(); return; }
          const note = document.createElement('span');
          note.className = 'sidenote-inline';
          note.dataset.for = id;
          note.innerHTML = content;
          sup.insertAdjacentElement('afterend', note);
        };
        ref.addEventListener('click', onClick);
        ref.classList.add('footnote-toggle');
        created.push({ remove: () => { ref.removeEventListener('click', onClick); ref.classList.remove('footnote-toggle'); } });
      });
    }

    cleanupSidenotes = () => {
      created.forEach((el) => { if (el.remove) el.remove(); });
      article.querySelectorAll('.sidenote, .sidenote-inline').forEach((el) => el.remove());
    };
  }

  // Move the server-rendered interactive widget to wherever the author put
  // the ::interactive:: marker in the markdown. Done before the data-reveal
  // pass below so the widget joins the same scroll-reveal rhythm. Moving a
  // node carries its listeners, so this is order-independent relative to the
  // widget's own astro:page-load setup.
  function placeInteractive() {
    const source = document.querySelector('[data-interactive-source]');
    if (!source) return;
    const widget = source.firstElementChild;
    if (!widget) return;
    const marker = Array.from(document.querySelectorAll('.essay-body > p'))
      .find((p) => p.textContent?.trim() === '::interactive::');
    // No marker (author forgot it): fall back to the end of the body. Insert
    // rather than replace — in dev the wrapper also holds Astro's module
    // script for the widget, so removing it would break the widget itself.
    if (marker) marker.replaceWith(widget);
    else source.parentElement?.insertBefore(widget, source);
  }

  document.addEventListener('astro:page-load', () => {
    placeInteractive();

    // <Content /> renders as opaque HTML (real markdown, not hand-built
    // JSX per block), so each top-level element needs data-reveal added
    // here instead of in the template, to keep the same staggered
    // scroll-reveal per paragraph/quote/heading as before.
    document.querySelectorAll('.essay-body > *').forEach((el) => el.setAttribute('data-reveal', ''));
    window.pageBoot({ strand, progress: 'article' });
    window.scrollTo(0, 0);

    setupSidenotes();
    setupListen();
    setupReadingLog();
    setupPaceReveal();
    renderRebuttals();

    const printBtn = document.querySelector('.print-btn');
    if (printBtn && !printBtn.dataset.bound) {
      printBtn.dataset.bound = '1';
      printBtn.addEventListener('click', () => window.print());
    }
    if (cleanupSidenoteResize) cleanupSidenoteResize();
    let resizeTimer;
    const onResize = () => { clearTimeout(resizeTimer); resizeTimer = setTimeout(setupSidenotes, 150); };
    window.addEventListener('resize', onResize, { passive: true });
    cleanupSidenoteResize = () => { clearTimeout(resizeTimer); window.removeEventListener('resize', onResize); };

    if (cleanupKeydown) cleanupKeydown();
    const onKeydown = (e) => {
      // Shift is excluded too: Shift+Arrow extends a text selection, which
      // this shortcut must never hijack mid-read. Any focused button/link
      // (Cite, Save, Listen, nav, footnote refs) also opts out, since arrow
      // keys are a native activation/navigation key for those elements.
      if (e.metaKey || e.ctrlKey || e.altKey || e.shiftKey) return;
      const t = e.target;
      if (t && t.closest && t.closest('input, textarea, select, button, a, [contenteditable="true"]')) return;
      if (e.key === 'ArrowLeft') window.location.href = prevHref;
      else if (e.key === 'ArrowRight') window.location.href = nextHref;
    };
    document.addEventListener('keydown', onKeydown);
    cleanupKeydown = () => document.removeEventListener('keydown', onKeydown);

    try {
      const rec = JSON.parse(localStorage.getItem('recent-essays') || '[]').filter((r) => r.id !== essayMeta.id);
      rec.unshift(essayMeta);
      localStorage.setItem('recent-essays', JSON.stringify(rec.slice(0, 6)));
    } catch (e) { /* private mode */ }

    const saveBtn = document.querySelector('.save-btn');
    if (saveBtn) {
      const loadSaved = () => { try { return JSON.parse(localStorage.getItem('saved-essays') || '[]'); } catch (e) { return []; } };
      const renderSave = () => { saveBtn.textContent = loadSaved().some((s) => s.id === essayMeta.id) ? 'Saved ◆' : 'Save'; };
      saveBtn.addEventListener('click', () => {
        try {
          let list = loadSaved();
          if (list.some((s) => s.id === essayMeta.id)) list = list.filter((s) => s.id !== essayMeta.id);
          else list.unshift(essayMeta);
          localStorage.setItem('saved-essays', JSON.stringify(list));
        } catch (e) { /* private mode */ }
        renderSave();
      });
      renderSave();
    }

    const citeBtn = document.querySelector('.cite-btn');
    if (citeBtn && !citeBtn.dataset.bound) {
      citeBtn.dataset.bound = '1';
      citeBtn.addEventListener('click', async () => {
        const citation = citeBtn.getAttribute('data-citation');
        try {
          await navigator.clipboard.writeText(citation);
          const original = citeBtn.textContent;
          citeBtn.textContent = 'Copied';
          setTimeout(() => { citeBtn.textContent = original; }, 1600);
        } catch (e) {
          window.prompt('Copy this citation:', citation);
        }
      });
    }

    if (cleanupHighlight) cleanupHighlight();
    const popover = document.getElementById('highlight-popover');
    const copyBtn = document.getElementById('highlight-copy-btn');
    const noteBtn = document.getElementById('highlight-note-btn');
    const actionsRow = document.getElementById('highlight-actions');
    const composer = document.getElementById('note-composer');
    const composerInput = document.getElementById('note-composer-input');
    const composerCancel = document.getElementById('note-composer-cancel');
    const composerSave = document.getElementById('note-composer-save');
    const body = document.querySelector('.essay-body');
    if (popover && copyBtn && noteBtn && actionsRow && composer && composerInput && composerCancel && composerSave && body) {
      let pending = null; // { index, quote }
      const hide = () => {
        popover.style.display = 'none';
        actionsRow.style.display = 'flex';
        composer.style.display = 'none';
      };
      const onSelectionEnd = () => {
        const sel = window.getSelection();
        const text = sel ? sel.toString().trim() : '';
        if (!text || sel.rangeCount === 0 || !body.contains(sel.anchorNode)) { hide(); return; }
        const rect = sel.getRangeAt(0).getBoundingClientRect();
        if (!rect.width && !rect.height) { hide(); return; }
        popover.style.left = (rect.left + rect.width / 2 + window.scrollX) + 'px';
        popover.style.top = (rect.top + window.scrollY) + 'px';
        popover.style.display = 'block';
        actionsRow.style.display = 'flex';
        composer.style.display = 'none';
        copyBtn.dataset.quote = text;
        pending = { index: nearestBodyChildIndex(sel.anchorNode), quote: text };
      };
      const onCopyClick = async () => {
        const quote = copyBtn.dataset.quote || '';
        const text = `"${quote}" — Ilias Ennajmi, "${essayTitle}"\n${canonicalUrl}`;
        try {
          await navigator.clipboard.writeText(text);
          copyBtn.lastChild.textContent = ' Copied';
          setTimeout(() => { copyBtn.lastChild.textContent = ' Copy quote'; hide(); }, 1200);
        } catch (e) {
          window.prompt('Copy this quote:', text);
          hide();
        }
      };
      const onNoteClick = () => {
        actionsRow.style.display = 'none';
        composer.style.display = 'block';
        composerInput.value = '';
        composerInput.focus();
      };
      const onComposerSave = () => {
        const text = composerInput.value.trim();
        if (!text || !pending || pending.index < 0) { hide(); return; }
        let list = [];
        try { list = JSON.parse(localStorage.getItem('rebuttals-' + essayMeta.id) || '[]'); } catch (e) { list = []; }
        list.push({ index: pending.index, quote: pending.quote, text, ts: Date.now() });
        try { localStorage.setItem('rebuttals-' + essayMeta.id, JSON.stringify(list)); } catch (e) { /* private mode */ }
        hide();
        renderRebuttals();
      };
      document.addEventListener('mouseup', onSelectionEnd);
      document.addEventListener('touchend', onSelectionEnd);
      document.addEventListener('scroll', hide, { passive: true });
      copyBtn.addEventListener('click', onCopyClick);
      noteBtn.addEventListener('click', onNoteClick);
      composerCancel.addEventListener('click', hide);
      composerSave.addEventListener('click', onComposerSave);
      cleanupHighlight = () => {
        document.removeEventListener('mouseup', onSelectionEnd);
        document.removeEventListener('touchend', onSelectionEnd);
        document.removeEventListener('scroll', hide);
      };
    }
  });
</script>
