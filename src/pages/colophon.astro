---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getPublishedCollection, readMinutesOf } from '../lib/essays';
import { wordCount } from '../lib/readTime';

const ulysses = await getPublishedCollection('ulysses');
const ilias = await getPublishedCollection('ilias');
const all = [...ulysses, ...ilias];

const totalWords = all.reduce((sum, e) => sum + wordCount(e.body ?? ''), 0);
const totalMinutes = all.reduce((sum, e) => sum + readMinutesOf(e), 0);

const LAUNCH_DATE = new Date('2026-07-17T00:00:00Z');
const daysSinceLaunch = Math.max(0, Math.floor((Date.now() - LAUNCH_DATE.getTime()) / 86400000));

const stats = [
  { label: 'Essays published', value: String(all.length), note: `${ulysses.length} Ulysses · ${ilias.length} Ilias` },
  { label: 'Words written', value: totalWords.toLocaleString(), note: 'Essay bodies only — doesn’t count the drafts that never made it.' },
  { label: 'Reading time, cover to cover', value: `${totalMinutes} min`, note: 'At roughly 220 words a minute.' },
  { label: 'Days since launch', value: String(daysSinceLaunch), note: 'Built slowly, on purpose.' },
];
---
<BaseLayout
  title="Colophon — Ilias Ennajmi"
  description="What this site is made of, and a running tally of what's in it."
  active="colophon"
  siteFx
>
<main id="main-content">
  <header data-cursor-light style="position:relative;overflow:hidden;padding:clamp(8rem,16vh,12rem) clamp(22px,6vw,64px) clamp(3.5rem,7vw,6rem);">
    <div style="position:absolute;inset:0;z-index:0;background:radial-gradient(120% 90% at 50% 8%, rgba(117,89,56,0.10), transparent 56%), linear-gradient(180deg,var(--paper-hi) 0%,var(--paper-mid) 60%,var(--coal) 100%);"></div>
    <div style="position:relative;z-index:1;max-width:1180px;margin:0 auto;animation:cc-rise .9s ease both;">
      <div style="display:flex;align-items:center;gap:14px;font-family:var(--mono);font-size:0.68rem;letter-spacing:0.24em;text-transform:uppercase;color:var(--ash);margin-bottom:clamp(1.6rem,3vw,2.4rem);">
        <span style="width:28px;height:1px;background:var(--ember);"></span>What this is made of
      </div>
      <h1 style="margin:0;font-family:var(--display);font-weight:500;font-size:clamp(3rem,9vw,6.5rem);line-height:0.94;letter-spacing:-0.015em;">Colophon<span style="color:var(--ember-vivid);">.</span></h1>
      <p style="font-family:var(--body);font-weight:300;font-style:italic;font-size:clamp(1.15rem,2.2vw,1.5rem);color:var(--bone);opacity:0.82;max-width:56ch;margin:1.6rem 0 0;line-height:1.5;text-wrap:pretty;">A running tally, updated on every deploy — because a site about incentives should be honest about its own.</p>
    </div>
  </header>

  <section style="max-width:1180px;margin:0 auto;padding:0 clamp(22px,6vw,64px) clamp(4rem,7vw,6rem);">
    <div data-reveal style="display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:1px;background:var(--coal-line);border:1px solid var(--coal-line);">
      {stats.map((s) => (
        <div style="background:var(--coal-soft);padding:clamp(24px,3.5vw,36px);display:flex;flex-direction:column;gap:0.8rem;min-height:clamp(160px,18vw,210px);">
          <span style="font-family:var(--mono);font-size:0.6rem;font-weight:500;letter-spacing:0.14em;text-transform:uppercase;color:var(--ember);">{s.label}</span>
          <span style="font-family:var(--display);font-weight:500;font-size:clamp(2rem,4vw,2.8rem);line-height:1;letter-spacing:-0.01em;">{s.value}</span>
          <span style="font-family:var(--body);font-style:italic;font-weight:400;font-size:0.94rem;line-height:1.4;color:var(--ash);margin-top:auto;">{s.note}</span>
        </div>
      ))}
    </div>
  </section>

  <section style="border-top:1px solid var(--coal-line);background:var(--coal-soft);">
    <div style="max-width:820px;margin:0 auto;padding:clamp(4rem,7vw,6rem) clamp(22px,6vw,64px);">
      <div data-reveal style="display:flex;align-items:baseline;gap:16px;margin-bottom:clamp(2rem,4vw,3rem);font-family:var(--mono);font-size:0.68rem;letter-spacing:0.2em;text-transform:uppercase;color:var(--ash);">
        <span>Built with</span>
        <span class="cc-rule"></span>
      </div>
      <div data-reveal style="font-family:var(--body);font-size:clamp(1.05rem,1.8vw,1.22rem);line-height:1.8;color:var(--tide);">
        <p style="margin:0 0 1rem;">Astro, statically generated — no server to keep alive, no database to worry about.</p>
        <p style="margin:0 0 1rem;">Type set in Fraunces, EB Garamond and Space Grotesk, self-hosted as variable fonts, so nothing here depends on a third party to render.</p>
        <p style="margin:0 0 1rem;">Essays edited from a browser via Decap CMS, authenticated through DecapBridge, committed straight to Git — no database for content either.</p>
        <p style="margin:0;">Hosted on Netlify, deployed automatically on every push to <code>main</code>.</p>
      </div>
    </div>
  </section>
</main>
</BaseLayout>

<script>
  document.addEventListener('astro:page-load', () => {
    window.pageBoot({ strand: null, progress: 'page' });
  });
</script>
