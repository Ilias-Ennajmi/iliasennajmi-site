---
import PortfolioLayout from '../../../layouts/PortfolioLayout.astro';
import { CASES, photo } from '../../../lib/portfolio';
---
<PortfolioLayout view="work" title="Work · Ilias Ennajmi" description="Selected campaigns, each with its own page.">
  <div class="gut"><div class="wrap">
    <header class="grid page-head">
      <span class="eyebrow">Work · three cases</span>
      <h1 class="display">Selected <em>work</em></h1>
      <p class="lede">Three campaigns, each with its own page. These are sample cases that show the format. Your real work replaces them.</p>
    </header>
    <div class="cases">
      {CASES.map((c, i) => (
        <a class="case-row" href={`/portfolio/work/${c.slug}/`}>
          <div class="pic"><img {...photo(c.hero.src)} sizes="(max-width: 900px) 92vw, 820px" alt={c.hero.alt} loading={i === 0 ? 'eager' : 'lazy'} fetchpriority={i === 0 ? 'high' : undefined} /></div>
          <div class="txt">
            <span class="label">Case <b>{c.n}</b> · {c.sector} · {c.year}</span>
            <h2 set:html={c.title.replace('<br>', ' ')} />
            <p>{c.summary}</p>
            <span class="btn sm ghost">Open the case <span>→</span></span>
          </div>
        </a>
      ))}
    </div>
    <div class="grid yours sec">
      <img class="yfolder" src="/portfolio/img/folder4.webp" alt="Folder labelled Case 04, yours?" loading="lazy" width="640" height="515">
      <div class="ytxt"><span class="label">Case <b>04</b> · Open</span><p class="big">The next one could be <em>yours.</em></p><a class="btn" href="/portfolio/contact/">Start a brief <span>→</span></a></div>
    </div>
  </div></div>
</PortfolioLayout>
