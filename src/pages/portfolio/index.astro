---
import PortfolioLayout from '../../layouts/PortfolioLayout.astro';
import { CLIENTS } from '../../lib/portfolio';
---
<PortfolioLayout view="home" title="Ilias Ennajmi · Portfolio" description="Marketing strategist from Casablanca. Selected campaigns, what I do, and how I work.">
  <div class="cover gut">
    <div class="binder">
      <div class="bfade"><img class="bimg" src="/portfolio/img/binder.webp" fetchpriority="high" alt="An open oxblood leather ring binder on an off-white surface" width="2000" height="1117"></div>
      <span class="ov pg pg-name rise" style="animation-delay:.5s">Ilias Ennajmi · Vol. <b>01</b> · 2026</span>
      <h1 class="ov word w-port rise" style="animation-delay:.1s">Port</h1>
      <span class="ov word w-folio rise" style="animation-delay:.25s" aria-hidden="true">folio</span>
      <span class="ov pg pg-role rise" style="animation-delay:.6s">Marketing strategist<br>Casablanca</span>
      <img class="ov stamp c-round rise" style="--r:-14deg;animation-delay:1.3s" src="/portfolio/img/stamp_round.webp" alt="" width="620" height="613">
      <img class="ov stamp c-ask rise" style="--r:7deg;animation-delay:1.5s" src="/portfolio/img/stamp_ask.webp" alt="Stamp: Ask why first" width="700" height="156">
      <img class="ov c-post rise" style="--r:8deg;animation-delay:1.4s" src="/portfolio/img/postage.webp" alt="A Casablanca postage stamp" width="460" height="593">
      <img class="ov c-note rise" style="--r:-4deg;animation-delay:1.1s" src="/portfolio/img/note.webp" alt="A handwritten note: Read the brief twice. Then ask why it exists." width="760" height="413">
      <figure class="ov print loose c-casa rise" style="--r:-7deg;animation-delay:.8s"><img class="fr" src="/portfolio/img/frame.webp" alt=""><img class="ph" src="/portfolio/img/casa.webp" alt="An art deco building in Casablanca at dusk"><img class="pin" src="/portfolio/img/pin.webp" alt=""><figcaption>Casa, dusk</figcaption></figure>
      <figure class="ov print loose c-me rise" style="--r:5deg;animation-delay:.95s"><img class="fr" src="/portfolio/img/frame.webp" alt=""><img class="ph bw face-ph" src="/portfolio/img/face-confident.webp" alt="Engraved portrait of Ilias, looking confident" width="704" height="890"><img class="pin" src="/portfolio/img/pin.webp" alt=""><img class="sig" src="/portfolio/img/signature.webp" alt="Ilias Ennajmi, handwritten" width="900" height="183"></figure>
    </div>
  </div>
  <div class="gut"><div class="wrap">
    {CLIENTS.length > 0 && (
      <div class="clients"><span class="label">Worked with</span><ul>{CLIENTS.map((name) => <li>{name}</li>)}</ul></div>
    )}

    <div class="who">
      <div class="who-head">
        <h2 class="sec-title">Who I am</h2>
        <p class="lede">A marketing strategist from Casablanca. I work out <b>why</b> people choose what they choose, then build the campaign around it, and often the thing that runs it too.</p>
      </div>
      <div class="venn">
        <svg class="venn-d" viewBox="0 0 1200 600" aria-hidden="true"><path class="lens" d="M600 65 A290 290 0 0 1 600 535 A290 290 0 0 1 600 65Z"/><circle cx="430" cy="300" r="290"/><circle cx="770" cy="300" r="290"/></svg>
        <svg class="venn-m" viewBox="0 0 600 1000" aria-hidden="true"><path class="lens" d="M65 470 A290 290 0 0 1 535 470 A290 290 0 0 1 65 470Z"/><circle cx="300" cy="300" r="290"/><circle cx="300" cy="640" r="290"/></svg>
        <div class="v-zone v-a"><h3>Marketing</h3><ul><li>Brand strategy</li><li>Positioning</li><li>Campaign platforms</li><li>Messaging and copy</li><li>Customer insight</li></ul></div>
        <div class="v-zone v-b"><h3>Digital</h3><ul><li>Websites and landing pages</li><li>CRM and lifecycle</li><li>Automation and AI workflows</li><li>Analytics and dashboards</li><li>Content systems</li></ul></div>
        <img class="v-face" src="/portfolio/img/face-sharp-cut.webp" alt="Engraved portrait of Ilias with one eyebrow raised, placed where the two circles overlap" width="704" height="890" loading="lazy">
        <span class="v-tag">I work here</span>
      </div>
      <div class="mess">
        <p class="mess-title">The creative and technical <em>mess in between.</em></p>
        <ul>
          <li><img src="/portfolio/img/hook.webp" alt=""><span>I write the line, then build the page it lives on.</span></li>
          <li><img src="/portfolio/img/gears.webp" alt=""><span>I plan the campaign, then wire the automation that runs it.</span></li>
          <li><img src="/portfolio/img/magnet.webp" alt=""><span>I read the dashboard, then go and talk to the customers behind it.</span></li>
        </ul>
        <a class="btn" href="/portfolio/what-i-do/">What I do, in detail <span>→</span></a>
      </div>
    </div>

    <div class="sec band">
      <div class="sec-head big"><h2 class="sec-title">Case files</h2><a class="label more" href="/portfolio/work/">All work →</a></div>
      <div class="files">
        <a class="file" href="/portfolio/work/calm/"><span class="peek" style="--pr:-4deg"><img src="/portfolio/img/ooh.webp" alt=""></span><img class="fo" src="/portfolio/img/folder1.webp" alt="Folder labelled Case 01, Calm" width="900" height="723"><img class="fstamp" style="--sr:-9deg" src="/portfolio/img/stamp_sample.webp" alt="Sample case"><span class="cap"><span class="label">Fintech · 2025</span><b>Calm, sold to the anxious.</b><span class="open">Open the file →</span></span></a>
        <a class="file" href="/portfolio/work/cup/"><span class="peek" style="--pr:3deg"><img src="/portfolio/img/cup.webp" alt="" style="object-position:42% 50%"></span><img class="fo" src="/portfolio/img/folder2.webp" alt="Folder labelled Case 02, 2nd Cup" width="900" height="723"><img class="fstamp" style="--sr:6deg" src="/portfolio/img/stamp_sample.webp" alt="Sample case"><span class="cap"><span class="label">Coffee · 2024</span><b>The second cup.</b><span class="open">Open the file →</span></span></a>
        <a class="file" href="/portfolio/work/stay/"><span class="peek" style="--pr:-2deg"><img src="/portfolio/img/stay.webp" alt="" style="object-position:38% 50%"></span><img class="fo" src="/portfolio/img/folder3.webp" alt="Folder labelled Case 03, Stay" width="900" height="723"><img class="fstamp" style="--sr:-5deg" src="/portfolio/img/stamp_sample.webp" alt="Sample case"><span class="cap"><span class="label">Telecom · 2023</span><b>Say it before they leave.</b><span class="open">Open the file →</span></span></a>
        <a class="file empty" href="/portfolio/contact/"><img class="fo" src="/portfolio/img/folder4.webp" alt="Folder labelled Case 04, yours?" width="900" height="723"><span class="cap"><span class="label">Open · 2026</span><b>The next one could be yours.</b><span class="open">Start a brief →</span></span></a>
      </div>
    </div>

  </div></div>
</PortfolioLayout>
