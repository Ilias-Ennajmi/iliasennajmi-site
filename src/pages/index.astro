---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactLinks from '../components/ContactLinks.astro';
import HeroTitlePage from '../components/HeroTitlePage.astro';
import NewsletterSignup from '../components/NewsletterSignup.astro';
import SectionPath from '../components/SectionPath.astro';
import { getPublishedCollection, getStartHerePath, readMinutesOf } from '../lib/essays';
import { SITE } from '../lib/site';

const ulyssesEntries = await getPublishedCollection('ulysses');
const iliasEntries = await getPublishedCollection('ilias');
const latestU = ulyssesEntries[0];
const latestI = iliasEntries[0];

const startHere = await getStartHerePath();
const startHereMinutes = startHere.reduce((sum, x) => sum + readMinutesOf(x.entry), 0);

// Data for the homepage's "next step" pill: default server-rendered state is
// the Start Here promo below, but a returning visitor's own localStorage
// (reading-log / recent-essays, already used elsewhere for the nav's read
// count) lets client-side JS swap it to "continue reading X" instead --
// no account, no server-side tracking, just reusing what's already stored.
const allEssays = [...ulyssesEntries, ...iliasEntries];
const essayInfo: Record<string, { href: string; title: string }> = {};
const pairMap: Record<string, string | null> = {};
for (const e of allEssays) {
  essayInfo[e.data.id] = { href: `/essays/${e.data.id}/`, title: e.data.title };
  pairMap[e.data.id] = e.data.pairsWith ?? null;
}
const allEssayIds = allEssays.map((e) => e.data.id);

const shelves = [
  { label: 'My latest reads', items: [
    { title: 'Influence', by: 'Cialdini' },
    { title: 'Thinking, Fast and Slow', by: 'Kahneman' },
    { title: 'The Paradox of Choice', by: 'Schwartz' },
  ] },
  { label: 'Music I spin', items: [
    { title: 'In Rainbows', by: 'Radiohead' },
    { title: 'Blonde', by: 'Frank Ocean' },
    { title: 'At the Vanguard', by: 'Bill Evans' },
  ] },
  { label: 'Books I loved', items: [
    { title: 'Ulysses', by: 'Joyce' },
    { title: 'Meditations', by: 'Aurelius' },
    { title: 'Ways of Seeing', by: 'Berger' },
  ] },
];

// A thread only gets an href when it genuinely is the seed of a published
// essay, not just a topically-adjacent tag match -- three of these five
// don't have an honest match yet (their closest essays are either drafts
// or cover a different angle), so they stay as plain, unlinked notebook
// fragments rather than pointing somewhere that doesn't actually deliver on
// the thread's specific claim.
const threads = [
  { text: "Pricing is less math than a story about what you think you deserve.", tag: 'ON VALUE', href: '/essays/first-number/' },
  { text: 'Every free trial bets you’ll forget to cancel. They usually win.', tag: 'ON FRICTION' },
  { text: 'The expensive dish on the menu is there so you order the one next to it.', tag: 'ON CHOICE' },
  { text: 'Willpower is a budget. Most ads wait for you to overdraw it.', tag: 'ON ATTENTION' },
  { text: 'The playlist feels personal. It was built to keep you listening.', tag: 'ON DEFAULTS', href: '/essays/defaults/' },
];

const sameAs = Object.values(SITE.social).filter((url): url is string => Boolean(url));
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': new URL('/', Astro.site).toString(),
      name: 'Ilias Ennajmi',
      description: 'Essays on the hidden mechanics of choice: what makes people act, and who profits when they do.',
      url: new URL('/', Astro.site).toString(),
    },
    {
      '@type': 'Person',
      '@id': new URL('/about/', Astro.site).toString(),
      name: 'Ilias Ennajmi',
      jobTitle: 'Marketing Strategist',
      url: new URL('/about/', Astro.site).toString(),
      sameAs,
    },
  ],
};
---
<BaseLayout
  title="Ilias Ennajmi · Why people act, who profits"
  description="Essays on the hidden mechanics of choice: what makes people act, and who profits when they do."
  active="home"
  jsonLd={jsonLd}
>
<main id="main-content" style="position:relative;">

  <SectionPath />
  <HeroTitlePage />

  <!-- ============ 01 — ABOUT (grounding band) ============ -->
  <section id="about" style="position:relative;border-top:1px solid var(--coal-line);background:var(--coal-soft);">
    <div style="max-width:1180px;margin:0 auto;padding:clamp(4.5rem,9vw,7.5rem) clamp(22px,6vw,64px);">
      <div data-reveal style="display:flex;align-items:center;gap:16px;margin-bottom:clamp(1.3rem,2.5vw,1.9rem);font-family:var(--mono);font-size:0.66rem;letter-spacing:0.22em;text-transform:uppercase;color:var(--ash);">
        <span><span class="cc-num" data-to="1">01</span></span>
        <span class="cc-rule"></span>
        <span>The person behind it</span>
      </div>
      <h2 data-reveal style="font-family:var(--display);font-weight:500;font-size:clamp(2.6rem,6.2vw,4.8rem);line-height:0.96;letter-spacing:-0.015em;margin:0 0 clamp(2.6rem,4.5vw,3.8rem);text-wrap:balance;">Who's speaking<span style="font-style:italic;color:var(--ember-vivid);">?</span></h2>
      <div style="display:grid;grid-template-columns:minmax(0,1fr);gap:clamp(2.4rem,5vw,4.5rem);align-items:start;">
        <div data-reveal>
          <p style="font-family:var(--display);font-weight:400;font-size:clamp(1.5rem,3.2vw,2.4rem);line-height:1.22;margin:0 0 1.6rem;letter-spacing:-0.005em;text-wrap:pretty;">I'm <span style="font-style:italic;">Ilias</span>. I work in <span style="position:relative;white-space:nowrap;">marketing strategy<span class="cc-uline" style="position:absolute;left:0;right:0;bottom:0;height:2px;background:var(--ember);transform:scaleX(0);transform-origin:left center;transition:transform .85s cubic-bezier(.2,.7,.2,1);"></span></span> and write, on the side, about why people choose what they choose.</p>
          <div style="display:flex;flex-wrap:wrap;align-items:center;gap:clamp(14px,2vw,26px);margin-top:2.2rem;font-family:var(--mono);font-size:0.62rem;letter-spacing:0.18em;text-transform:uppercase;color:var(--ash);">
            <span>Strategy</span>
            <span style="width:3px;height:3px;border-radius:50%;background:var(--ember);flex:none;"></span>
            <span>Behavioral psych</span>
            <span style="width:3px;height:3px;border-radius:50%;background:var(--ember);flex:none;"></span>
            <span>Writing</span>
          </div>
          <a href="/about/" class="charge more-link" style="display:inline-flex;align-items:center;gap:10px;margin-top:clamp(1.8rem,3vw,2.6rem);font-family:var(--mono);font-size:0.66rem;letter-spacing:0.16em;text-transform:uppercase;color:var(--ember);transition:gap .3s;">More about me <span style="font-family:var(--display);font-size:1.1em;line-height:0;">→</span></a>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ 02 — THE FORK ============ -->
  <section id="fork" tabindex="-1" style="max-width:1180px;margin:0 auto;padding:clamp(4.5rem,9vw,7.5rem) clamp(22px,6vw,64px);">
    <div data-reveal class="eyebrow-row" style="margin:0 0 clamp(1.6rem,3vw,2.4rem);display:flex;align-items:baseline;gap:16px;font-family:var(--mono);font-weight:400;font-size:0.68rem;letter-spacing:0.2em;text-transform:uppercase;color:var(--ash);">
      <h2 style="display:inline;margin:0;font:inherit;color:inherit;letter-spacing:inherit;"><span class="cc-num" data-to="2">02</span> · The Fork</h2>
      <span class="cc-rule"></span>
      <span class="eyebrow-tag" style="color:var(--ash);">Two ways down the same hole</span>
    </div>
    <p data-reveal style="font-family:var(--body);font-weight:300;font-size:clamp(1.1rem,2vw,1.35rem);line-height:1.5;color:var(--ash);max-width:46ch;margin:0 0 0.6rem;text-wrap:pretty;">The writing splits in two. One side asks <span style="font-style:italic;">why</span> people act. The other asks <span style="position:relative;white-space:nowrap;font-style:italic;color:var(--ember);">who profits<span class="cc-uline" style="position:absolute;left:0;right:0;bottom:-1px;height:2px;background:var(--ember);transform:scaleX(0);transform-origin:left center;transition:transform .85s cubic-bezier(.2,.7,.2,1);"></span></span> when they do. Pick a door.</p>
    <p data-reveal style="font-family:var(--mono);font-size:0.68rem;letter-spacing:0.08em;color:var(--ash);margin:0 0 clamp(2.2rem,4vw,3.2rem);">(Both, eventually. This isn't Monty Hall.)</p>

    <div class="cc-fork" style="display:grid;grid-template-columns:repeat(auto-fit,minmax(300px,1fr));gap:1px;background:var(--coal-line);border-top:1px solid var(--coal-line);border-bottom:1px solid var(--coal-line);">
      <a href="/ulysses/" class="js-ulysses charge" data-reveal style="position:relative;overflow:hidden;background:color-mix(in srgb, var(--tide) 3%, var(--coal));display:flex;flex-direction:column;justify-content:space-between;gap:clamp(2.4rem,6vw,4.5rem);min-height:clamp(300px,33vw,440px);padding:clamp(28px,3.5vw,48px);border-left:3px solid var(--tide);transition:background .45s ease,opacity .45s ease,filter .45s ease;">
        <div style="display:flex;align-items:center;justify-content:space-between;font-family:var(--mono);font-size:0.7rem;letter-spacing:0.18em;text-transform:uppercase;color:var(--tide);"><span>I · Ulysses</span><span>→</span></div>
        <div>
          <div class="fork-title" style="font-family:var(--display);font-weight:500;font-size:clamp(2.6rem,5.4vw,4.4rem);line-height:0.92;letter-spacing:-0.01em;transition:color .4s ease;">Why people act.</div>
          <p style="font-family:var(--body);font-style:italic;font-weight:300;color:var(--ash);font-size:clamp(1.05rem,1.6vw,1.3rem);margin:1.1rem 0 0;max-width:34ch;line-height:1.45;">Psychology, behavior, philosophy. The long way home, basically.</p>
        </div>
        {latestU && (
          <div style="display:flex;flex-direction:column;gap:0.4rem;">
            <div style="font-family:var(--mono);font-size:0.62rem;font-weight:500;letter-spacing:0.14em;text-transform:uppercase;color:var(--ash);display:flex;align-items:baseline;gap:10px;"><span style="color:var(--tide);">Latest</span><span style="font-family:var(--body);font-style:italic;text-transform:none;letter-spacing:0;font-size:0.95rem;color:var(--bone);">{latestU.data.title}</span></div>
            <div style="font-family:var(--mono);font-size:0.58rem;letter-spacing:0.1em;text-transform:uppercase;color:var(--ash);">{latestU.data.tag} · {readMinutesOf(latestU)} min</div>
          </div>
        )}
        <span class="fork-underline" style="position:absolute;left:0;right:0;bottom:0;height:2px;background:var(--tide);transform:scaleX(0);transform-origin:left center;transition:transform .55s cubic-bezier(.2,.7,.2,1);"></span>
      </a>
      <a href="/ilias/" class="js-ilias charge" data-reveal style="position:relative;overflow:hidden;background:color-mix(in srgb, var(--ember) 3%, var(--coal));display:flex;flex-direction:column;justify-content:space-between;gap:clamp(2.4rem,6vw,4.5rem);min-height:clamp(300px,33vw,440px);padding:clamp(28px,3.5vw,48px);border-left:3px solid var(--ember);transition:background .45s ease,opacity .45s ease,filter .45s ease;">
        <div style="display:flex;align-items:center;justify-content:space-between;font-family:var(--mono);font-size:0.7rem;letter-spacing:0.18em;text-transform:uppercase;color:var(--ember);"><span>II · Ilias</span><span>→</span></div>
        <div>
          <div class="fork-title-ember" style="font-family:var(--display);font-weight:500;font-size:clamp(2.6rem,5.4vw,4.4rem);line-height:0.92;letter-spacing:-0.01em;transition:color .4s ease;">Who profits when they do.</div>
          <p style="font-family:var(--body);font-style:italic;font-weight:300;color:var(--ash);font-size:clamp(1.05rem,1.6vw,1.3rem);margin:1.1rem 0 0;max-width:34ch;line-height:1.45;">Marketing and strategy, before the click. Follow the money.</p>
        </div>
        {latestI && (
          <div style="display:flex;flex-direction:column;gap:0.4rem;">
            <div style="font-family:var(--mono);font-size:0.62rem;font-weight:500;letter-spacing:0.14em;text-transform:uppercase;color:var(--ash);display:flex;align-items:baseline;gap:10px;"><span style="color:var(--ember);">Latest</span><span style="font-family:var(--body);font-style:italic;text-transform:none;letter-spacing:0;font-size:0.95rem;color:var(--bone);">{latestI.data.title}</span></div>
            <div style="font-family:var(--mono);font-size:0.58rem;letter-spacing:0.1em;text-transform:uppercase;color:var(--ash);">{latestI.data.tag} · {readMinutesOf(latestI)} min</div>
          </div>
        )}
        <span class="fork-underline-ember" style="position:absolute;left:0;right:0;bottom:0;height:2px;background:var(--ember);transform:scaleX(0);transform-origin:left center;transition:transform .55s cubic-bezier(.2,.7,.2,1);"></span>
      </a>
    </div>

    {allEssayIds.length > 0 && (
      <a href={startHere.length > 0 ? '/start/' : '/topics/'} id="next-step-pill" class="charge pill-cta pill-cta-icon start-pill" data-reveal style="margin-top:clamp(1.8rem,3vw,2.6rem);color:var(--ash);">
        <span style="width:6px;height:6px;background:var(--ash);transform:rotate(45deg);flex:none;"></span>
        <span id="next-step-text">{startHere.length > 0 ? `New here? Start with ${startHere.length} essays, about ${startHereMinutes} min →` : 'Browse the essays →'}</span>
      </a>
    )}
  </section>

  <script define:vars={{ essayInfo, pairMap, allEssayIds }}>
    // Swaps the Start Here pill for a "continue reading" one, using
    // reading-log / recent-essays localStorage already written by the essay
    // page -- see boot() below for when this runs.
    function personalizeNextStep() {
      const pill = document.getElementById('next-step-pill');
      const textEl = document.getElementById('next-step-text');
      if (!pill || !textEl) return;

      let finishedRaw = [];
      let recentRaw = [];
      try { finishedRaw = JSON.parse(localStorage.getItem('reading-log') || '[]'); } catch (e) { /* private mode */ }
      try { recentRaw = JSON.parse(localStorage.getItem('recent-essays') || '[]'); } catch (e) { /* private mode */ }
      const finishedIds = new Set((Array.isArray(finishedRaw) ? finishedRaw : []).map((r) => r && r.id).filter(Boolean));
      const recentIds = (Array.isArray(recentRaw) ? recentRaw : []).map((r) => r && r.id).filter(Boolean);
      if (finishedIds.size === 0 && recentIds.length === 0) return; // first-time visitor: leave the default Start Here pill

      const setPill = (href, text) => { pill.setAttribute('href', href); textEl.textContent = text; };

      const mostRecentId = recentIds[0];
      if (mostRecentId && !finishedIds.has(mostRecentId) && essayInfo[mostRecentId]) {
        setPill(essayInfo[mostRecentId].href, `Continue reading: ${essayInfo[mostRecentId].title} →`);
        return;
      }
      const pairedId = mostRecentId ? pairMap[mostRecentId] : null;
      if (pairedId && !finishedIds.has(pairedId) && essayInfo[pairedId]) {
        setPill(essayInfo[pairedId].href, `Read the other half: ${essayInfo[pairedId].title} →`);
        return;
      }
      const nextUnread = allEssayIds.find((id) => !finishedIds.has(id));
      if (nextUnread && essayInfo[nextUnread]) {
        setPill(essayInfo[nextUnread].href, `Next up: ${essayInfo[nextUnread].title} →`);
        return;
      }
      setPill('/topics/', `You've read all ${allEssayIds.length} essays. Browse by topic →`);
    }
    window.__life.onReady(personalizeNextStep);
  </script>

  <!-- ============ 03 — LOOSE THREADS (marquee) ============ -->
  <section style="padding:clamp(4.5rem,9vw,7.5rem) 0;border-top:1px solid var(--coal-line);overflow:hidden;">
    <div style="max-width:1180px;margin:0 auto;padding:0 clamp(22px,6vw,64px);">
      <div data-reveal class="eyebrow-row" style="margin:0;display:flex;align-items:baseline;gap:16px;font-family:var(--mono);font-weight:400;font-size:0.68rem;letter-spacing:0.2em;text-transform:uppercase;color:var(--ash);">
        <h2 style="display:inline;margin:0;font:inherit;color:inherit;letter-spacing:inherit;"><span class="cc-num" data-to="3">03</span> · Loose Threads</h2>
        <span class="cc-rule"></span>
        <span class="eyebrow-tag">A public notebook. Some of these become essays</span>
      </div>
      <button type="button" id="marq-toggle" data-reveal aria-pressed="false" style="margin-top:14px;display:inline-flex;align-items:center;min-height:44px;font-family:var(--mono);font-size:0.6rem;letter-spacing:0.16em;text-transform:uppercase;background:none;border:1px solid var(--coal-line);color:var(--ash);padding:0 14px;cursor:pointer;transition:color .25s,border-color .25s;">Pause scrolling</button>
    </div>
    <div class="marqrow" style="margin-top:clamp(2.6rem,4.5vw,3.8rem);display:flex;width:max-content;animation:cc-marqL 64s linear infinite;cursor:default;">
      {[0, 1].map(() => (
        threads.map((thread) => (
          <span style="display:inline-flex;align-items:baseline;gap:16px;padding:0 clamp(22px,3vw,46px);white-space:nowrap;font-family:var(--display);font-style:italic;font-weight:400;font-size:clamp(1.4rem,3vw,2.3rem);color:var(--bone);">
            {thread.href ? (
              <a href={thread.href} class="charge thread-link" style="color:inherit;text-decoration:none;">{thread.text}<span aria-hidden="true" style="font-style:normal;font-size:0.6em;color:var(--ember);margin-left:0.15em;">&#8599;</span></a>
            ) : thread.text}
            <span style="font-family:var(--mono);font-style:normal;font-size:0.56rem;font-weight:500;letter-spacing:0.16em;color:var(--ember);align-self:center;">{thread.tag}</span><span style="color:var(--coal-line);font-style:normal;">◆</span>
          </span>
        ))
      ))}
    </div>
  </section>

  <!-- ============ PULL QUOTE ============ -->
  <section data-reveal style="position:relative;border-top:1px solid var(--coal-line);background:var(--coal-soft);">
    <div style="max-width:1040px;margin:0 auto;padding:clamp(5rem,11vw,9rem) clamp(22px,6vw,64px);text-align:center;">
      <span style="display:block;font-family:var(--display);font-weight:800;font-size:clamp(2.6rem,5vw,4rem);line-height:0.6;color:var(--ember-vivid);">&ldquo;</span>
      <blockquote style="margin:clamp(0.8rem,1.6vw,1.2rem) 0 0;font-family:var(--display);font-weight:500;font-style:italic;font-size:clamp(2rem,5vw,3.6rem);line-height:1.12;letter-spacing:-0.015em;color:var(--bone);text-wrap:balance;">The most expensive choices are the ones you <span style="position:relative;white-space:nowrap;color:var(--ember-vivid);">never noticed<span class="cc-uline" style="position:absolute;left:0;right:0;bottom:-2px;height:2px;background:var(--ember-vivid);transform:scaleX(0);transform-origin:left center;transition:transform 1.1s cubic-bezier(.2,.7,.2,1) .15s;"></span></span> you were making.</blockquote>
      <div style="margin-top:clamp(2rem,4vw,2.8rem);font-family:var(--mono);font-size:0.64rem;letter-spacing:0.22em;text-transform:uppercase;color:var(--ash);">A working thesis</div>
    </div>
  </section>

  <!-- ============ 04 — THE SHELF ============ -->
  <section style="max-width:1180px;margin:0 auto;padding:clamp(4.5rem,9vw,7.5rem) clamp(22px,6vw,64px);border-top:1px solid var(--coal-line);">
    <h2 data-reveal style="margin:0 0 clamp(2rem,4vw,3rem);display:flex;align-items:baseline;gap:16px;font-family:var(--mono);font-weight:400;font-size:0.68rem;letter-spacing:0.2em;text-transform:uppercase;color:var(--ash);">
      <span><span class="cc-num" data-to="4">04</span> · The Shelf</span>
      <span class="cc-rule"></span>
    </h2>
    <h3 data-reveal style="margin:0 0 clamp(2.6rem,5vw,4rem);font-family:var(--display);font-weight:500;font-size:clamp(1.9rem,4vw,3rem);line-height:1.04;letter-spacing:-0.01em;max-width:24ch;">Whatever's shaping the work right now.</h3>
    <div data-reveal style="display:grid;grid-template-columns:repeat(auto-fit,minmax(230px,1fr));gap:clamp(30px,4vw,60px);">
      {shelves.map((col) => (
        <div>
          <div style="display:flex;align-items:center;gap:10px;font-family:var(--mono);font-size:0.64rem;letter-spacing:0.18em;text-transform:uppercase;color:var(--ash);padding-bottom:0.9rem;border-bottom:1px solid var(--coal-line);">
            <span style="width:6px;height:6px;background:var(--ember);display:inline-block;"></span>{col.label}
          </div>
          {col.items.map((it) => (
            <div style="display:flex;align-items:baseline;justify-content:space-between;gap:14px;padding:0.95rem 0;border-bottom:1px solid var(--coal-line);">
              <span style="font-family:var(--body);font-size:1.14rem;line-height:1.25;">{it.title}</span>
              <span style="font-family:var(--mono);font-size:0.6rem;letter-spacing:0.03em;color:var(--ash);white-space:nowrap;">{it.by}</span>
            </div>
          ))}
        </div>
      ))}
    </div>
    <a href="/shelf/" class="charge shelf-link" data-reveal style="display:inline-block;margin-top:clamp(2.4rem,4vw,3.4rem);font-family:var(--mono);font-size:0.7rem;letter-spacing:0.16em;text-transform:uppercase;color:var(--ember);transition:letter-spacing .3s;">See the full Shelf →</a>
  </section>

  <!-- ============ 05 — CONTACT ============ -->
  <section style="max-width:1180px;margin:0 auto;padding:clamp(4.5rem,9vw,7.5rem) clamp(22px,6vw,64px);border-top:1px solid var(--coal-line);">
    <div data-reveal style="display:flex;align-items:center;gap:16px;margin-bottom:clamp(1.6rem,3vw,2.4rem);font-family:var(--mono);font-size:0.66rem;letter-spacing:0.22em;text-transform:uppercase;color:var(--ash);">
      <span><span class="cc-num" data-to="5">05</span></span>
      <span class="cc-rule"></span>
      <span>Say hello</span>
    </div>
    <h2 data-reveal style="font-family:var(--display);font-weight:500;font-size:clamp(2.6rem,7vw,5.6rem);line-height:0.95;letter-spacing:-0.01em;margin:0;">Get in touch<span style="color:var(--ember-vivid);">.</span></h2>
    <p data-reveal style="font-family:var(--body);font-weight:300;font-style:italic;color:var(--ash);font-size:clamp(1.1rem,2vw,1.4rem);margin:1.2rem 0 clamp(2.4rem,5vw,3.5rem);">For work, arguments, or book recommendations.</p>
    <div data-reveal style="display:flex;flex-wrap:wrap;gap:clamp(28px,6vw,72px);">
      <ContactLinks size="lg" />
    </div>
  </section>

  <NewsletterSignup />

</main>
</BaseLayout>

<style>
  .more-link:hover { gap: 16px; }
  .start-pill:hover { border-color: var(--ember); color: var(--ember); }
  .js-ulysses:hover { background: var(--coal-soft); }
  .js-ulysses:hover .fork-title { color: var(--tide); }
  .js-ulysses:hover .fork-underline { transform: scaleX(1); }
  .js-ilias:hover { background: var(--coal-soft); }
  .js-ilias:hover .fork-title-ember { color: var(--ember); }
  .js-ilias:hover .fork-underline-ember { transform: scaleX(1); }
  .shelf-link:hover { letter-spacing: 0.22em; }
  .thread-link { border-bottom: 1px solid transparent; transition: border-color .25s; }
  .thread-link:hover { border-bottom-color: var(--ember); }
  .eyebrow-row > h2 { white-space: nowrap; }
  /* On phones the rule and a long tagline can't share one line with the
     section name: the name used to break mid-phrase ("02 — THE / FORK").
     The tagline drops to its own line instead. */
  @media (max-width: 640px) {
    .eyebrow-row { flex-wrap: wrap; row-gap: 10px; }
    .eyebrow-row > .eyebrow-tag { flex-basis: 100%; }
  }
</style>

<script>
  // Homepage-only behaviour. Runs on 'site:ready' (see BaseLayout), only when
  // this page is the one on screen, and registers a teardown for everything it
  // attaches so none of it keeps running after navigating to another page.
  const life = () => (window as any).__life as { onLeave: (fn: () => void) => void };
  function motionOK() {
    return !window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  }

  function pad2(v: number) { return String(v).padStart(2, '0'); }

  function activate(el: Element) {
    el.querySelectorAll('.cc-uline,.cc-rule').forEach((u) => { (u as HTMLElement).style.transform = 'scaleX(1)'; });
    el.querySelectorAll('.cc-num').forEach((n) => {
      const node = n as HTMLElement;
      if (node.dataset.counted) return; node.dataset.counted = '1';
      const to = parseInt(node.getAttribute('data-to') || '0', 10) || 0;
      if (!motionOK()) { node.textContent = pad2(to); return; }
      const dur = 720, start = performance.now();
      const step = (now: number) => {
        const t = Math.min(1, (now - start) / dur);
        const eased = 1 - Math.pow(1 - t, 3);
        node.textContent = pad2(Math.round(eased * to));
        if (t < 1) requestAnimationFrame(step);
      };
      requestAnimationFrame(step);
    });
  }

  function setupReveals() {
    const els = Array.from(document.querySelectorAll<HTMLElement>('[data-reveal]'));
    if (!motionOK()) { els.forEach((el) => activate(el)); return; }
    // The observer's first report per element says where it is, computed in
    // the browser's own rendering step, so start-up never forces a layout.
    // Below the viewport: hide now, animate in later. On screen or above:
    // leave exactly as painted.
    const seen = new WeakSet<Element>();
    const io = new IntersectionObserver((ents) => {
      // Read once, before any writes: innerHeight after a style write forces
      // a full layout, and doing that per element thrashed ~20 layouts at load.
      const vh = window.innerHeight;
      ents.forEach((e) => {
        const node = e.target as HTMLElement;
        if (!seen.has(node)) {
          seen.add(node);
          if (e.boundingClientRect.top >= vh) {
            node.style.opacity = '0';
            node.style.transform = `translateY(${node.hasAttribute('data-bigrise') ? '64px' : '24px'})`;
            node.style.transition = 'transform .8s cubic-bezier(.2,.7,.2,1), opacity .8s ease';
            return;
          }
          activate(node); io.unobserve(node); return;
        }
        if (!e.isIntersecting) return;
        node.style.opacity = '1';
        node.style.transform = 'none';
        activate(node);
        io.unobserve(node);
      });
    }, { rootMargin: '0px 0px -8% 0px' });
    els.forEach((el) => io.observe(el));
    life().onLeave(() => io.disconnect());
  }

  function initScroll() {
    const prog = document.getElementById('cc-prog');
    if (!prog) return;
    let max = 0, last = -1, ticking = false;
    // Measured in the ResizeObserver callback (right after the browser's own
    // layout), never during start-up or scroll.
    const measure = () => { max = Math.max(1, document.documentElement.scrollHeight - window.innerHeight); };
    const frame = () => {
      ticking = false;
      if (!max) return;
      const p = Math.round(Math.min(1, (window.scrollY || 0) / max) * 1000) / 1000;
      if (p !== last) { prog.style.transform = `scaleY(${p})`; last = p; }
    };
    const onScroll = () => { if (!ticking) { ticking = true; requestAnimationFrame(frame); } };
    const ro = new ResizeObserver(() => { measure(); onScroll(); });
    ro.observe(document.body);
    window.addEventListener('scroll', onScroll, { passive: true });
    life().onLeave(() => { ro.disconnect(); window.removeEventListener('scroll', onScroll); });
  }

  function bindCards() {
    if (!motionOK() || !window.matchMedia('(hover: hover)').matches) return;
    const bindRipple = (sel: string, rgb: string) => {
      document.querySelectorAll<HTMLElement>(sel).forEach((node) => {
        if (node.dataset.bound) return; node.dataset.bound = '1';
        node.addEventListener('mouseenter', (e: MouseEvent) => {
          const r = node.getBoundingClientRect();
          const s = document.createElement('span');
          s.style.cssText = `position:absolute;left:${e.clientX - r.left}px;top:${e.clientY - r.top}px;width:12px;height:12px;border-radius:50%;background:radial-gradient(circle, rgba(${rgb},0.5), rgba(${rgb},0));pointer-events:none;z-index:0;animation:cc-ripple .8s ease-out forwards;`;
          node.appendChild(s);
          s.addEventListener('animationend', () => s.remove());
        });
      });
    };
    bindRipple('.js-ulysses', '117,89,56');
    bindRipple('.js-ilias', '165,39,22');
  }

  function initMarquee() {
    const row = document.querySelector<HTMLElement>('.marqrow');
    const toggleBtn = document.getElementById('marq-toggle') as HTMLButtonElement | null;
    if (!row || !motionOK()) { if (toggleBtn) toggleBtn.style.display = 'none'; return; }
    if (toggleBtn) toggleBtn.style.display = '';
    const anim = row.getAnimations ? row.getAnimations()[0] : undefined;
    let boost = 0, hover = false, userPaused = false, lastSY: number | null = null, lastST = 0;
    let rafId = 0, running = false, appliedRate = 1, onScreen = false;

    const applyPause = () => {
      if (!anim) return;
      if (hover) { if (anim.playState !== 'paused') anim.pause(); }
      else if (anim.playState === 'paused') anim.play();
    };
    // Scrolling speeds the row up and it eases back to its base speed. The
    // loop only runs while that easing is in progress, and only touches the
    // animation when the rate actually changes: rewriting playbackRate every
    // frame forced a style recalc on every scroll frame.
    const tick = () => {
      boost *= 0.9;
      if (boost < 0.02) boost = 0;
      const rate = Math.round((1 + boost) * 20) / 20;
      if (anim && !hover && rate !== appliedRate) { anim.playbackRate = rate; appliedRate = rate; }
      if (boost > 0 && onScreen) rafId = requestAnimationFrame(tick);
      else running = false;
    };
    const kick = () => { if (!running && onScreen) { running = true; rafId = requestAnimationFrame(tick); } };
    const onScroll = () => {
      if (!onScreen) return;
      const y = window.scrollY || 0, now = performance.now();
      if (lastSY != null) boost = Math.min(6, boost + Math.abs(y - lastSY) / Math.max(16, now - lastST) * 0.8);
      lastSY = y; lastST = now;
      kick();
    };
    const onEnter = () => { if (!userPaused) { hover = true; applyPause(); } };
    const onLeave = () => { if (!userPaused) { hover = false; applyPause(); } };
    const onToggle = () => {
      userPaused = !userPaused;
      hover = userPaused;
      applyPause();
      if (toggleBtn) {
        toggleBtn.setAttribute('aria-pressed', String(userPaused));
        toggleBtn.textContent = userPaused ? 'Resume scrolling' : 'Pause scrolling';
      }
    };
    const visibility = new IntersectionObserver(([entry]) => {
      onScreen = entry.isIntersecting;
      if (!onScreen) {
        cancelAnimationFrame(rafId); running = false; boost = 0; lastSY = null;
        if (anim && appliedRate !== 1) { anim.playbackRate = 1; appliedRate = 1; }
      }
    });
    visibility.observe(row);
    const touchOnly = window.matchMedia('(hover:none)').matches;
    row.addEventListener('mouseenter', onEnter);
    row.addEventListener('mouseleave', onLeave);
    if (touchOnly) row.addEventListener('click', onToggle);
    if (toggleBtn) toggleBtn.addEventListener('click', onToggle);
    window.addEventListener('scroll', onScroll, { passive: true });
    life().onLeave(() => {
      visibility.disconnect();
      cancelAnimationFrame(rafId);
      window.removeEventListener('scroll', onScroll);
    });
  }

  document.addEventListener('site:ready', () => {
    const fork = document.getElementById('fork');
    if (!fork) return;
    bindCards();
    setupReveals();
    initScroll();
    // The marquee reads its running animation, which makes the browser
    // compute styles for the whole page on the spot. Right after parsing that
    // was a ~200 ms stall on a phone; after the first frame the styles already
    // exist, so wait for it (and skip if the page was swapped out meanwhile).
    requestAnimationFrame(() => setTimeout(() => {
      if (document.getElementById('fork') === fork) initMarquee();
    }, 0));
  });
</script>
