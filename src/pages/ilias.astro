---
import BaseLayout from '../layouts/BaseLayout.astro';
import StrandList from '../components/StrandList.astro';
import { getPublishedCollection, readTimeOf } from '../lib/essays';

const entries = await getPublishedCollection('ilias');
const posts = entries.map((e) => ({
  id: e.data.id,
  tag: e.data.tag,
  read: readTimeOf(e),
  date: e.data.date,
  title: e.data.title,
  standfirst: e.data.standfirst,
  href: `/essays/${e.data.id}/`,
}));
---
<BaseLayout
  title="Ilias — Who profits · Ilias Ennajmi"
  description="Essays on who profits from the systems around us — the incentives, business models, and interests behind the choices we're given."
  active="ilias"
  accent="var(--ember)"
  siteFx
>
  <StrandList
    strand="ilias"
    accent="ember"
    roman="II"
    title="Ilias"
    kicker="II — Who profits"
    lede="Field notes on marketing and strategy — how attention gets bought, priced and resold, written from inside the room where the decisions get made. My own name, because this is the part I'm paid for."
    watermark="II"
    watermarkPos="right:-2%"
    otherCard={{
      heading: 'The quieter half is underneath.',
      blurb: "Once you know who profits, it's worth asking why people act.",
      ctaLabel: 'Read Ulysses →',
      ctaHref: '/ulysses/',
      ctaAccent: 'tide',
    }}
    posts={posts}
  />
</BaseLayout>
