---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../lib/site';

const shelves = [
  { label: 'Reading now', meta: '3 open', items: [
    { title: 'Seeing Like a State', by: 'Scott', note: 'On why top-down plans flatten the things that made them work.' },
    { title: 'The Status Game', by: 'Storr', note: 'Most behavior, re-read as a fight for rank.' },
    { title: 'Trust', by: 'Diaz (fiction)', note: 'A novel about money told four unreliable ways.' },
  ] },
  { label: 'Recently finished', meta: '2026', items: [
    { title: 'Influence', by: 'Cialdini' },
    { title: 'Thinking, Fast and Slow', by: 'Kahneman' },
    { title: 'The Paradox of Choice', by: 'Schwartz' },
    { title: 'Ways of Seeing', by: 'Berger' },
  ] },
  { label: 'Books I keep returning to', meta: 'The canon', items: [
    { title: 'Ulysses', by: 'Joyce' },
    { title: 'Meditations', by: 'Aurelius' },
    { title: 'The Brothers Karamazov', by: 'Dostoevsky' },
    { title: 'Letters to a Young Poet', by: 'Rilke' },
  ] },
  { label: 'On repeat', meta: 'Sound', items: [
    { title: 'In Rainbows', by: 'Radiohead' },
    { title: 'Blonde', by: 'Frank Ocean' },
    { title: 'At the Vanguard', by: 'Bill Evans' },
    { title: 'Pastel Blues', by: 'Nina Simone' },
  ] },
  { label: 'Tools I trust', meta: 'Daily', items: [
    { title: 'Obsidian', by: 'Notes', note: 'Plain text that outlives every app I’ve owned.' },
    { title: 'A paper notebook', by: 'Analog', note: 'Slow on purpose. Nothing syncs, which is the point.' },
    { title: 'Readwise', by: 'Recall' },
  ] },
  { label: 'Rabbit holes', meta: 'Lately', items: [
    { title: 'Behavioral game theory', by: 'Topic' },
    { title: 'The history of pricing', by: 'Topic' },
    { title: 'Why menus are designed the way they are', by: 'Topic' },
  ] },
];

// The header's shelf: what's open now plus the canon, as spines. Widths
// and heights vary like real books; tones come from the palette so ink
// mode inverts them with everything else.
const spines = [
  { title: 'Seeing Like a State', tone: 'bone', h: 188, w: 46 },
  { title: 'The Status Game', tone: 'ember', h: 166, w: 40 },
  { title: 'Trust', tone: 'soft', h: 148, w: 34 },
  { title: 'Ulysses', tone: 'tide', h: 200, w: 52 },
  { title: 'Meditations', tone: 'soft', h: 158, w: 36 },
  { title: 'The Brothers Karamazov', tone: 'bone', h: 196, w: 50 },
  { title: 'Letters to a Young Poet', tone: 'ember', h: 150, w: 34, lean: true },
];

// Items link out only when there's a real URL to link to. A generated
// search query isn't a recommendation, so unlinked items render as text.
---
<BaseLayout
  title="The Shelf · Ilias Ennajmi"
  description="Books, essays, and other things that shaped how I think about why people act and who profits."
  active="shelf"
  siteFx
>
<main id="main-content">

  <!-- HEADER -->
  <header data-cursor-light style="position:relative;overflow:hidden;padding:clamp(8rem,16vh,12rem) clamp(22px,6vw,64px) clamp(3rem,6vw,5rem);">
    <div style="position:absolute;inset:0;z-index:0;background:linear-gradient(180deg,var(--paper-hi) 0%,var(--coal) 70%);"></div>
    <div style="position:absolute;inset:-12%;z-index:0;background:radial-gradient(55% 48% at 74% 14%, rgba(117,89,56,0.09), transparent 60%);animation:cc-drift2 26s ease-in-out infinite;"></div>
    <div style="position:relative;z-index:1;max-width:1180px;margin:0 auto;animation:cc-rise .9s ease both;">
      <div data-pll="0.10" data-watermark class="wm wm-left" style="top:8%;font-size:clamp(5rem,15vw,14rem);">04</div>
      <div style="display:flex;align-items:center;gap:14px;font-family:var(--mono);font-size:var(--fs-xs);letter-spacing:0.24em;text-transform:uppercase;color:var(--ash);margin-bottom:clamp(1.6rem,3vw,2.4rem);">
        <span style="width:28px;height:1px;background:var(--ember);"></span><span class="cc-num" data-to="4">04</span> · The Shelf
      </div>
      <h1 style="margin:0;font-family:var(--display);font-weight:500;font-size:clamp(3.4rem,11vw,8.5rem);line-height:0.9;letter-spacing:-0.015em;">The Shelf<span style="color:var(--ember-vivid);">.</span></h1>
      <p style="font-family:var(--body);font-weight:300;font-style:italic;font-size:clamp(1.2rem,2.4vw,1.7rem);color:var(--bone);opacity:0.82;max-width:48ch;margin:1.6rem 0 0;line-height:1.45;text-wrap:pretty;">What I'm reading, listening to and using right now, plus a few rabbit holes. Updated when something new sticks. Last touched {SITE.nowUpdated}.</p>
      <div class="spines" aria-hidden="true">
        {spines.map((b, i) => (
          <div class={`spine spine-${b.tone}${b.lean ? ' spine-lean' : ''}`} style={`--h:${b.h}px;--w:${b.w}px;--i:${i};`}>
            <span class="spine-t">{b.title}</span>
          </div>
        ))}
      </div>
    </div>
  </header>

  <!-- NOW PLAYING strip -->
  <section style="border-top:1px solid var(--coal-line);border-bottom:1px solid var(--coal-line);background:var(--coal-soft);">
    <div data-reveal style="max-width:1180px;margin:0 auto;padding:clamp(1.4rem,3vw,2.2rem) clamp(22px,6vw,64px);display:flex;flex-wrap:wrap;align-items:center;gap:clamp(18px,4vw,48px);">
      <span style="font-family:var(--mono);font-size:var(--fs-sm);letter-spacing:0.2em;text-transform:uppercase;color:var(--ember);display:flex;align-items:center;gap:9px;"><span style="width:7px;height:7px;border-radius:50%;background:var(--ember);display:inline-block;"></span>Right now</span>
      <span style="font-family:var(--body);font-weight:300;font-style:italic;font-size:clamp(1.1rem,2vw,1.45rem);color:var(--bone);">Reading <span style="font-style:normal;">Seeing Like a State</span> · re-watching <span style="font-style:normal;">The Bear</span> · stuck on <span style="font-style:normal;">one Nina Simone record</span></span>
    </div>
  </section>

  <!-- SHELVES -->
  <section style="max-width:1180px;margin:0 auto;padding:clamp(3.5rem,7vw,6rem) clamp(22px,6vw,64px) clamp(4rem,8vw,7rem);">
    <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:clamp(2.4rem,4vw,4rem) clamp(2.4rem,5vw,5rem);">
      {shelves.map((col) => (
        <div data-reveal>
          <div style="display:flex;align-items:baseline;justify-content:space-between;gap:12px;padding-bottom:1rem;margin-bottom:0.4rem;border-bottom:1px solid var(--coal-line);">
            <span style="display:flex;align-items:center;gap:10px;font-family:var(--mono);font-size:var(--fs-sm);letter-spacing:0.18em;text-transform:uppercase;color:var(--ash);"><span style="width:6px;height:6px;background:var(--ember);display:inline-block;"></span>{col.label}</span>
            <span style="font-family:var(--mono);font-size:var(--fs-2xs);letter-spacing:0.06em;color:var(--ash);">{col.meta}</span>
          </div>
          {col.items.map((it) => (
            <div class="shelf-item" style="padding:1rem 0;border-bottom:1px solid var(--coal-line);">
              {it.url ? (
                <a href={it.url} target="_blank" rel="noopener noreferrer" class="charge shelf-link" style="display:flex;align-items:baseline;justify-content:space-between;gap:14px;text-decoration:none;transition:color .25s;">
                  <span style="font-family:var(--body);font-size:1.18rem;line-height:1.2;">{it.title}</span>
                  <span style="font-family:var(--mono);font-size:var(--fs-2xs);letter-spacing:0.03em;color:var(--ash);white-space:nowrap;">{it.by}</span>
                </a>
              ) : (
                <div style="display:flex;align-items:baseline;justify-content:space-between;gap:14px;">
                  <span style="font-family:var(--body);font-size:1.18rem;line-height:1.2;">{it.title}</span>
                  <span style="font-family:var(--mono);font-size:var(--fs-2xs);letter-spacing:0.03em;color:var(--ash);white-space:nowrap;">{it.by}</span>
                </div>
              )}
              {it.note && (
                <p class="shelf-note" style="font-family:var(--body);font-weight:300;font-style:italic;font-size:0.96rem;color:var(--ash);margin:0.4rem 0 0;line-height:1.4;text-wrap:pretty;">{it.note}</p>
              )}
            </div>
          ))}
        </div>
      ))}
    </div>

    <div data-reveal style="margin-top:clamp(2.4rem,4vw,4rem);padding-top:clamp(2.4rem,4vw,4rem);border-top:1px solid var(--coal-line);">
      <div style="display:flex;align-items:center;gap:16px;margin-bottom:clamp(1.2rem,2vw,1.8rem);font-family:var(--mono);font-size:var(--fs-sm);letter-spacing:0.18em;text-transform:uppercase;color:var(--ash);">
        <span style="width:6px;height:6px;background:var(--ember);display:inline-block;flex:none;"></span>
        <span style="color:var(--bone);">The actual playlist</span>
        <span class="cc-rule"></span>
      </div>
      <iframe
        style="border-radius:0;border:1px solid var(--coal-line);width:100%;max-width:640px;"
        src="https://open.spotify.com/embed/playlist/6CUXVYGyxQgzqLk9JSLFuQ?utm_source=generator"
        height="352"
        frameborder="0"
        allowfullscreen
        loading="lazy"
        allow="autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture"
        title="Spotify playlist"
      ></iframe>
    </div>

    <p data-reveal style="font-family:var(--mono);font-size:var(--fs-sm);letter-spacing:0.12em;text-transform:uppercase;color:var(--ash);margin:clamp(3rem,6vw,5rem) 0 0;">Nothing here is sponsored. Most of it I'd defend in an argument.</p>
  </section>
</main>
</BaseLayout>

<style>
  .shelf-link:hover { color: var(--ember); }

  .spines {
    display: flex; align-items: flex-end; gap: 4px;
    width: max-content; max-width: 100%;
    margin-top: clamp(2.2rem, 4vw, 3rem);
    padding: 0 18px 0 6px;
    border-bottom: 3px solid var(--bone);
  }
  .spine {
    position: relative; flex: none;
    width: var(--w); height: var(--h);
    display: flex; align-items: center; justify-content: center;
    padding: 18px 0;
    color: var(--coal);
    border-radius: 2px 2px 0 0;
    box-shadow: inset -3px 0 0 rgba(0, 0, 0, 0.12), inset 2px 0 0 rgba(255, 255, 255, 0.08);
    animation: spine-in .7s cubic-bezier(.2, .7, .2, 1) both;
    animation-delay: calc(var(--i) * 70ms + .35s);
    transition: transform .3s cubic-bezier(.2, .7, .2, 1);
  }
  /* the two bands every cloth spine has */
  .spine::before, .spine::after { content: ''; position: absolute; left: 0; right: 0; height: 2px; background: currentColor; opacity: 0.35; }
  .spine::before { top: 8px; }
  .spine::after { bottom: 8px; }
  .spine-bone { background: var(--bone); }
  .spine-ember { background: var(--ember); }
  .spine-tide { background: var(--tide); }
  .spine-soft { background: var(--coal-soft); color: var(--bone); box-shadow: inset 0 0 0 1px var(--coal-line), inset -3px 0 0 rgba(0, 0, 0, 0.06); }
  .spine-t {
    writing-mode: vertical-rl;
    max-height: 100%; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
    font-family: var(--display); font-weight: 500; font-size: 0.86rem; letter-spacing: 0.02em; line-height: 1;
  }
  .spine-lean { transform-origin: bottom right; transform: rotate(-7deg); margin-left: 10px; }
  @media (hover: hover) { .spine:not(.spine-lean):hover { transform: translateY(-8px); } }
  @keyframes spine-in { from { opacity: 0; translate: 0 -26px; } to { opacity: 1; translate: 0 0; } }
  @media (prefers-reduced-motion: reduce) { .spine { animation: none; } }
</style>

