---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout
  title="Saved — Ilias Ennajmi"
  description="Essays you've saved for later. Stored in your browser, nowhere else."
  active="saved"
  siteFx
>
<main id="main-content">
  <header data-cursor-light style="position:relative;overflow:hidden;padding:clamp(8rem,16vh,12rem) clamp(22px,6vw,64px) clamp(3.5rem,7vw,6rem);">
    <div style="position:absolute;inset:0;z-index:0;background:linear-gradient(180deg,var(--paper-hi) 0%,var(--paper-mid) 60%,var(--coal) 100%);"></div>
    <div style="position:absolute;inset:-12%;z-index:0;background:radial-gradient(55% 48% at 30% 16%, rgba(122,90,76,0.10), transparent 60%);animation:cc-drift2 24s ease-in-out infinite;"></div>
    <div style="position:relative;z-index:1;max-width:1180px;margin:0 auto;animation:cc-rise .9s ease both;">
      <div style="display:flex;align-items:center;gap:14px;font-family:var(--mono);font-size:0.68rem;letter-spacing:0.24em;text-transform:uppercase;color:var(--ash);margin-bottom:clamp(1.6rem,3vw,2.4rem);">
        <span style="width:28px;height:1px;background:var(--ember);"></span>For later
      </div>
      <h1 style="margin:0;font-family:var(--display);font-weight:500;font-size:clamp(3rem,9vw,6.5rem);line-height:0.94;letter-spacing:-0.015em;">Saved<span style="color:var(--ember-vivid);">.</span></h1>
      <p style="font-family:var(--body);font-weight:300;font-style:italic;font-size:clamp(1.15rem,2.2vw,1.5rem);color:var(--bone);opacity:0.82;max-width:52ch;margin:1.6rem 0 0;line-height:1.5;text-wrap:pretty;">Essays you set aside to read later. They live in this browser only — no account, no cloud, no one watching.</p>
    </div>
  </header>

  <section style="max-width:1180px;margin:0 auto;padding:0 clamp(22px,6vw,64px) clamp(3rem,6vw,4.5rem);">
    <div id="saved-root"></div>
  </section>

  <section style="max-width:1180px;margin:0 auto;padding:0 clamp(22px,6vw,64px) clamp(5rem,9vw,7.5rem);border-top:1px solid var(--coal-line);padding-top:clamp(3rem,6vw,4.5rem);">
    <div style="display:flex;align-items:baseline;gap:16px;margin-bottom:clamp(1.4rem,2.5vw,2rem);font-family:var(--mono);font-size:0.66rem;letter-spacing:0.2em;text-transform:uppercase;color:var(--ash);">
      <span>Your reading, honestly</span>
      <span class="cc-rule" style="transform:scaleX(1);"></span>
    </div>
    <div id="reading-log-root"></div>
  </section>
</main>
</BaseLayout>

<style is:global>
  /* injected at runtime via innerHTML — must be global, same reasoning as StrandList */
  .saved-row { background: var(--coal); display: flex; align-items: center; justify-content: space-between; gap: 16px; transition: background .3s; }
  .saved-row:hover { background: var(--coal-soft); }
  .saved-remove { background: none; border: none; cursor: pointer; font-family: var(--mono); font-size: 0.58rem; letter-spacing: 0.12em; text-transform: uppercase; color: var(--ash); padding: 10px 12px; transition: color .25s; }
  .saved-remove:hover { color: var(--ember); }
</style>

<script>
  function esc(s: string) {
    const d = document.createElement('div');
    d.textContent = s;
    return d.innerHTML;
  }

  function renderSaved() {
    const root = document.getElementById('saved-root');
    if (!root) return;
    let list: Array<{ id: string; title: string; tag: string; strand: string; accent: string; read: string; href: string }> = [];
    try { list = JSON.parse(localStorage.getItem('saved-essays') || '[]'); } catch (e) { list = []; }

    if (!list.length) {
      root.innerHTML = `<div style="padding:clamp(3rem,6vw,5rem) 0;text-align:center;">
        <div aria-hidden="true" style="color:var(--coal-line);font-size:1.4rem;letter-spacing:0.4em;margin-bottom:1.4rem;">◇ ◇ ◇</div>
        <p style="margin:0;font-family:var(--display);font-weight:500;font-size:clamp(1.4rem,3vw,2rem);color:var(--bone);">Nothing saved yet.</p>
        <p style="margin:1rem 0 0;font-family:var(--body);font-style:italic;color:var(--ash);font-size:1.05rem;">Open any essay and press &ldquo;Save&rdquo; next to the share links.</p>
        <div style="display:flex;gap:clamp(18px,3vw,32px);justify-content:center;margin-top:2.2rem;font-family:var(--mono);font-size:0.66rem;letter-spacing:0.2em;text-transform:uppercase;">
          <a href="/ulysses/" style="color:var(--tide);border-bottom:1px solid var(--coal-line);padding-bottom:4px;">Ulysses</a>
          <a href="/ilias/" style="color:var(--ember);border-bottom:1px solid var(--coal-line);padding-bottom:4px;">Ilias</a>
        </div>
      </div>`;
      return;
    }

    let html = `<div style="display:flex;align-items:baseline;gap:16px;margin-bottom:clamp(1.4rem,2.5vw,2rem);font-family:var(--mono);font-size:0.66rem;letter-spacing:0.2em;text-transform:uppercase;color:var(--ash);">
      <span>Reading list</span><span class="cc-rule" style="transform:scaleX(1);"></span><span>${list.length} essay${list.length > 1 ? 's' : ''}</span>
    </div><div style="display:grid;gap:1px;background:var(--coal-line);border:1px solid var(--coal-line);">`;
    list.forEach((e) => {
      const acc = e.accent === 'ember' ? 'var(--ember)' : 'var(--tide)';
      html += `<div class="saved-row" style="padding:clamp(12px,2vw,16px) clamp(14px,2.5vw,22px);">
        <a href="${esc(e.href)}" class="charge" style="flex:1;display:flex;flex-wrap:wrap;align-items:baseline;gap:8px 16px;min-width:0;">
          <span style="font-family:var(--display);font-weight:500;font-size:clamp(1.1rem,2vw,1.4rem);letter-spacing:-0.005em;text-wrap:balance;">${esc(e.title)}</span>
          <span style="font-family:var(--mono);font-size:0.58rem;letter-spacing:0.1em;text-transform:uppercase;color:${acc};white-space:nowrap;">${esc(e.strand)} <span style="color:var(--ash);">· ${esc(e.read)}</span></span>
        </a>
        <button type="button" class="saved-remove" data-id="${esc(e.id)}" aria-label="Remove ${esc(e.title)} from saved">Remove ✕</button>
      </div>`;
    });
    html += '</div>';
    root.innerHTML = html;

    root.querySelectorAll('.saved-remove').forEach((btn) => {
      btn.addEventListener('click', () => {
        try {
          const next = list.filter((e) => e.id !== (btn as HTMLElement).dataset.id);
          localStorage.setItem('saved-essays', JSON.stringify(next));
        } catch (e) { /* private mode */ }
        renderSaved();
      });
    });
  }

  // Real numbers only — no fabricated engagement stats, matching the
  // credibility standard the rest of this site holds itself to. If nothing
  // is recorded, the honest thing is to say so, not invent a placeholder.
  function renderReadingLog() {
    const root = document.getElementById('reading-log-root');
    if (!root) return;
    let log: Array<{ id: string; title: string; tag: string; strand: string; minutes: number; completedAt: number }> = [];
    try { log = JSON.parse(localStorage.getItem('reading-log') || '[]'); } catch (e) { log = []; }

    if (!log.length) {
      root.innerHTML = `<div style="padding:clamp(2rem,4vw,3rem) 0;text-align:center;">
        <p style="margin:0;font-family:var(--body);font-style:italic;color:var(--ash);font-size:1.05rem;">Nothing recorded yet — finish an essay and it shows up here.</p>
      </div>`;
      return;
    }

    const totalMinutes = log.reduce((sum, e) => sum + (e.minutes || 0), 0);
    const tagCounts: Record<string, number> = {};
    log.forEach((e) => { tagCounts[e.tag] = (tagCounts[e.tag] || 0) + 1; });
    const topTag = Object.entries(tagCounts).sort((a, b) => b[1] - a[1])[0]?.[0] ?? '—';
    const sorted = [...log].sort((a, b) => b.completedAt - a.completedAt);

    let html = `<div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));gap:1px;background:var(--coal-line);border:1px solid var(--coal-line);margin-bottom:clamp(1.6rem,3vw,2.4rem);">
      <div style="background:var(--coal-soft);padding:clamp(18px,3vw,26px);">
        <div style="font-family:var(--display);font-weight:500;font-size:clamp(1.6rem,3vw,2.2rem);">${log.length}</div>
        <div style="font-family:var(--mono);font-size:0.58rem;letter-spacing:0.12em;text-transform:uppercase;color:var(--ash);margin-top:0.4rem;">Essay${log.length > 1 ? 's' : ''} finished</div>
      </div>
      <div style="background:var(--coal-soft);padding:clamp(18px,3vw,26px);">
        <div style="font-family:var(--display);font-weight:500;font-size:clamp(1.6rem,3vw,2.2rem);">${totalMinutes}</div>
        <div style="font-family:var(--mono);font-size:0.58rem;letter-spacing:0.12em;text-transform:uppercase;color:var(--ash);margin-top:0.4rem;">Minutes, cover to cover</div>
      </div>
      <div style="background:var(--coal-soft);padding:clamp(18px,3vw,26px);">
        <div style="font-family:var(--display);font-weight:500;font-size:clamp(1.3rem,2.4vw,1.7rem);text-wrap:balance;">${esc(topTag)}</div>
        <div style="font-family:var(--mono);font-size:0.58rem;letter-spacing:0.12em;text-transform:uppercase;color:var(--ash);margin-top:0.4rem;">Most-read theme</div>
      </div>
    </div><div style="display:grid;gap:1px;background:var(--coal-line);border:1px solid var(--coal-line);">`;
    sorted.forEach((e) => {
      const acc = e.strand === 'Ilias' ? 'var(--ember)' : 'var(--tide)';
      const date = new Date(e.completedAt).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
      html += `<div style="background:var(--coal);padding:clamp(12px,2vw,16px) clamp(14px,2.5vw,22px);display:flex;flex-wrap:wrap;align-items:baseline;justify-content:space-between;gap:8px 16px;">
        <span style="font-family:var(--body);font-size:clamp(1.02rem,1.8vw,1.2rem);text-wrap:balance;">${esc(e.title)}</span>
        <span style="font-family:var(--mono);font-size:0.56rem;letter-spacing:0.1em;text-transform:uppercase;color:${acc};white-space:nowrap;">${esc(e.strand)} <span style="color:var(--ash);">· ${date}</span></span>
      </div>`;
    });
    html += '</div>';
    root.innerHTML = html;
  }

  document.addEventListener('astro:page-load', () => {
    (window as any).pageBoot({ strand: null, progress: 'page' });
    renderSaved();
    renderReadingLog();
  });
</script>
