---
import '@fontsource-variable/eb-garamond';
import '@fontsource-variable/eb-garamond/wght-italic.css';
import '@fontsource-variable/fraunces';
import '@fontsource-variable/fraunces/wght-italic.css';
import '@fontsource-variable/space-grotesk';
import '../styles/global.css';
const favicon = "data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' fill='%23ebe5db'/%3E%3Cpath d='M16 6l10 10-10 10L6 16z' fill='%23a52716'/%3E%3C/svg%3E";
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Page not found — Ilias Ennajmi</title>
  <link rel="icon" href={favicon} />
  <script is:inline>
    // Standalone page (no BaseLayout), so it needs its own copy of the
    // pre-paint theme application or it flashes paper for ink-mode readers.
    (function () {
      var t = null;
      try { t = localStorage.getItem('theme'); } catch (e) {}
      if (!t) t = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'ink' : 'paper';
      if (t === 'ink') document.documentElement.setAttribute('data-theme', 'ink');
    })();
  </script>
</head>
<body>
  <div style="min-height:100svh;display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;padding:clamp(24px,6vw,64px);background:linear-gradient(180deg,var(--paper-hi) 0%,var(--coal) 100%);">
    <div style="animation:cc-rise .8s ease both;display:flex;flex-direction:column;align-items:center;">
      <span style="width:9px;height:9px;transform:rotate(45deg);border:1px solid var(--ash);background:var(--coal);animation:cc-spin 14s linear infinite;margin-bottom:clamp(1.6rem,4vh,2.6rem);"></span>
      <p style="margin:0 0 1.1rem;font-family:var(--mono);font-size:0.66rem;letter-spacing:0.24em;text-transform:uppercase;color:var(--ash);">№ 404</p>
      <h1 style="margin:0;font-family:var(--display);font-weight:500;font-size:clamp(2rem,5vw,3.6rem);line-height:1.06;letter-spacing:-0.015em;max-width:18ch;text-wrap:balance;">This page was never written.<br><span style="font-style:italic;color:var(--ember-vivid);">Or never chosen.</span></h1>
      <p style="margin:clamp(1.6rem,4vh,2.4rem) 0 0;font-size:clamp(1.05rem,2vw,1.25rem);color:var(--bone);opacity:0.72;max-width:38ch;line-height:1.55;text-wrap:pretty;">Either way, the essays are elsewhere — on why people act, and who profits when they do.</p>
      <div aria-hidden="true" style="margin-top:clamp(1.6rem,3.5vh,2.2rem);color:var(--ember-vivid);font-size:0.66rem;letter-spacing:0.3em;opacity:0.85;">◆ ◇ ◇ ◇ ◇</div>
      <blockquote style="margin:clamp(1.2rem,2.5vh,1.7rem) 0 0;font-family:var(--display);font-weight:400;font-style:italic;font-size:clamp(1rem,1.9vw,1.2rem);line-height:1.45;color:var(--bone);max-width:36ch;text-wrap:pretty;">&ldquo;Clicked a link expecting content. Received a lesson in expectation instead.&rdquo;</blockquote>
      <div style="margin-top:0.6rem;font-family:var(--mono);font-size:0.56rem;letter-spacing:0.14em;text-transform:uppercase;color:var(--ash);">— a lost reader, one star</div>
      <div style="display:flex;gap:clamp(18px,3vw,32px);margin-top:clamp(2rem,5vh,3rem);font-family:var(--mono);font-size:0.66rem;letter-spacing:0.2em;text-transform:uppercase;">
        <a href="/" style="color:var(--bone);border-bottom:1px solid rgba(43,36,25,0.3);padding-bottom:4px;">Back home</a>
        <a href="/ulysses/" style="color:var(--tide);border-bottom:1px solid rgba(43,36,25,0.18);padding-bottom:4px;">Ulysses</a>
        <a href="/ilias/" style="color:var(--ember);border-bottom:1px solid rgba(165,39,22,0.4);padding-bottom:4px;">Ilias</a>
      </div>
    </div>
  </div>
</body>
</html>
