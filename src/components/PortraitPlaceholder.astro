---
interface Props {
  label?: string;
}
const { label = 'PORTRAIT' } = Astro.props;
---
<div style="position:absolute;inset:0;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:10px;text-align:center;background:rgba(43,36,25,0.04);border:1.5px dashed rgba(43,36,25,0.22);">
  <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="var(--ash)" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><path d="m21 15-5-5L5 21"/></svg>
  <span style="font-family:var(--mono);font-size:0.56rem;letter-spacing:0.16em;text-transform:uppercase;color:var(--ash);">{label}</span>
</div>
