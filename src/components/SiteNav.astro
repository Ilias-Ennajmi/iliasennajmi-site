---
interface Props {
  active: 'home' | 'about' | 'ulysses' | 'ilias' | 'shelf' | 'essay' | 'topics' | 'saved' | 'colophon';
}
const { active } = Astro.props;
const on = 'var(--ember)';
const off = 'var(--ash)';
const links = [
  { href: '/', label: 'Index', key: 'home', num: '01' },
  { href: '/about/', label: 'About', key: 'about', num: '02' },
  { href: '/ulysses/', label: 'Ulysses', key: 'ulysses', num: '03' },
  { href: '/ilias/', label: 'Ilias', key: 'ilias', num: '04' },
  { href: '/topics/', label: 'Topics', key: 'topics', num: '05' },
  { href: '/shelf/', label: 'The Shelf', key: 'shelf', num: '06' },
  { href: '/saved/', label: 'Saved', key: 'saved', num: '07' },
];
---

<nav id="sn-bar" aria-label="Primary" style="position:fixed;top:0;left:0;right:0;z-index:7000;display:flex;align-items:center;justify-content:space-between;gap:24px;padding:18px clamp(22px,5vw,52px);background:linear-gradient(180deg,var(--nav-scrim-a),var(--nav-scrim-b));font-family:var(--mono);">
  <a href="/" id="sn-wordmark" style="font-family:var(--display);font-style:italic;font-weight:500;font-size:1.45rem;letter-spacing:0.01em;line-height:1;color:var(--bone);text-decoration:none;">Ilias Ennajmi</a>

  <div id="sn-links" style="display:flex;align-items:center;gap:clamp(16px,3vw,40px);font-size:0.68rem;letter-spacing:0.16em;text-transform:uppercase;color:var(--ash);white-space:nowrap;">
    {links.map((l) => (
      <a href={l.href} class="sn-link" style={`position:relative;color:${active === l.key ? 'var(--bone)' : 'var(--ash)'};text-decoration:none;transition:color .25s;`}>
        {l.label}
        {active === l.key && <span style={`position:absolute;left:0;right:0;bottom:-6px;height:1.5px;background:${l.key === 'ulysses' ? 'var(--tide)' : 'var(--ember)'};`}></span>}
      </a>
    ))}
  </div>

  <div style="display:flex;align-items:center;gap:clamp(14px,2vw,24px);">
    <button id="sn-theme-btn" type="button" aria-label="Switch between paper and ink theme" style="display:flex;align-items:center;justify-content:center;background:none;border:1px solid var(--coal-line);cursor:pointer;color:var(--ash);width:36px;min-height:36px;padding:0;font-size:0.9rem;line-height:1;-webkit-tap-highlight-color:transparent;transition:color .25s,border-color .25s;">◐</button>
    <button id="sn-search-btn" type="button" aria-label="Search essays" style="display:flex;align-items:center;gap:8px;background:none;border:1px solid var(--coal-line);cursor:pointer;font-family:var(--mono);font-size:0.6rem;font-weight:500;letter-spacing:0.1em;text-transform:uppercase;color:var(--ash);padding:8px 12px;min-height:36px;-webkit-tap-highlight-color:transparent;">
      <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="11" cy="11" r="7"/><path d="m21 21-4.3-4.3"/></svg>
      <span class="sn-search-label" style="display:none;">⌘K</span>
    </button>
    <button id="sn-burger" type="button" aria-label="Open menu" aria-expanded="false" aria-controls="sn-drawer" style="display:none;align-items:center;gap:10px;background:none;border:none;cursor:pointer;font-family:var(--mono);font-size:0.64rem;font-weight:500;letter-spacing:0.18em;text-transform:uppercase;color:var(--bone);padding:11px 0;min-height:44px;-webkit-tap-highlight-color:transparent;">
      <span style="display:flex;flex-direction:column;gap:5px;width:24px;">
        <span style="height:1.5px;background:var(--bone);width:100%;"></span>
        <span style="height:1.5px;background:var(--bone);width:100%;"></span>
      </span>
      Menu
    </button>
  </div>
</nav>

<div id="sn-drawer" aria-hidden="true" style="position:fixed;inset:0;z-index:8000;background:var(--coal);display:flex;flex-direction:column;font-family:var(--mono);">
  <div style="display:flex;align-items:center;justify-content:space-between;padding:13px 18px;border-bottom:1px solid var(--coal-line);">
    <a href="/" data-close style="font-family:var(--display);font-style:italic;font-weight:500;font-size:1.16rem;color:var(--bone);text-decoration:none;">Ilias Ennajmi</a>
    <button data-close type="button" aria-label="Close menu" style="display:inline-flex;align-items:center;gap:10px;background:none;border:none;cursor:pointer;font-family:var(--mono);font-size:0.64rem;font-weight:500;letter-spacing:0.18em;text-transform:uppercase;color:var(--bone);padding:11px 0;min-height:44px;-webkit-tap-highlight-color:transparent;">Close <span style="font-size:1.15em;line-height:1;">&#10005;</span></button>
  </div>
  <nav aria-label="Pages" style="flex:1;display:flex;flex-direction:column;justify-content:center;padding:clamp(14px,3vh,32px) clamp(22px,7vw,44px);overflow-y:auto;">
    {links.map((l) => (
      <a data-close href={l.href} style="display:flex;align-items:baseline;gap:18px;padding:clamp(15px,2.3vh,22px) 0;border-bottom:1px solid var(--coal-line);min-height:44px;text-decoration:none;">
        <span style={`font-family:var(--mono);font-size:0.6rem;font-weight:500;letter-spacing:0.14em;width:30px;flex:none;color:${active === l.key ? on : off};`}>{l.num}</span>
        <span style="font-family:var(--display);font-weight:500;font-size:clamp(2.1rem,8vw,3rem);line-height:1;letter-spacing:-0.01em;color:var(--bone);">{l.label}</span>
      </a>
    ))}
  </nav>
  <div style="padding:clamp(18px,3vh,28px) clamp(22px,7vw,44px);border-top:1px solid var(--coal-line);display:flex;flex-wrap:wrap;gap:16px;justify-content:space-between;align-items:center;font-family:var(--mono);font-size:0.6rem;letter-spacing:0.14em;text-transform:uppercase;color:var(--ash);">
    <a data-close href="mailto:hello@iliasennajmi.com" style="min-height:44px;display:inline-flex;align-items:center;color:var(--bone);text-decoration:none;">Email &#8599;</a>
    <span>Built slowly, on purpose</span>
  </div>
</div>

<style>
  .sn-link:hover { color: var(--bone); }
  #sn-search-btn:hover, #sn-theme-btn:hover { color: var(--bone); border-color: var(--ash); }
  @media (min-width: 640px) { .sn-search-label { display: inline !important; } }
</style>

<script>
  // Module-scope (not re-declared per initNav call) so each navigation's
  // fresh nav bar tears down the *previous* page's Escape-key listener
  // before adding a new one — otherwise soft navigation (view transitions)
  // would stack up one document-level keydown listener per page visited.
  let cleanupKeydown: (() => void) | null = null;

  function initNav() {
    if (cleanupKeydown) { cleanupKeydown(); cleanupKeydown = null; }
    const burger = document.getElementById('sn-burger');
    const drawer = document.getElementById('sn-drawer');
    if (!burger || !drawer) return;
    const open = () => {
      drawer.setAttribute('data-open', '1');
      drawer.setAttribute('aria-hidden', 'false');
      burger.setAttribute('aria-expanded', 'true');
      document.body.style.overflow = 'hidden';
    };
    const close = () => {
      drawer.removeAttribute('data-open');
      drawer.setAttribute('aria-hidden', 'true');
      burger.setAttribute('aria-expanded', 'false');
      document.body.style.overflow = '';
    };
    burger.addEventListener('click', open);
    drawer.querySelectorAll('[data-close]').forEach((el) => el.addEventListener('click', close));

    const themeBtn = document.getElementById('sn-theme-btn');
    if (themeBtn) {
      const reduceMotion = () => { try { return window.matchMedia('(prefers-reduced-motion: reduce)').matches; } catch (e) { return false; } };
      // Any in-flight pour gets torn down before starting the next one, so
      // rapid re-clicking can't stack overlays.
      let activePour = null;

      themeBtn.addEventListener('click', (e) => {
        const root = document.documentElement;
        const toInk = root.getAttribute('data-theme') !== 'ink';
        const applyTheme = () => {
          if (toInk) root.setAttribute('data-theme', 'ink');
          else root.removeAttribute('data-theme');
          try { localStorage.setItem('theme', toInk ? 'ink' : 'paper'); } catch (err) { /* private mode */ }
          const meta = document.querySelector('meta[name="theme-color"]');
          if (meta) meta.setAttribute('content', toInk ? '#1c1210' : '#fcf0ec');
        };

        if (reduceMotion()) { applyTheme(); return; }
        if (activePour) { activePour(); activePour = null; }

        // Ink dropped in water: an opaque disc of the *incoming* theme's page
        // background spreads from the clicked button, covering the still-old
        // page underneath. Only once it has fully covered the screen does the
        // real theme actually flip — invisibly, since the flat disc already
        // matches the new background — and then the disc is removed, letting
        // the page's actual texture and text appear under fully-spread ink.
        const r = themeBtn.getBoundingClientRect();
        const cx = r.left + r.width / 2, cy = r.top + r.height / 2;
        const radius = Math.hypot(Math.max(cx, innerWidth - cx), Math.max(cy, innerHeight - cy));
        const pourBg = toInk ? '#1c1210' : '#fcf0ec';

        const overlay = document.createElement('div');
        overlay.style.cssText = 'position:fixed;inset:0;z-index:9998;pointer-events:none;background:' + pourBg + ';' +
          'clip-path:circle(0px at ' + cx + 'px ' + cy + 'px);' +
          'transition:clip-path .6s cubic-bezier(.2,.7,.2,1);';
        document.body.appendChild(overlay);

        let done = false;
        const finish = () => {
          if (done) return;
          done = true;
          applyTheme();
          overlay.remove();
          activePour = null;
        };

        requestAnimationFrame(() => {
          overlay.style.clipPath = 'circle(' + Math.ceil(radius) + 'px at ' + cx + 'px ' + cy + 'px)';
        });

        const timeout = setTimeout(finish, 750);
        overlay.addEventListener('transitionend', () => { clearTimeout(timeout); finish(); }, { once: true });
        activePour = () => { clearTimeout(timeout); if (!done) { done = true; overlay.remove(); } };
      });
    }

    const searchBtn = document.getElementById('sn-search-btn');
    if (searchBtn) {
      searchBtn.addEventListener('click', () => {
        const w = window as unknown as { openCommandPalette?: () => void };
        if (w.openCommandPalette) w.openCommandPalette();
      });
    }

    // swipe up on the open drawer closes it (it animates upward anyway);
    // listeners live on the drawer itself, which is replaced per navigation
    let touchStartY = 0;
    drawer.addEventListener('touchstart', (e) => { touchStartY = e.touches[0].clientY; }, { passive: true });
    drawer.addEventListener('touchmove', (e) => {
      if (e.touches[0].clientY - touchStartY < -70) close();
    }, { passive: true });

    const onKeydown = (e: KeyboardEvent) => { if (e.key === 'Escape') close(); };
    document.addEventListener('keydown', onKeydown);
    cleanupKeydown = () => document.removeEventListener('keydown', onKeydown);
  }
  document.addEventListener('astro:page-load', initNav);
</script>
