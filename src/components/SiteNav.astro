---
interface Props {
  active: 'home' | 'about' | 'ulysses' | 'ilias' | 'shelf' | 'essay';
}
const { active } = Astro.props;
const on = 'var(--ember)';
const off = 'var(--ash)';
const links = [
  { href: '/', label: 'Index', key: 'home', num: '01' },
  { href: '/about/', label: 'About', key: 'about', num: '02' },
  { href: '/ulysses/', label: 'Ulysses', key: 'ulysses', num: '03' },
  { href: '/ilias/', label: 'Ilias', key: 'ilias', num: '04' },
  { href: '/shelf/', label: 'The Shelf', key: 'shelf', num: '05' },
];
---

<nav id="sn-bar" aria-label="Primary" style="position:fixed;top:0;left:0;right:0;z-index:7000;display:flex;align-items:center;justify-content:space-between;gap:24px;padding:18px clamp(22px,5vw,52px);background:linear-gradient(180deg,rgba(231,224,208,0.96),rgba(231,224,208,0));font-family:var(--mono);">
  <a href="/" id="sn-wordmark" style="font-family:var(--display);font-style:italic;font-weight:500;font-size:1.45rem;letter-spacing:0.01em;line-height:1;color:var(--bone);text-decoration:none;">Ilias Ennajmi</a>

  <div id="sn-links" style="display:flex;align-items:center;gap:clamp(16px,3vw,40px);font-size:0.68rem;letter-spacing:0.16em;text-transform:uppercase;color:var(--ash);white-space:nowrap;">
    {links.map((l) => (
      <a href={l.href} class="sn-link" style={`position:relative;color:${active === l.key ? 'var(--bone)' : 'var(--ash)'};text-decoration:none;transition:color .25s;`}>
        {l.label}
        {active === l.key && <span style={`position:absolute;left:0;right:0;bottom:-6px;height:1.5px;background:${l.key === 'ulysses' ? 'var(--tide)' : 'var(--ember)'};`}></span>}
      </a>
    ))}
  </div>

  <button id="sn-burger" type="button" aria-label="Open menu" aria-expanded="false" aria-controls="sn-drawer" style="display:none;align-items:center;gap:10px;background:none;border:none;cursor:pointer;font-family:var(--mono);font-size:0.64rem;font-weight:500;letter-spacing:0.18em;text-transform:uppercase;color:var(--bone);padding:11px 0;min-height:44px;-webkit-tap-highlight-color:transparent;">
    <span style="display:flex;flex-direction:column;gap:5px;width:24px;">
      <span style="height:1.5px;background:var(--bone);width:100%;"></span>
      <span style="height:1.5px;background:var(--bone);width:100%;"></span>
    </span>
    Menu
  </button>
</nav>

<div id="sn-drawer" aria-hidden="true" style="position:fixed;inset:0;z-index:8000;background:var(--coal);display:flex;flex-direction:column;font-family:var(--mono);">
  <div style="display:flex;align-items:center;justify-content:space-between;padding:13px 18px;border-bottom:1px solid var(--coal-line);">
    <a href="/" data-close style="font-family:var(--display);font-style:italic;font-weight:500;font-size:1.16rem;color:var(--bone);text-decoration:none;">Ilias Ennajmi</a>
    <button data-close type="button" aria-label="Close menu" style="display:inline-flex;align-items:center;gap:10px;background:none;border:none;cursor:pointer;font-family:var(--mono);font-size:0.64rem;font-weight:500;letter-spacing:0.18em;text-transform:uppercase;color:var(--bone);padding:11px 0;min-height:44px;-webkit-tap-highlight-color:transparent;">Close <span style="font-size:1.15em;line-height:1;">&#10005;</span></button>
  </div>
  <nav aria-label="Pages" style="flex:1;display:flex;flex-direction:column;justify-content:center;padding:clamp(14px,3vh,32px) clamp(22px,7vw,44px);overflow-y:auto;">
    {links.map((l) => (
      <a data-close href={l.href} style="display:flex;align-items:baseline;gap:18px;padding:clamp(15px,2.3vh,22px) 0;border-bottom:1px solid var(--coal-line);min-height:44px;text-decoration:none;">
        <span style={`font-family:var(--mono);font-size:0.6rem;font-weight:500;letter-spacing:0.14em;width:30px;flex:none;color:${active === l.key ? on : off};`}>{l.num}</span>
        <span style="font-family:var(--display);font-weight:500;font-size:clamp(2.1rem,8vw,3rem);line-height:1;letter-spacing:-0.01em;color:var(--bone);">{l.label}</span>
      </a>
    ))}
  </nav>
  <div style="padding:clamp(18px,3vh,28px) clamp(22px,7vw,44px);border-top:1px solid var(--coal-line);display:flex;flex-wrap:wrap;gap:16px;justify-content:space-between;align-items:center;font-family:var(--mono);font-size:0.6rem;letter-spacing:0.14em;text-transform:uppercase;color:var(--ash);">
    <a data-close href="mailto:hello@iliasennajmi.com" style="min-height:44px;display:inline-flex;align-items:center;color:var(--bone);text-decoration:none;">Email &#8599;</a>
    <span>Built slowly, on purpose</span>
  </div>
</div>

<style>
  .sn-link:hover { color: var(--bone); }
</style>

<script>
  function initNav() {
    const burger = document.getElementById('sn-burger');
    const drawer = document.getElementById('sn-drawer');
    if (!burger || !drawer || (burger as HTMLElement).dataset.bound) return;
    (burger as HTMLElement).dataset.bound = '1';
    const open = () => {
      drawer.setAttribute('data-open', '1');
      drawer.setAttribute('aria-hidden', 'false');
      burger.setAttribute('aria-expanded', 'true');
      document.body.style.overflow = 'hidden';
    };
    const close = () => {
      drawer.removeAttribute('data-open');
      drawer.setAttribute('aria-hidden', 'true');
      burger.setAttribute('aria-expanded', 'false');
      document.body.style.overflow = '';
    };
    burger.addEventListener('click', open);
    drawer.querySelectorAll('[data-close]').forEach((el) => el.addEventListener('click', close));
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape') close(); });
  }
  initNav();
  document.addEventListener('astro:page-load', initNav);
</script>
