---
/**
 * A live anchoring demonstration. The reader is randomly assigned a high or
 * low anchor, answers a comparison question against it, then estimates the
 * real value — and only afterward learns the number was arbitrary and that
 * other readers saw a different one.
 *
 * Deliberately claims no live reader statistics: there is no backend, and
 * inventing an aggregate would be exactly the dishonesty the essay is about.
 * The reveal cites the published effect instead.
 */
---
<aside class="anchor-demo no-print" aria-label="Interactive: test your own anchoring">
  <div class="ad-kicker">
    <span class="ad-diamond" aria-hidden="true"></span>
    Try it on yourself
  </div>

  <!-- Step 1: the comparison question, carrying the arbitrary anchor -->
  <div class="ad-step" data-step="1">
    <p class="ad-q">
      A mid-sized company hires a brand consultancy for a three-month strategy engagement.
      Was the fee more or less than <strong class="ad-anchor-value">—</strong>?
    </p>
    <div class="ad-actions">
      <button type="button" class="ad-btn" data-answer="more">More</button>
      <button type="button" class="ad-btn" data-answer="less">Less</button>
    </div>
  </div>

  <!-- Step 2: the estimate -->
  <div class="ad-step" data-step="2" hidden>
    <p class="ad-q">Now put a number on it. What do you think the fee actually was?</p>
    <div class="ad-actions">
      <label class="ad-field">
        <span class="ad-label">Your estimate</span>
        <span class="ad-input-wrap">
          <span class="ad-currency" aria-hidden="true">€</span>
          <input type="number" class="ad-input" inputmode="numeric" min="0" step="1000" placeholder="0" aria-label="Your estimate in euros" aria-describedby="ad-error" />
        </span>
        <span class="ad-error" id="ad-error" role="alert"></span>
      </label>
      <button type="button" class="ad-btn ad-btn-go" data-submit>Reveal</button>
    </div>
  </div>

  <!-- Step 3: the reveal -->
  <div class="ad-step" data-step="3" hidden>
    <p class="ad-reveal-lead">
      You guessed <strong class="ad-guess">—</strong>, after being shown <strong class="ad-anchor-value">—</strong>.
    </p>
    <p class="ad-reveal-body">
      That number was <em>random</em>. Half of readers were shown
      <strong class="ad-other-value">—</strong> instead — and reliably guess in the
      direction of whichever figure they happened to see. Tversky and Kahneman found
      the effect holds even when people are told outright that the anchor was
      generated by spinning a wheel.
    </p>
    <p class="ad-reveal-foot">
      There is no correct answer here, and this page keeps no record of yours. The
      only thing being demonstrated is that a number you knew was meaningless still
      moved the one you produced.
    </p>
    <button type="button" class="ad-btn ad-btn-reset" data-reset>Run it again</button>
  </div>
</aside>

<style>
  .anchor-demo {
    margin: clamp(2.4rem, 5vw, 3.6rem) 0;
    padding: clamp(20px, 3.5vw, 30px);
    border: 1px solid var(--coal-line);
    background: var(--coal-soft);
  }
  .ad-kicker {
    display: flex; align-items: center; gap: 10px;
    font-family: var(--mono); font-size: 0.6rem; font-weight: 600;
    letter-spacing: 0.2em; text-transform: uppercase; color: var(--ash);
    margin-bottom: 1.2rem;
  }
  .ad-diamond { width: 7px; height: 7px; background: var(--acc, var(--ember)); transform: rotate(45deg); flex: none; }

  .anchor-demo .ad-q,
  .anchor-demo .ad-reveal-lead,
  .anchor-demo .ad-reveal-body,
  .anchor-demo .ad-reveal-foot {
    font-family: var(--body);
    margin: 0 0 1.1rem;
    line-height: 1.55;
    text-wrap: pretty;
  }
  .anchor-demo .ad-q { font-size: clamp(1.08rem, 1.9vw, 1.24rem); color: var(--bone); }
  .anchor-demo .ad-reveal-lead { font-size: clamp(1.15rem, 2.1vw, 1.4rem); color: var(--bone); }
  .anchor-demo .ad-reveal-body { font-size: clamp(1rem, 1.7vw, 1.12rem); color: var(--ash); }
  .anchor-demo .ad-reveal-foot {
    font-size: 0.94rem; font-style: italic; color: var(--ash);
    margin-bottom: 1.4rem; padding-top: 1rem; border-top: 1px solid var(--coal-line);
  }
  .anchor-demo strong { font-weight: 600; color: var(--acc, var(--ember)); font-variant-numeric: tabular-nums; }

  .ad-actions { display: flex; flex-wrap: wrap; align-items: flex-end; gap: 12px; }
  .ad-btn {
    font-family: var(--mono); font-size: 0.64rem; font-weight: 600;
    letter-spacing: 0.16em; text-transform: uppercase;
    background: none; color: var(--bone);
    border: 1px solid var(--coal-line);
    padding: 13px 24px; min-height: 44px; cursor: pointer;
    transition: background .25s, color .25s, border-color .25s;
    -webkit-tap-highlight-color: transparent;
  }
  .ad-btn:hover { background: var(--bone); color: var(--coal); border-color: var(--bone); }
  .ad-btn-go { background: var(--bone); color: var(--coal); border-color: var(--bone); }
  .ad-btn-go:hover { background: var(--acc, var(--ember)); border-color: var(--acc, var(--ember)); }
  .ad-btn-reset { padding: 11px 20px; min-height: 40px; font-size: 0.6rem; }

  .ad-field { display: flex; flex-direction: column; gap: 7px; }
  .ad-label {
    font-family: var(--mono); font-size: 0.56rem; letter-spacing: 0.16em;
    text-transform: uppercase; color: var(--ash);
  }
  .ad-error {
    font-family: var(--mono); font-size: 0.6rem; letter-spacing: 0.05em;
    color: var(--acc, var(--ember)); min-height: 1.4em;
  }
  .ad-error:empty { display: none; }
  .ad-input-wrap { display: flex; align-items: center; border: 1px solid var(--coal-line); background: var(--coal); }
  .ad-currency { padding: 0 0 0 14px; font-family: var(--body); font-size: 1.05rem; color: var(--ash); }
  .ad-input {
    width: 9ch; background: none; border: none; outline: none;
    font-family: var(--body); font-size: 1.05rem; color: var(--bone);
    padding: 12px 14px 12px 6px;
  }
  .ad-input::-webkit-outer-spin-button, .ad-input::-webkit-inner-spin-button { -webkit-appearance: none; margin: 0; }
  .ad-input { -moz-appearance: textfield; }
  .ad-input-wrap:focus-within { border-color: var(--acc, var(--ember)); }
  .ad-btn:focus-visible { outline: 2px solid var(--acc, var(--ember)); outline-offset: 3px; }

  .ad-step[hidden] { display: none; }
  .ad-step { animation: ad-in .45s ease both; }
  @keyframes ad-in { from { opacity: 0; transform: translateY(8px); } to { opacity: 1; transform: none; } }
  @media (prefers-reduced-motion: reduce) { .ad-step { animation: none !important; } }
</style>

<script>
  const LOW = 12000;
  const HIGH = 180000;
  const money = (n: number) => '€' + n.toLocaleString('en-US');

  let cleanupAnchor: (() => void) | null = null;

  function setupAnchorDemo() {
    if (cleanupAnchor) { cleanupAnchor(); cleanupAnchor = null; }
    const root = document.querySelector<HTMLElement>('.anchor-demo');
    if (!root) return;

    const steps = Array.from(root.querySelectorAll<HTMLElement>('.ad-step'));
    const input = root.querySelector<HTMLInputElement>('.ad-input');
    const guessEl = root.querySelector<HTMLElement>('.ad-guess');
    const errorEl = root.querySelector<HTMLElement>('.ad-error');
    const listeners: Array<() => void> = [];

    const on = <K extends keyof HTMLElementEventMap>(el: Element, type: K, fn: (e: HTMLElementEventMap[K]) => void) => {
      el.addEventListener(type, fn as EventListener);
      listeners.push(() => el.removeEventListener(type, fn as EventListener));
    };

    const show = (n: number) => steps.forEach((s) => { s.hidden = s.dataset.step !== String(n); });

    let shownAnchor = LOW;

    const start = () => {
      const high = Math.random() < 0.5;
      const anchor = high ? HIGH : LOW;
      const other = high ? LOW : HIGH;
      shownAnchor = anchor;
      root.querySelectorAll('.ad-anchor-value').forEach((el) => { el.textContent = money(anchor); });
      root.querySelectorAll('.ad-other-value').forEach((el) => { el.textContent = money(other); });
      if (input) input.value = '';
      setError('');
      show(1);
    };

    const track = (name: string, props?: Record<string, string>) => {
      const t = (window as unknown as { track?: (n: string, p?: Record<string, string>) => void }).track;
      if (typeof t === 'function') t(name, props);
    };

    root.querySelectorAll('[data-answer]').forEach((btn) => {
      on(btn, 'click', () => {
        track('anchor-answered', { answer: (btn as HTMLElement).dataset.answer || '' });
        show(2);
        input?.focus();
      });
    });

    const setError = (msg: string) => { if (errorEl) errorEl.textContent = msg; };

    const reveal = () => {
      if (!input) return;
      if (!input.value.trim()) {
        setError('Put a number in first.');
        input.focus();
        return;
      }
      const raw = Number(input.value);
      if (!Number.isFinite(raw) || raw < 0) {
        setError('Needs to be a real number, zero or more.');
        input.focus();
        return;
      }
      setError('');
      if (guessEl) guessEl.textContent = money(Math.round(raw));
      // Which anchor the reader happened to get is the interesting dimension:
      // it's the only thing that differs between the two groups.
      track('anchor-completed', { anchor: shownAnchor === HIGH ? 'high' : 'low' });
      show(3);
    };

    const submitBtn = root.querySelector('[data-submit]');
    if (submitBtn) on(submitBtn, 'click', reveal);
    if (input) {
      on(input, 'keydown', (e) => { if ((e as KeyboardEvent).key === 'Enter') { e.preventDefault(); reveal(); } });
      on(input, 'input', () => setError(''));
    }

    const resetBtn = root.querySelector('[data-reset]');
    if (resetBtn) on(resetBtn, 'click', start);

    start();
    cleanupAnchor = () => listeners.forEach((off) => off());
  }

  document.addEventListener('astro:page-load', setupAnchorDemo);
</script>
