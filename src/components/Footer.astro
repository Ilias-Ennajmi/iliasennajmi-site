<footer style="position:relative;border-top:1px solid var(--coal-line);overflow:hidden;">
  <div data-reveal data-bigrise style="font-family:var(--display);font-weight:800;font-size:clamp(4rem,20vw,16rem);line-height:0.8;color:rgba(28,26,20,0.055);text-align:center;letter-spacing:-0.03em;padding-top:clamp(1.5rem,4vw,3rem);user-select:none;pointer-events:none;white-space:nowrap;">ENNAJMI</div>
  <div style="max-width:1180px;margin:0 auto;padding:1.6rem clamp(22px,6vw,64px) 2.4rem;display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:18px;">
    <span style="font-family:var(--mono);font-size:0.64rem;letter-spacing:0.1em;color:var(--ash);">&copy; 2026 ILIAS ENNAJMI &middot; BUILT SLOWLY, ON PURPOSE</span>
    <div style="display:flex;align-items:center;gap:clamp(16px,2.5vw,30px);font-family:var(--mono);font-size:0.64rem;letter-spacing:0.16em;text-transform:uppercase;color:var(--ash);">
      <a href="/" class="footer-link" data-hover="bone">Home</a>
      <a href="/about/" class="footer-link" data-hover="bone">About</a>
      <a href="/ulysses/" class="footer-link" data-hover="tide">Ulysses</a>
      <a href="/ilias/" class="footer-link" data-hover="ember">Ilias</a>
      <a href="/shelf/" class="footer-link" data-hover="bone">Shelf</a>
      <a href="mailto:hello@iliasennajmi.com" class="footer-link" data-hover="ember">Email</a>
    </div>
  </div>
</footer>

<style>
  .footer-link { transition: color .3s; }
  .footer-link[data-hover="bone"]:hover { color: var(--bone); }
  .footer-link[data-hover="tide"]:hover { color: var(--tide); }
  .footer-link[data-hover="ember"]:hover { color: var(--ember); }
</style>
