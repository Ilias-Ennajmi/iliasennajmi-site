---
import { SITE } from '../lib/site';

interface Props {
  size?: 'default' | 'lg';
}
const { size = 'default' } = Astro.props;
const style = size === 'lg' ? 'font-size:clamp(1.6rem,3.5vw,2.6rem);' : undefined;

// Only render accounts that actually exist — see SITE.social in src/lib/site.ts.
const links = [
  { label: 'Email', href: `mailto:${SITE.email}`, accent: 'ember', external: false },
  { label: 'LinkedIn', href: SITE.social.linkedin, accent: 'tide', external: true },
  { label: 'Instagram', href: SITE.social.instagram, accent: 'ember', external: true },
  { label: 'Threads', href: SITE.social.threads, accent: 'tide', external: true },
  { label: 'Substack', href: SITE.social.substack, accent: 'ember', external: true },
].filter((l): l is { label: string; href: string; accent: string; external: boolean } => Boolean(l.href));
---
{links.map((l) => (
  <a
    href={l.href}
    class={`charge contact-link contact-${l.accent}`}
    style={style}
    target={l.external ? '_blank' : undefined}
    rel={l.external ? 'noopener noreferrer' : undefined}
  >
    {l.label} <span style="font-family:var(--mono);font-size:0.5em;vertical-align:0.4em;">↗</span>
  </a>
))}
