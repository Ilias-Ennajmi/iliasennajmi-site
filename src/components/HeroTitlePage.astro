---
import Face from './Face.astro';
---
<section style="position:relative;min-height:100svh;overflow:hidden;display:flex;align-items:center;justify-content:center;padding:clamp(6rem,11vh,8rem) clamp(20px,5vw,40px) clamp(4rem,8vh,6rem);">
  <div style="position:absolute;inset:0;z-index:0;background:radial-gradient(80% 90% at 0% 24%, rgba(117,89,56,0.07), transparent 56%),radial-gradient(80% 90% at 100% 76%, rgba(117,89,56,0.06), transparent 56%),linear-gradient(180deg,var(--paper-hi) 0%,var(--paper-mid) 56%,var(--coal) 100%);"></div>
  <div id="cc-seam-tint" style="position:absolute;inset:0;z-index:1;pointer-events:none;opacity:0;transition:opacity .6s ease,background .6s ease;"></div>

  <div style="position:relative;z-index:3;display:flex;flex-direction:column;align-items:center;text-align:center;max-width:640px;animation:cc-rise .9s ease both;">

    <div style="position:relative;width:clamp(140px,38vw,168px);aspect-ratio:1;margin-bottom:clamp(1.6rem,3.5vh,2.4rem);">
      <Face mode="hero" uid="hero" style="width:100%;height:100%;cursor:default;" />
    </div>

    <h1 class="hero-name" style="margin:0;font-family:var(--display);font-weight:500;font-style:italic;font-size:clamp(3.1rem,13vw,4.6rem);line-height:1;letter-spacing:-0.015em;color:var(--ember-vivid);">Ilias Ennajmi</h1>
    <div style="margin-top:clamp(0.8rem,1.6vh,1.1rem);font-family:var(--mono);font-weight:600;font-size:clamp(0.8rem,1.6vw,1rem);letter-spacing:0.18em;text-transform:uppercase;color:var(--bone);">Why People Act &amp; Who Profits</div>
    <p style="margin:clamp(1.2rem,2.4vh,1.6rem) 0 0;font-family:var(--body);font-weight:400;font-style:italic;font-size:clamp(1.05rem,2vw,1.25rem);color:var(--ash);line-height:1.5;text-wrap:pretty;">and other observations that won't make you any money</p>

    <!-- The one obvious next step. Before this the hero offered only two
         small inline links and a 1px scroll line, so first-time visitors on
         phones had nothing that read as "start here". -->
    <div class="hero-ctas">
      <a href="/start/" class="hero-cta charge">Start reading <span aria-hidden="true">&rarr;</span></a>
      <a href="/lab/" class="hero-cta-alt charge">or try the Lab</a>
    </div>

    <span class="hero-rule" style="display:block;width:min(220px,42vw);height:1px;background:var(--coal-line);margin:clamp(1.8rem,3.5vh,2.4rem) 0;transform:scaleX(0);transform-origin:center;"></span>

    <!-- flex so the three parts wrap as units: the build strips the spaces
         between them, which left one unbreakable line wider than a phone -->
    <div style="display:flex;flex-wrap:wrap;justify-content:center;column-gap:0.6em;font-family:var(--mono);font-size:max(var(--fs-xs),clamp(0.68rem,1.2vw,0.74rem));letter-spacing:0.16em;text-transform:uppercase;color:var(--ash);line-height:1.9;">
      <span>Written by</span>
      <a href="/ulysses/" class="js-seam-why charge tap" style="color:var(--tide);text-decoration:none;white-space:nowrap;">a behavior obsessive</a>
      <span aria-hidden="true" style="color:var(--coal-line);">/</span>
      <a href="/ilias/" class="js-seam-who charge tap" data-xray="Authority: a job title, worn lightly" style="color:var(--ember);text-decoration:none;white-space:nowrap;">a marketing strategist</a>
    </div>

    <div aria-hidden="true" style="display:flex;gap:0.5em;margin-top:clamp(1.2rem,2.4vh,1.6rem);">
      {Array.from({ length: 5 }).map(() => (
        <span style="width:6px;height:6px;background:var(--ember-vivid);transform:rotate(45deg);flex:none;"></span>
      ))}
    </div>

    <blockquote data-xray="Social proof: a flattering quote, no source" style="margin:clamp(1.6rem,3vh,2.2rem) 0 0;font-family:var(--display);font-weight:400;font-style:italic;font-size:clamp(1.1rem,2.2vw,1.4rem);line-height:1.4;color:var(--bone);max-width:38ch;text-wrap:pretty;">&ldquo;Guy realizes free will isn&rsquo;t real, immediately monetizes the observation.&rdquo;</blockquote>
    <div style="margin-top:0.7rem;font-family:var(--mono);font-size:var(--fs-xs);letter-spacing:0.14em;text-transform:uppercase;color:var(--ash);">A fair summary of this site</div>
  </div>

  <!-- The visual falling-dot line is intentionally 1px wide; the tappable
       area is padded well beyond it on every side so the hit target clears
       44px without changing where the dot itself appears to fall. -->
  <a href="#fork" id="cc-cue" aria-label="Jump to the Fork: choose Ulysses or Ilias" style="position:absolute;left:50%;bottom:clamp(16px,2.6vh,28px);transform:translateX(-50%);z-index:3;display:inline-flex;align-items:flex-end;justify-content:center;padding:26px 24px 6px;">
    <span style="position:relative;display:block;width:1px;height:38px;background:var(--coal-line);overflow:hidden;"><span style="position:absolute;left:-1px;top:0;width:3px;height:11px;background:var(--ember);animation:cc-fall 2.2s ease-in-out infinite;"></span></span>
  </a>
</section>

<style>
  @keyframes hero-rule-draw { from { transform: scaleX(0); } to { transform: scaleX(1); } }
  .hero-rule { animation: hero-rule-draw 1s .5s cubic-bezier(.2,.7,.2,1) both; }
  .hero-ctas { display: flex; flex-wrap: wrap; align-items: center; justify-content: center; gap: 10px 20px; margin-top: clamp(1.6rem, 3.2vh, 2.2rem); }
  .hero-cta {
    display: inline-flex; align-items: center; gap: 10px; min-height: 48px; padding: 0 26px;
    background: var(--bone); color: var(--coal); border-radius: 40px; text-decoration: none;
    font-family: var(--mono); font-size: var(--fs-sm); font-weight: 600; letter-spacing: 0.16em; text-transform: uppercase;
    transition: background .3s, transform .2s;
  }
  .hero-cta:hover { background: var(--ember); }
  .hero-cta:active { transform: scale(.97); }
  .hero-cta-alt {
    display: inline-flex; align-items: center; min-height: 44px;
    font-family: var(--body); font-style: italic; font-size: 1.05rem; color: var(--ash);
    text-decoration: underline; text-decoration-color: var(--coal-line); text-underline-offset: 4px;
  }
  .hero-cta-alt:hover { color: var(--ember); text-decoration-color: currentColor; }
</style>

<script>
  function motionOK() {
    return !window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  }

  // No cleanup/dedup guard needed: this component's DOM (including
  // .js-seam-why/.js-seam-who) is fully replaced on every navigation to
  // "/" by Astro's view-transition swap (nothing here uses
  // transition:persist), so old listeners are GC'd along with their
  // detached nodes rather than accumulating.
  function bindSeam() {
    if (!motionOK()) return;
    const tint = document.getElementById('cc-seam-tint');
    if (!tint) return;
    const set = (rgb: string) => { tint.style.background = `radial-gradient(75% 85% at 50% 38%, rgba(${rgb},0.16), transparent 62%)`; tint.style.opacity = '1'; };
    const clear = () => { tint.style.opacity = '0'; };
    const why = document.querySelector('.js-seam-why');
    const who = document.querySelector('.js-seam-who');
    const enter = (rgb: string) => (e: PointerEvent) => { if (e.pointerType !== 'touch') set(rgb); };
    if (why) { why.addEventListener('pointerenter', enter('117,89,56') as EventListener); why.addEventListener('pointerleave', clear); }
    if (who) { who.addEventListener('pointerenter', enter('165,39,22') as EventListener); who.addEventListener('pointerleave', clear); }
  }

  document.addEventListener('site:ready', bindSeam);
</script>
