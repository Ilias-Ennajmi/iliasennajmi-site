---
import { ClientRouter } from 'astro:transitions';
import '@fontsource-variable/eb-garamond';
import '@fontsource-variable/eb-garamond/wght-italic.css';
import '@fontsource-variable/fraunces';
import '@fontsource-variable/fraunces/wght-italic.css';
import '@fontsource-variable/space-grotesk';
import '../styles/global.css';
// `?url` resolves to the exact same hashed asset Vite emits for the
// @font-face rules above (same source file → same content hash), so the
// preload below is guaranteed to match what the CSS actually requests —
// never a stale hardcoded /_astro/ filename that would silently double-
// download after the next build.
import ebGaramondItalicUrl from '@fontsource-variable/eb-garamond/files/eb-garamond-latin-wght-italic.woff2?url';
import ebGaramondNormalUrl from '@fontsource-variable/eb-garamond/files/eb-garamond-latin-wght-normal.woff2?url';
import frauncesNormalUrl from '@fontsource-variable/fraunces/files/fraunces-latin-wght-normal.woff2?url';
import frauncesItalicUrl from '@fontsource-variable/fraunces/files/fraunces-latin-wght-italic.woff2?url';
import spaceGroteskNormalUrl from '@fontsource-variable/space-grotesk/files/space-grotesk-latin-wght-normal.woff2?url';
import SiteNav from '../components/SiteNav.astro';
import Footer from '../components/Footer.astro';
import GrainOverlay from '../components/GrainOverlay.astro';
import ScrollProgress from '../components/ScrollProgress.astro';
import CommandPalette from '../components/CommandPalette.astro';
import Analytics from '../components/Analytics.astro';
import TouchPrefetch from '../components/TouchPrefetch.astro';

interface Props {
  title: string;
  description: string;
  active: 'home' | 'about' | 'ulysses' | 'ilias' | 'shelf' | 'essay' | 'topics' | 'saved' | 'colophon';
  ogType?: string;
  accent?: string;
  grain?: boolean;
  siteFx?: boolean;
  /** Strand whose accent tints the shared effects (reading rail, header glow). */
  fxStrand?: 'ulysses' | 'ilias';
  /** What the progress rail tracks: the whole page, or just the essay body. */
  fxProgress?: 'page' | 'article';
  ogImage?: string;
  jsonLd?: Record<string, unknown>;
  noindex?: boolean;
}

const {
  title,
  description,
  active,
  ogType = 'website',
  accent = 'var(--ember)',
  grain = true,
  siteFx = false,
  fxStrand,
  fxProgress = 'page',
  ogImage,
  jsonLd,
  noindex = false,
} = Astro.props;

const favicon = "data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' fill='%23ebe5db'/%3E%3Cpath d='M16 6l10 10-10 10L6 16z' fill='%23a52716'/%3E%3C/svg%3E";
const canonicalUrl = new URL(Astro.url.pathname, Astro.site).toString();
const resolvedOgImage = new URL(ogImage ?? '/og/site.png', Astro.site).toString();
// Every page shows the Fraunces-italic wordmark and Space Grotesk nav above
// the fold, plus an EB Garamond italic lede. Upright Fraunces sets every
// page title except the homepage's. Upright EB Garamond is the running text
// of essays and the prose pages, and starts inside the first screen there
// (measured: 250-700 characters above the fold on a phone); elsewhere it is
// below the fold, so it loads normally instead of competing with first paint.
// A font that arrives after first layout re-shapes every line set in it.
const isHome = Astro.url.pathname === '/';
const proseFirst = active === 'essay' || active === 'about' || active === 'colophon';
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <link rel="preload" as="font" type="font/woff2" href={frauncesItalicUrl} crossorigin />
  <link rel="preload" as="font" type="font/woff2" href={spaceGroteskNormalUrl} crossorigin />
  <link rel="preload" as="font" type="font/woff2" href={ebGaramondItalicUrl} crossorigin />
  {!isHome && <link rel="preload" as="font" type="font/woff2" href={frauncesNormalUrl} crossorigin />}
  {proseFirst && <link rel="preload" as="font" type="font/woff2" href={ebGaramondNormalUrl} crossorigin />}
  <title>{title}</title>
  <meta name="description" content={description} />
  {noindex && <meta name="robots" content="noindex,follow" />}
  <link rel="canonical" href={canonicalUrl} />
  <meta property="og:type" content={ogType} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonicalUrl} />
  <meta property="og:site_name" content="Ilias Ennajmi" />
  <meta property="og:locale" content="en_US" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta property="og:image" content={resolvedOgImage} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:image" content={resolvedOgImage} />
  <link rel="icon" href={favicon} />
  <link rel="manifest" href="/manifest.webmanifest" />
  <meta name="theme-color" content="#ebe5db" />
  <script is:inline>
    // Apply the saved (or OS-preferred) theme before first paint, and
    // re-apply after every view-transition swap — the swap replaces <html>
    // attributes with the incoming page's, which would drop data-theme.
    (function () {
      var apply = function () {
        var t = null;
        try { t = localStorage.getItem('theme'); } catch (e) {}
        if (!t) t = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'ink' : 'paper';
        if (t === 'ink') document.documentElement.setAttribute('data-theme', 'ink');
        else document.documentElement.removeAttribute('data-theme');
        var meta = document.querySelector('meta[name="theme-color"]');
        if (meta) meta.setAttribute('content', t === 'ink' ? '#1e1a15' : '#ebe5db');
      };
      apply();
      document.addEventListener('astro:after-swap', apply);
    })();
  </script>
  <script is:inline>
    // Page lifecycle, shared by every script on the site.
    // - 'site:ready' fires once per page view: at DOMContentLoaded on a first
    //   visit (Astro's own astro:page-load waits for the window load event,
    //   i.e. every font, image and embed, which left the menu, theme toggle
    //   and search dead for seconds on slow connections), then on each
    //   client-side navigation.
    // - __life.onReady / __life.onLeave are page-scoped: whatever a page
    //   registers is run for that page and torn down when it's swapped out,
    //   so one page's listeners can never keep running on the next page.
    (function () {
      if (window.__life) return;
      var ready = [], leave = [], ranFor = null;
      // Keyed on the <body> element: client-side navigation replaces it, so
      // this runs exactly once per page, whichever event arrives first.
      var run = function () {
        if (ranFor === document.body) return;
        ranFor = document.body;
        ready.forEach(function (fn) { try { fn(); } catch (e) { console.error(e); } });
        document.dispatchEvent(new Event('site:ready'));
      };
      window.__life = {
        onReady: function (fn) { ready.push(fn); },
        onLeave: function (fn) { leave.push(fn); },
      };
      document.addEventListener('astro:before-swap', function () {
        leave.forEach(function (fn) { try { fn(); } catch (e) { console.error(e); } });
        leave = []; ready = [];
      });
      document.addEventListener('DOMContentLoaded', run, { once: true });
      document.addEventListener('astro:page-load', run);
    })();
  </script>
  <link rel="alternate" type="application/rss+xml" title="Ilias Ennajmi · Essays" href="/rss.xml" />
  {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
  <Analytics />
  <ClientRouter />
  <script is:inline defer src="/site-fx.js"></script>
  <script is:inline defer src="/page-boot.js"></script>
  {import.meta.env.PROD && (
    <script is:inline>
      // Registered only in production builds — a service worker caching
      // pages during local dev would show stale content while iterating.
      if ('serviceWorker' in navigator) {
        window.addEventListener('load', () => { navigator.serviceWorker.register('/sw.js'); });
      }
    </script>
  )}
</head>
<body style="background:var(--coal);min-height:100vh;position:relative;" data-fx={siteFx ? fxProgress : undefined} data-fx-strand={siteFx ? fxStrand : undefined}>
  <a href="#main-content" class="skip-link">Skip to content</a>
  {grain && <GrainOverlay />}
  <ScrollProgress accent={accent} />
  <SiteNav active={active} />
  <slot />
  <Footer />
  <CommandPalette />
  <TouchPrefetch />
</body>
</html>
