---
import '../styles/global.css';
import SiteNav from '../components/SiteNav.astro';
import Footer from '../components/Footer.astro';
import GrainOverlay from '../components/GrainOverlay.astro';
import ScrollProgress from '../components/ScrollProgress.astro';

interface Props {
  title: string;
  description: string;
  active: 'home' | 'about' | 'ulysses' | 'ilias' | 'shelf' | 'essay';
  ogType?: string;
  accent?: string;
  grain?: boolean;
  siteFx?: boolean;
}

const {
  title,
  description,
  active,
  ogType = 'website',
  accent = 'var(--ember)',
  grain = true,
  siteFx = false,
} = Astro.props;

const favicon = "data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' fill='%23e7e0d0'/%3E%3Cpath d='M16 6l10 10-10 10L6 16z' fill='%239c2f24'/%3E%3C/svg%3E";
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta property="og:type" content={ogType} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta name="twitter:card" content="summary" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <link rel="icon" href={favicon} />
  <link rel="alternate" type="application/rss+xml" title="Ilias Ennajmi — Essays" href="/rss.xml" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=EB+Garamond:ital,wght@0,400;0,500;0,600;0,700;0,800;1,400;1,500;1,600&family=Archivo:wght@400;500;600&display=swap" rel="stylesheet" />
  <script is:inline src="https://identity.netlify.com/v1/netlify-identity-widget.js"></script>
  <script is:inline>
    if (window.netlifyIdentity) {
      window.netlifyIdentity.on('init', function (user) {
        if (!user) window.netlifyIdentity.on('login', function () { document.location.href = '/admin/'; });
      });
    }
  </script>
  {siteFx && <script is:inline src="/site-fx.js"></script>}
</head>
<body style="background:var(--coal);min-height:100vh;position:relative;">
  {grain && <GrainOverlay />}
  <ScrollProgress accent={accent} />
  <SiteNav active={active} />
  <slot />
  <Footer />
</body>
</html>
