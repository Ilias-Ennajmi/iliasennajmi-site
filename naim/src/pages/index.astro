---
import '@fontsource-variable/archivo/wdth.css';
import '@fontsource/space-mono/400.css';
import '@fontsource/space-mono/700.css';
import '../styles/global.css';
import {
  artist, socials, bio, journey, photos, venues, dates, videos, release, pressKitIncludes,
} from '../data/naim';
import presskit from '../data/presskit.json';

const site = Astro.site?.href ?? '/';
const title = `${artist.name} — DJ · Morocco ⇄ France`;
const description = `${artist.name} (${artist.stylised}) is a DJ from ${artist.origin}, based between Morocco and France. Upcoming dates, sets, the new single “${release.title}”, booking and press kit.`;

const icon = (n: string) => `/img/icons/${n}.png`;
const typeIcon: Record<string, string> = { club: 'cocktail', festival: 'tent', release: 'vinyl', event: 'calendar', radio: 'boombox' };
const typeLabel: Record<string, string> = { club: 'Club', festival: 'Festival', release: 'Release', event: 'Event', radio: 'Radio' };

const today = new Date().toISOString().slice(0, 10);
const upcoming = dates.filter((d) => d.date >= today).sort((a, b) => a.date.localeCompare(b.date));
const fmt = (iso: string) => {
  const d = new Date(iso + 'T12:00:00Z');
  return {
    day: d.toLocaleDateString('en-GB', { day: '2-digit', timeZone: 'UTC' }),
    month: d.toLocaleDateString('en-GB', { month: 'short', timeZone: 'UTC' }).toUpperCase(),
    year: d.getUTCFullYear(),
    weekday: d.toLocaleDateString('en-GB', { weekday: 'short', timeZone: 'UTC' }).toUpperCase(),
  };
};

const tickerWords = ['Clubs', 'Festival', 'Release', 'Events', 'Radio'];
const tickerIcons = ['globe', 'sun', 'vinyl', 'phone', 'boombox'];

// Three columns for the vertical venues band
const cols = [0, 1, 2].map((c) => venues.filter((_, i) => i % 3 === c));

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'MusicGroup',
      name: artist.name,
      alternateName: artist.stylised,
      genre: ['House', 'Electronic', 'Afro house'],
      url: site,
      image: new URL('/img/og.jpg', site).href,
      sameAs: socials.map((s) => s.href),
    },
    ...upcoming.filter((d) => d.type !== 'release').map((d) => ({
      '@type': 'MusicEvent',
      name: `${artist.name} at ${d.venue}`,
      startDate: d.date,
      eventAttendanceMode: d.type === 'radio' ? 'https://schema.org/OnlineEventAttendanceMode' : 'https://schema.org/OfflineEventAttendanceMode',
      location: { '@type': 'Place', name: d.venue, address: `${d.city}, ${d.country}` },
      performer: { '@type': 'MusicGroup', name: artist.name },
    })),
  ],
};
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#121110" />
    <link rel="canonical" href={site} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL('/img/og.jpg', site).href} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="preload" as="image" href="/img/naim-800.webp" imagesrcset="/img/naim-520.webp 520w, /img/naim-800.webp 800w, /img/naim-1179.webp 1179w" imagesizes="100vw" />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <div class="grain" aria-hidden="true"></div>

    <!-- ───────── NAV ───────── -->
    <header class="nav" data-nav>
      <a href="#top" class="nav__logo" aria-label={`${artist.name} — home`}><span class="logo-mask"></span></a>
      <nav aria-label="Main">
        <ul class="nav__links">
          <li><a href="#about">About</a></li>
          <li><a href="#sets">Sets</a></li>
          <li><a href="#dates">Dates</a></li>
          <li><a href="#press">Press</a></li>
        </ul>
      </nav>
      <a href="#booking" class="btn btn--small btn--red">Booking</a>
    </header>

    <main id="main">
      <!-- ───────── 1 · COVER ───────── -->
      <section class="hero" id="top" aria-label="Cover">
        <div class="hero__bg" aria-hidden="true"></div>
        <picture class="hero__photo">
          <source type="image/webp" srcset="/img/naim-520.webp 520w, /img/naim-800.webp 800w, /img/naim-1179.webp 1179w" sizes="(min-width: 900px) 50vw, 100vw" />
          <img src="/img/naim-1179.jpg" alt="Naïm sitting in a rust armchair, red glasses on, a rotary phone to his ear, a boombox and a disco ball at his feet" width="1179" height="1769" fetchpriority="high" />
        </picture>

        <div class="hero__strip" aria-hidden="true">
          <span>{artist.stylised} — DJ — MA ⇄ FR — {new Date().getFullYear()}</span>
          <span>124 BPM · {release.title.toUpperCase()} · OUT NOW</span>
        </div>

        <div class="hero__meta mono" aria-hidden="true">
          <span>N°001</span><span>Selector</span><span>{artist.origin} ⇄ France</span>
        </div>

        <img class="sticker sticker--hero-a" src={icon('phone')} alt="" aria-hidden="true" width="128" height="128" />
        <img class="sticker sticker--hero-b" src={icon('globe')} alt="" aria-hidden="true" width="128" height="128" />

        <h1 class="hero__logo">
          <span class="visually-hidden">{artist.name}</span>
          <span class="logo-mask logo-mask--hero" aria-hidden="true"></span>
        </h1>

        <a href="#about" class="hero__scroll mono" aria-label="Scroll to the story">
          <span>Scroll</span><i></i>
        </a>
      </section>

      <!-- ───────── TICKER ───────── -->
      <div class="ticker" aria-hidden="true">
        <div class="ticker__track">
          {[0, 1].map(() => (
            <div class="ticker__group">
              {tickerWords.map((w, i) => (<><span>{w}</span><img src={icon(tickerIcons[i])} alt="" width="56" height="56" /></>))}
              {tickerWords.map((w, i) => (<><span>{w}</span><img src={icon(tickerIcons[i])} alt="" width="56" height="56" /></>))}
            </div>
          ))}
        </div>
      </div>

      <!-- ───────── 2 · NAME + BIO ───────── -->
      <section class="intro" id="about">
        <div class="gradient" aria-hidden="true"><i></i><i></i><i></i></div>
        <div class="intro__side mono" aria-hidden="true">
          <span>{artist.stylised}</span><span>—</span><span>BIO</span><span>—</span><span>#01</span>
        </div>
        <div class="intro__inner wrap">
          <p class="kicker mono reveal">{artist.tagline}</p>
          <h2 class="intro__name reveal" aria-label={artist.name}>
            <span data-scramble="NΛIM">NΛIM</span>
          </h2>
          <div class="intro__bio">
            {bio.map((p, i) => <p class={`reveal ${i === 0 ? 'lead' : ''}`}>{p}</p>)}
          </div>
          <div class="intro__links reveal">
            {socials.map((s) => (
              <a href={s.href} target="_blank" rel="noopener" class="chip">{s.label} <span aria-hidden="true">↗</span></a>
            ))}
          </div>
        </div>
      </section>

      <!-- ───────── 3 · CAROUSEL ───────── -->
      <section class="live" aria-labelledby="live-title">
        <div class="wrap live__head">
          <h2 id="live-title" class="h-section reveal"><span class="mono kicker">Live</span>In the room</h2>
          <div class="live__controls">
            <span class="mono live__count"><b data-carousel-index>01</b> / {String(photos.length).padStart(2, '0')}</span>
            <button class="round" data-carousel-prev aria-label="Previous photo">←</button>
            <button class="round" data-carousel-next aria-label="Next photo">→</button>
          </div>
        </div>
        <div class="carousel" data-carousel tabindex="0" aria-roledescription="carousel" aria-label="Performance photos">
          {photos.map((p, i) => (
            <figure class="slide" aria-roledescription="slide" aria-label={`${i + 1} of ${photos.length}`}>
              {p.src ? (
                <img src={p.src} alt={p.alt} loading="lazy" />
              ) : (
                <div class={`slide__ph slide__ph--${i % 3}`}>
                  <img src={icon(p.icon)} alt="" width="200" height="200" />
                  <span class="mono">Performance photo {String(i + 1).padStart(2, '0')}</span>
                </div>
              )}
              <figcaption class="mono"><span>{String(i + 1).padStart(2, '0')}</span>{p.caption}</figcaption>
            </figure>
          ))}
        </div>
        <div class="wrap"><div class="progress" aria-hidden="true"><i data-carousel-bar></i></div></div>
      </section>

      <!-- ───────── 4 · JOURNEY ───────── -->
      <section class="journey wrap" aria-labelledby="journey-title">
        <p class="kicker mono reveal">{journey.kicker}</p>
        <h2 id="journey-title" class="journey__title">
          {journey.title.map((l, i) => <span class={`reveal line line--${i}`}>{l}</span>)}
        </h2>
        <div class="journey__grid">
          <div class="journey__map reveal" aria-hidden="true">
            <svg viewBox="0 0 300 360" class="route">
              <path class="route__path" d="M150 330 C 60 280, 230 220, 140 170 S 90 70, 170 30" />
              <circle cx="150" cy="330" r="7" /><circle cx="170" cy="30" r="7" />
              <text x="168" y="342" class="mono">MA</text><text x="186" y="34" class="mono">FR</text>
            </svg>
            <img class="journey__icon a" src={icon('tape')} alt="" width="120" height="120" />
            <img class="journey__icon b" src={icon('angel')} alt="" width="120" height="120" />
          </div>
          <div class="journey__text">
            {journey.paragraphs.map((p) => <p class="reveal">{p}</p>)}
          </div>
        </div>
        <ul class="stats">
          {journey.stats.map((s) => (
            <li class="reveal"><b>{s.value}</b><span class="mono">{s.label}</span></li>
          ))}
        </ul>
      </section>

      <!-- ───────── 5 · VENUES (vertical band) ───────── -->
      <section class="venues" aria-labelledby="venues-title">
        <div class="venues__copy">
          <p class="kicker mono">Played at</p>
          <h2 id="venues-title" class="h-section">Rooms that<br />stayed late</h2>
          <p>From basement clubs to open-air stages, on both sides of the Mediterranean.</p>
          <img class="venues__icon" src={icon('cocktail')} alt="" width="160" height="160" />
        </div>
        <div class="venues__band" aria-label="Venues list">
          {cols.map((col, ci) => (
            <div class={`venues__col venues__col--${ci}`}>
              <ul class="venues__track">
                {[...col, ...col].map((v, k) => (
                  <li class={`venue venue--${v.style}`} aria-hidden={k >= col.length ? 'true' : undefined}>
                    {v.logo ? <img src={v.logo} alt={v.name} /> : <b>{v.name}</b>}
                    <span class="mono">{v.city}</span>
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      </section>

      <!-- ───────── 6 · BOOKING CTA ───────── -->
      <section class="booking" id="booking" aria-labelledby="booking-title">
        <div class="gradient gradient--hot" aria-hidden="true"><i></i><i></i><i></i></div>
        <div class="wrap booking__inner">
          <div class="booking__lead">
            <img class="booking__phone" src={icon('phone')} alt="" width="220" height="220" />
            <p class="kicker mono">Booking — worldwide</p>
            <h2 id="booking-title" class="booking__title">Pick up<br />the phone.</h2>
            <p class="booking__sub">Clubs, festivals, private events, radio. Tell us the date and the room — we'll take it from there.</p>
            <a class="booking__mail" href={`mailto:${artist.bookingEmail}`}>{artist.bookingEmail}</a>
          </div>
          <form class="form" data-booking-form>
            <div class="form__row">
              <label><span class="mono">Your name</span><input name="name" required autocomplete="name" /></label>
              <label><span class="mono">Email</span><input name="email" type="email" required autocomplete="email" /></label>
            </div>
            <div class="form__row">
              <label><span class="mono">Date</span><input name="date" type="date" /></label>
              <label><span class="mono">City / venue</span><input name="venue" /></label>
            </div>
            <fieldset class="form__type">
              <legend class="mono">Type of gig</legend>
              {['Club', 'Festival', 'Private', 'Radio'].map((t, i) => (
                <label class="pill"><input type="radio" name="type" value={t} checked={i === 0} /><span>{t}</span></label>
              ))}
            </fieldset>
            <label><span class="mono">Tell us more</span><textarea name="message" rows="3"></textarea></label>
            <button class="btn btn--ink" type="submit">Send booking request <span aria-hidden="true">→</span></button>
            <p class="form__note mono">Opens your email app with everything filled in.</p>
          </form>
        </div>
      </section>

      <!-- ───────── 7 · VIDEOS ───────── -->
      <section class="sets wrap" id="sets" aria-labelledby="sets-title">
        <div class="sets__head">
          <h2 id="sets-title" class="h-section reveal"><span class="mono kicker">Watch</span>Hear what he plays</h2>
          <img class="sticker sticker--sets" src={icon('runner')} alt="" width="140" height="140" />
        </div>
        <div class="player" data-player>
          <div class="player__screen" data-player-screen>
            <button class="player__poster" data-player-play aria-label={`Play ${videos[0]?.title}`}>
              <span class="player__icon"><img src={icon('tape')} alt="" width="160" height="160" /></span>
              <span class="player__btn" aria-hidden="true">▶</span>
              <span class="player__title"><b data-player-title>{videos[0]?.title}</b><span class="mono" data-player-place>{videos[0]?.place}</span></span>
            </button>
          </div>
          <ol class="player__list">
            {videos.map((v, i) => (
              <li>
                <button
                  class:list={['track', { 'is-active': i === 0 }]}
                  data-video-index={i}
                  data-yt={v.youtubeId || ''}
                  data-mp4={v.mp4 || ''}
                  data-title={v.title}
                  data-place={v.place}
                >
                  <span class="mono track__n">{String(i + 1).padStart(2, '0')}</span>
                  <span class="track__t"><b>{v.title}</b><span class="mono">{v.place}</span></span>
                  <span class="mono track__l">{v.length}</span>
                  <span class="eq" aria-hidden="true"><i></i><i></i><i></i></span>
                </button>
              </li>
            ))}
          </ol>
        </div>
      </section>

      <!-- ───────── 8 · RELEASE / SPOTIFY ───────── -->
      <section class="release" aria-labelledby="release-title">
        <div class="wrap release__inner">
          <div class="release__art reveal" aria-hidden="true">
            <div class="cover">
              <svg class="cover__spikes" viewBox="0 0 300 80" fill="none" stroke="#121110" stroke-width="3" stroke-linecap="round">
                {[50, 150, 250].map((x, i) => (
                  <g transform={`translate(${x} 4)`}>
                    <path d={`M-46 0H46M0 0V${i === 1 ? 74 : 54}M-12 0L-44 ${i === 1 ? 40 : 30}M12 0L44 ${i === 1 ? 40 : 30}M-6 0L-14 ${i === 1 ? 56 : 42}M6 0L14 ${i === 1 ? 56 : 42}`} />
                  </g>
                ))}
              </svg>
              <div class="cover__blur"></div>
              <span class="cover__strip mono">{release.title.toUpperCase()} — {release.bpm} BPM — {release.key} — {release.year} — {release.artist}</span>
              <span class="logo-mask cover__logo"></span>
            </div>
            <img class="release__vinyl" src={icon('vinyl')} alt="" width="200" height="200" />
          </div>
          <div class="release__copy">
            <p class="kicker mono">New single</p>
            <h2 id="release-title" class="release__title">{release.title}</h2>
            <p>A warm, sun-bleached roller built for the hour when the room stops thinking. Out now.</p>
            {release.spotifyTrackId ? (
              <iframe
                class="spotify"
                title={`${release.title} on Spotify`}
                src={`https://open.spotify.com/embed/track/${release.spotifyTrackId}?utm_source=generator&theme=0`}
                width="100%" height="152" loading="lazy"
                allow="autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture"></iframe>
            ) : (
              <div class="mini-player" data-mini>
                <button class="mini-player__play" data-mini-play aria-label={`Preview ${release.title}`}>▶</button>
                <div class="mini-player__body">
                  <div class="mini-player__meta"><b>{release.title}</b><span class="mono">{release.artist}</span></div>
                  <div class="wave" aria-hidden="true">{Array.from({ length: 48 }, (_, i) => <i style={`--h:${(0.25 + Math.abs(Math.sin(i * 1.7) * Math.cos(i * 0.4))).toFixed(2)}`}></i>)}</div>
                </div>
                <a class="mini-player__sp mono" href={release.spotifyUrl} target="_blank" rel="noopener">Spotify ↗</a>
              </div>
            )}
          </div>
        </div>
      </section>

      <!-- ───────── 9 · DATES ───────── -->
      <section class="dates wrap" id="dates" aria-labelledby="dates-title">
        <div class="dates__head">
          <h2 id="dates-title" class="h-section reveal"><span class="mono kicker">On tour</span>Upcoming dates</h2>
          <ul class="legend mono" aria-label="Legend">
            {Object.keys(typeIcon).map((t) => <li><img src={icon(typeIcon[t])} alt="" width="28" height="28" />{typeLabel[t]}</li>)}
          </ul>
        </div>
        {upcoming.length ? (
          <ol class="gigs">
            {upcoming.map((d) => {
              const f = fmt(d.date);
              return (
                <li class="gig reveal" data-date={d.date}>
                  <time datetime={d.date} class="gig__date"><b>{f.day}</b><span class="mono">{f.month} {f.year}<br />{f.weekday}</span></time>
                  <img class="gig__icon" src={icon(typeIcon[d.type])} alt={typeLabel[d.type]} width="64" height="64" />
                  <div class="gig__where"><b>{d.city}{d.country !== '—' && <span class="mono"> {d.country}</span>}</b><span>{d.venue}</span></div>
                  <span class="gig__type mono">{typeLabel[d.type]}</span>
                  <div class="gig__cta">
                    {d.status === 'soldout' ? <span class="tag tag--out mono">Sold out</span>
                      : d.status === 'free' ? <span class="tag mono">Free</span>
                      : d.status === 'soon' ? <span class="tag tag--soon mono">Tickets soon</span>
                      : d.tickets ? <a class="btn btn--small btn--ink" href={d.tickets}>Tickets ↗</a>
                      : <span class="tag mono">{d.type === 'release' ? 'Out soon' : 'Info soon'}</span>}
                  </div>
                </li>
              );
            })}
          </ol>
        ) : <p class="mono">New dates soon. Want him in your city? <a href="#booking">Book here.</a></p>}
      </section>

      <!-- ───────── 10 · THE BOOTH (special) ───────── -->
      <section class="booth" aria-labelledby="booth-title">
        <div class="wrap">
          <div class="booth__head">
            <p class="kicker mono">Something special</p>
            <h2 id="booth-title" class="h-section">Take the booth</h2>
            <p>Tap the grid, hit play, and make a groove at Naïm's tempo. Every row is a sound — every icon is his.</p>
          </div>
          <div class="seq" data-seq>
            <div class="seq__bar">
              <button class="btn btn--red btn--small" data-seq-play aria-pressed="false"><span data-seq-label>Play</span></button>
              <label class="seq__bpm mono">BPM <input type="range" min="96" max="140" value="124" data-seq-bpm aria-label="Tempo" /><output data-seq-bpm-out>124</output></label>
              <button class="btn btn--ghost btn--small" data-seq-random>Naïm it ✶</button>
              <button class="btn btn--ghost btn--small" data-seq-clear>Clear</button>
            </div>
            <div class="seq__grid" data-seq-grid role="grid" aria-label="Step sequencer"></div>
          </div>
        </div>
      </section>

      <!-- ───────── 11 · PRESS KIT ───────── -->
      <section class="press wrap" id="press" aria-labelledby="press-title">
        <div class="press__card">
          <img class="press__icon" src={icon('calendar')} alt="" width="160" height="160" />
          <div>
            <p class="kicker mono">For promoters & press</p>
            <h2 id="press-title" class="h-section">Press kit</h2>
            <ul class="press__list mono">{pressKitIncludes.map((x) => <li>{x}</li>)}</ul>
          </div>
          <div class="press__action">
            <button class="btn btn--red btn--big" data-press-open>Download press kit <span aria-hidden="true">↓</span></button>
            <p class="mono">Password protected. No password? <a href={`mailto:${artist.managementEmail}?subject=Press%20kit%20access`}>Ask for it</a>.</p>
          </div>
        </div>
      </section>
    </main>

    <!-- ───────── FOOTER ───────── -->
    <footer class="footer">
      <div class="gradient gradient--low" aria-hidden="true"><i></i><i></i><i></i></div>
      <div class="wrap footer__inner">
        <div class="footer__cta">
          <p class="kicker mono">Booking & management</p>
          <a class="footer__mail" href={`mailto:${artist.bookingEmail}`}>{artist.bookingEmail}</a>
        </div>
        <ul class="footer__social">
          {socials.map((s) => <li><a href={s.href} target="_blank" rel="noopener">{s.label} ↗</a></li>)}
        </ul>
        <div class="footer__icons" aria-hidden="true">
          {['globe', 'diver', 'cocktail', 'sun', 'tent', 'crowd', 'vinyl', 'angel', 'tape', 'phone', 'runner', 'calendar', 'boombox', 'alien', 'moon'].map((n) => <img src={icon(n)} alt="" width="64" height="64" loading="lazy" />)}
        </div>
        <span class="logo-mask footer__logo" aria-hidden="true"></span>
        <p class="footer__legal mono"><span>© {new Date().getFullYear()} {artist.name}</span><span>Morocco ⇄ France</span><a href="#top">Back to top ↑</a></p>
      </div>
    </footer>

    <a href="#booking" class="fab" data-fab>Book {artist.name} <span aria-hidden="true">→</span></a>

    <dialog class="modal" data-press-modal aria-labelledby="pk-title">
      <form method="dialog" class="modal__close"><button aria-label="Close">✕</button></form>
      <img src={icon('alien')} alt="" width="120" height="120" class="modal__icon" />
      <h3 id="pk-title">Members only</h3>
      <p>Enter the password to download the press kit.</p>
      <form class="modal__form" data-press-form>
        <label class="visually-hidden" for="pk-pass">Password</label>
        <input id="pk-pass" type="password" autocomplete="off" placeholder="Password" required />
        <button class="btn btn--red" type="submit">Unlock</button>
      </form>
      <p class="modal__msg mono" data-press-msg role="status" aria-live="polite"></p>
    </dialog>

    <script type="application/json" id="presskit-data" set:html={JSON.stringify(presskit)} />
    <script>
      import '../scripts/main.ts';
    </script>
  </body>
</html>
