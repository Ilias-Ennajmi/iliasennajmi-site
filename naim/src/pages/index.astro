---
import '@fontsource-variable/archivo/wdth.css';
import '@fontsource/space-mono/400.css';
import '@fontsource/space-mono/700.css';
import '../styles/global.css';
import Btn from '../components/Btn.astro';
import Socials from '../components/Socials.astro';
import {
  artist, socials, bio, photos, venues, dates, videos, release, pressKitIncludes,
} from '../data/naim';
import presskit from '../data/presskit.json';

const site = Astro.site?.href ?? '/';
const title = `${artist.name} | DJ, Morocco and France`;
const description = `${artist.name} is a DJ from Morocco, playing between Morocco and France. Dates, sets, the single ${release.title}, booking and press kit.`;

const icon = (n: string) => `/img/icons/${n}.png`;
const typeIcon: Record<string, string> = { club: 'cocktail', festival: 'tent', release: 'vinyl', event: 'calendar', radio: 'boombox' };
const typeLabel: Record<string, string> = { club: 'Club', festival: 'Festival', release: 'Release', event: 'Event', radio: 'Radio' };

const today = new Date().toISOString().slice(0, 10);
const upcoming = dates.filter((d) => d.date >= today).sort((a, b) => a.date.localeCompare(b.date));
const typesPresent = (['club', 'festival', 'release', 'event', 'radio'] as const).filter((t) => upcoming.some((d) => d.type === t));
const fmt = (iso: string) => {
  const d = new Date(iso + 'T12:00:00Z');
  return {
    day: d.toLocaleDateString('en-GB', { day: '2-digit', timeZone: 'UTC' }),
    month: d.toLocaleDateString('en-GB', { month: 'short', timeZone: 'UTC' }).toUpperCase(),
    year: d.getUTCFullYear(),
    weekday: d.toLocaleDateString('en-GB', { weekday: 'short', timeZone: 'UTC' }).toUpperCase(),
  };
};
const pad = (n: number) => String(n).padStart(2, '0');
const nextGig = upcoming.find((d) => d.type !== 'release');
const nextLabel = nextGig ? (() => { const f = fmt(nextGig.date); return { date: `${f.day} ${f.month}`, city: nextGig.city }; })() : null;

const venueRows = [
  { label: 'Festivals', items: venues.filter((v) => v.kind === 'festival') },
  { label: 'Clubs', items: venues.filter((v) => v.kind === 'club') },
];
const sections = [
  ['live', '01', 'Live'], ['about', '02', 'About'], ['press', '03', 'Press kit'], ['venues', '04', 'Played at'],
  ['sets', '05', 'Sets'], ['release', '06', 'Paraiso'], ['dates', '07', 'Dates'], ['booth', '08', 'The booth'], ['booking', '09', 'Booking'],
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'MusicGroup', name: artist.name, alternateName: artist.stylised, genre: ['House', 'Electronic'],
      url: site, image: new URL('/img/og.jpg', site).href, sameAs: socials.map((s) => s.href),
    },
    ...upcoming.filter((d) => d.type !== 'release').map((d) => ({
      '@type': 'MusicEvent', name: `${artist.name} at ${d.venue}`, startDate: d.date,
      eventAttendanceMode: d.type === 'radio' ? 'https://schema.org/OnlineEventAttendanceMode' : 'https://schema.org/OfflineEventAttendanceMode',
      location: { '@type': 'Place', name: d.venue, address: [d.city, d.country].filter(Boolean).join(', ') },
      performer: { '@type': 'MusicGroup', name: artist.name },
    })),
  ],
};
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#121110" />
    <link rel="canonical" href={site} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL('/img/og.jpg', site).href} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="preload" as="image" href="/img/naim-800.webp" imagesrcset="/img/naim-520.webp 520w, /img/naim-800.webp 800w, /img/naim-1179.webp 1179w" imagesizes="100vw" />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <canvas class="dust" data-dust aria-hidden="true"></canvas>
    <div class="grain" aria-hidden="true"></div>

    <!-- NAV -->
    <header class="nav" data-nav>
      <div class="nav__bar">
        <a href="#top" class="nav__logo" aria-label={`${artist.name}, home`}><span class="logo-mask"></span></a>
        <nav class="nav__main" aria-label="Main">
          <ul class="nav__links" data-nav-links>
            <li><a href="#about"><i>02</i>About</a></li>
            <li><a href="#press"><i>03</i>Press</a></li>
            <li><a href="#sets"><i>05</i>Sets</a></li>
            <li><a href="#dates"><i>07</i>Dates</a></li>
          </ul>
          <span class="nav__ink" data-nav-ink aria-hidden="true"></span>
        </nav>
        <div class="nav__end">
          {nextLabel && (
            <a class="nav__next" href="#dates" aria-label={`Next date: ${nextLabel.date}, ${nextLabel.city}`}>
              <i class="pulse" aria-hidden="true"></i><span>Next</span><b>{nextLabel.date}<span class="nav__city"> · {nextLabel.city}</span></b>
            </a>
          )}
          <Btn href="#booking" variant="red" size="sm" end="→">Booking</Btn>
          <button class="key key--text nav__menu" data-menu-open aria-expanded="false" aria-controls="menu">Menu</button>
        </div>
        <i class="nav__progress" data-nav-progress aria-hidden="true"></i>
      </div>
    </header>

    <div class="menu" id="menu" data-menu hidden>
      <div class="menu__top">
        <span class="logo-mask menu__logo" aria-hidden="true"></span>
        <button class="key key--text" data-menu-close>Close</button>
      </div>
      <nav aria-label="Sections">
        <ol class="menu__list">
          {sections.map(([id, n, label]) => <li><a href={`#${id}`} data-menu-link><i>{n}</i>{label}</a></li>)}
        </ol>
      </nav>
      <div class="menu__foot"><Socials tone="dark" /></div>
    </div>

    <main id="main">
      <!-- COVER -->
      <section class="hero" id="top" aria-label="Cover">
        <div class="hero__bg" aria-hidden="true"></div>
        <div class="hero__ambient" aria-hidden="true"></div>
        <picture class="hero__photo">
          <source type="image/webp" srcset="/img/naim-520.webp 520w, /img/naim-800.webp 800w, /img/naim-1179.webp 1179w" sizes="(min-width: 900px) 50vw, 100vw" />
          <img src="/img/naim-1179.jpg" alt="Naïm in a rust armchair, red glasses on, a rotary phone to his ear, a boombox and a disco ball at his feet" width="1179" height="1769" fetchpriority="high" />
        </picture>
        <h1 class="hero__logo">
          <span class="visually-hidden">{artist.name}</span>
          <span class="logo-mask logo-mask--hero" aria-hidden="true"></span>
        </h1>
        <p class="hero__line mono" aria-hidden="true"><span>DJ</span><span>Morocco / France</span></p>
      </section>

      <!-- 01 LIVE -->
      <section class="live sec sec--tight" id="live" aria-labelledby="live-title">
        <div class="wrap row-head">
          <header class="sh reveal">
            <span class="sh__n">01</span><span class="sh__k">Live</span>
            <h2 id="live-title" class="sh__t">On the dancefloor</h2>
          </header>
          <div class="live__controls">
            <span class="mono live__count"><b data-carousel-index>01</b> / {pad(photos.length)}</span>
            <button class="key" data-carousel-prev aria-label="Previous photo">←</button>
            <button class="key" data-carousel-next aria-label="Next photo">→</button>
          </div>
        </div>
        <div class="carousel" data-carousel tabindex="0" aria-roledescription="carousel" aria-label="Performance photos">
          {photos.map((p, i) => (
            <figure class="slide" aria-roledescription="slide" aria-label={`${i + 1} of ${photos.length}`}>
              {p.src ? <img src={p.src} alt={p.alt} loading="lazy" /> : (
                <div class={`slide__ph slide__ph--${i % 3}`}><span class="mono">Photo {pad(i + 1)}</span></div>
              )}
              <figcaption class="mono"><span>{pad(i + 1)}</span>{p.caption}</figcaption>
            </figure>
          ))}
        </div>
        <div class="wrap"><div class="progress" aria-hidden="true"><i data-carousel-bar></i></div></div>
      </section>

      <!-- 02 BIO -->
      <section class="intro sec" id="about" aria-label="About">
        <div class="gradient" aria-hidden="true"><i></i><i></i><i></i></div>
        <div class="wrap">
          <header class="sh reveal"><span class="sh__n">02</span><span class="sh__k">{artist.tagline}</span></header>
          <h2 class="intro__name reveal" aria-label={artist.name}><span data-scramble="NΛIM">NΛIM</span></h2>
          <div class="intro__grid">
            <p class="intro__lead reveal">{bio[0]}</p>
            <div class="intro__side reveal">
              <p>{bio[1]}</p>
              <Socials />
            </div>
          </div>
        </div>
      </section>

      <!-- 03 PRESS KIT -->
      <section class="press sec sec--tight" id="press" aria-labelledby="press-title">
        <div class="wrap press__inner">
          <header class="sh reveal">
            <span class="sh__n">03</span><span class="sh__k">For promoters and press</span>
            <h2 id="press-title" class="sh__t">Press kit</h2>
          </header>
          <ul class="press__list mono reveal">{pressKitIncludes.map((x) => <li>{x}</li>)}</ul>
          <div class="press__action reveal">
            <Btn variant="red" end="↓" data-press-open>Download press kit</Btn>
            <p class="mono">Password protected. <a class="lnk" href={`mailto:${artist.managementEmail}?subject=Press%20kit%20access`}>Ask for it</a></p>
          </div>
        </div>
      </section>

      <!-- 04 VENUES -->
      <section class="venues sec sec--ink" id="venues" aria-labelledby="venues-title">
        <div class="wrap">
          <header class="sh reveal">
            <span class="sh__n">04</span><span class="sh__k">Played at</span>
            <h2 id="venues-title" class="sh__t">Dancefloors that stayed late</h2>
          </header>
        </div>
        <div class="venues__rows">
          {venueRows.map((row, r) => (
            <div class="vrow">
              <span class="vrow__label mono">{row.label}</span>
              <div class={`marquee marquee--${r}`}>
                <ul class="marquee__track" aria-label={row.label}>
                  {[...row.items, ...row.items, ...row.items].map((v, k) => (
                    <li class={`venue venue--${v.style}`} aria-hidden={k >= row.items.length ? 'true' : undefined}>
                      {v.logo ? <img src={v.logo} alt={v.name} /> : <b>{v.name}</b>}
                      <span class="mono">{v.city}</span>
                    </li>
                  ))}
                </ul>
              </div>
            </div>
          ))}
        </div>
      </section>

      <!-- 05 REELS -->
      <section class="sets sec sec--tight" id="sets" aria-labelledby="sets-title">
        <div class="wrap row-head">
          <header class="sh reveal">
            <span class="sh__n">05</span><span class="sh__k">Watch</span>
            <h2 id="sets-title" class="sh__t">What he plays</h2>
          </header>
          <div class="live__controls">
            <button class="key" data-reels-prev aria-label="Previous clip">←</button>
            <button class="key" data-reels-next aria-label="Next clip">→</button>
          </div>
        </div>
        <ul class="reels" data-reels aria-label="Video clips">
          {videos.map((v, i) => (
            <li class="reel" data-yt={v.youtubeId || ''} data-mp4={v.mp4 || ''} data-title={v.title}>
              <button class="reel__poster" data-reel-play aria-label={`Play ${v.title}, ${v.place}`} style={v.poster ? `background-image:url(${v.poster})` : undefined}>
                <span class={`reel__ph reel__ph--${i % 3}`} aria-hidden="true"></span>
                <span class="reel__play" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M8 5v14l11-7z" /></svg></span>
                <span class="reel__meta"><b>{v.title}</b><span class="mono">{v.place}</span></span>
              </button>
            </li>
          ))}
        </ul>
      </section>

      <!-- 06 RELEASE -->
      <section class="release sec" id="release" aria-labelledby="release-title">
        <div class="wrap release__inner">
          <div class="release__art reveal" aria-hidden="true">
            <div class="cover">
              <svg class="cover__spikes" viewBox="0 0 300 80" fill="none" stroke="#121110" stroke-width="3" stroke-linecap="round">
                {[50, 150, 250].map((x, i) => (
                  <g transform={`translate(${x} 4)`}>
                    <path d={`M-46 0H46M0 0V${i === 1 ? 74 : 54}M-12 0L-44 ${i === 1 ? 40 : 30}M12 0L44 ${i === 1 ? 40 : 30}M-6 0L-14 ${i === 1 ? 56 : 42}M6 0L14 ${i === 1 ? 56 : 42}`} />
                  </g>
                ))}
              </svg>
              <div class="cover__blur"></div>
              <span class="cover__strip mono">{release.title.toUpperCase()} · {release.bpm} BPM · {release.key} · {release.year}</span>
              <span class="logo-mask cover__logo"></span>
            </div>
          </div>
          <div class="release__copy">
            <header class="sh reveal"><span class="sh__n">06</span><span class="sh__k">New single</span></header>
            <h2 id="release-title" class="release__title reveal">{release.title}</h2>
            <p class="reveal">{release.blurb}</p>
            {release.spotifyTrackId ? (
              <iframe class="spotify" title={`${release.title} on Spotify`}
                src={`https://open.spotify.com/embed/track/${release.spotifyTrackId}?utm_source=generator&theme=0`}
                width="100%" height="152" loading="lazy"
                allow="autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture"></iframe>
            ) : (
              <div class="deck reveal" data-mini>
                <button class="deck__play" data-mini-play aria-label={`Preview ${release.title}`}><svg viewBox="0 0 24 24"><path d="M8 5v14l11-7z" /></svg></button>
                <div class="deck__body">
                  <div class="deck__meta"><b>{release.title}</b><span class="mono">{release.artist} · {release.bpm} BPM</span></div>
                  <div class="wave" aria-hidden="true">{Array.from({ length: 56 }, (_, i) => <i style={`--h:${(0.22 + Math.abs(Math.sin(i * 1.7) * Math.cos(i * 0.4))).toFixed(2)}`}></i>)}</div>
                </div>
                <a class="lnk deck__sp" href={release.spotifyUrl} target="_blank" rel="noopener">Listen on Spotify<span aria-hidden="true">↗</span></a>
              </div>
            )}
          </div>
        </div>
      </section>

      <!-- 07 DATES -->
      <section class="dates sec" id="dates" aria-labelledby="dates-title">
        <div class="wrap">
          <div class="row-head">
            <header class="sh reveal">
              <span class="sh__n">07</span><span class="sh__k">On tour</span>
              <h2 id="dates-title" class="sh__t">Upcoming dates</h2>
            </header>
            <div class="filters" role="group" aria-label="Filter dates by type" data-filters>
              <button class="filter is-on" data-filter="all" aria-pressed="true"><span>All</span><b>{upcoming.length}</b></button>
              {typesPresent.map((t) => (
                <button class="filter" data-filter={t} aria-pressed="false">
                  <img src={icon(typeIcon[t])} alt="" width="40" height="40" /><span>{typeLabel[t]}</span><b>{upcoming.filter((d) => d.type === t).length}</b>
                </button>
              ))}
            </div>
          </div>
          {upcoming.length ? (
            <ol class="gigs">
              {upcoming.map((d) => {
                const f = fmt(d.date);
                return (
                  <li class="gig reveal" data-date={d.date} data-type={d.type} data-title={`${artist.name} at ${d.venue}`} data-place={[d.venue, d.city].join(', ')}>
                    <time datetime={d.date} class="gig__date"><b>{f.day}</b><span class="mono">{f.month} {f.year}<br />{f.weekday}</span></time>
                    <img class="gig__icon" src={icon(typeIcon[d.type])} alt={typeLabel[d.type]} width="64" height="64" />
                    <div class="gig__where"><b>{d.city}{d.country && <span class="mono"> {d.country}</span>}</b><span>{d.venue}</span></div>
                    <button class="lnk gig__cal" data-ics>Add to calendar<span aria-hidden="true">+</span></button>
                    <div class="gig__cta">
                      {d.status === 'soldout' ? <span class="tag tag--out mono">Sold out</span>
                        : d.status === 'free' ? <span class="tag mono">Free</span>
                        : d.status === 'soon' ? <span class="tag tag--soon mono">Tickets soon</span>
                        : d.tickets ? <Btn href={d.tickets} size="sm">Tickets</Btn>
                        : <span class="tag mono">{d.type === 'release' ? 'Out soon' : 'Info soon'}</span>}
                    </div>
                  </li>
                );
              })}
            </ol>
          ) : <p class="mono">New dates soon. Want him in your city? <a href="#booking">Book here.</a></p>}
        </div>
      </section>

      <!-- 08 BOOTH -->
      <section class="booth sec sec--ink" id="booth" aria-labelledby="booth-title">
        <div class="wrap">
          <div class="row-head">
            <header class="sh reveal">
              <span class="sh__n">08</span><span class="sh__k">Play</span>
              <h2 id="booth-title" class="sh__t">Take the booth</h2>
            </header>
            <p class="booth__copy reveal">Tap the grid. Press play. Make a groove at his tempo.</p>
          </div>
          <div class="seq reveal" data-seq>
            <div class="seq__bar">
              <Btn variant="red" size="sm" end="▶" data-seq-play aria-pressed="false"><span data-seq-label>Play</span></Btn>
              <label class="seq__bpm mono">BPM <input type="range" min="96" max="140" value={release.bpm} data-seq-bpm aria-label="Tempo" /><output data-seq-bpm-out>{release.bpm}</output></label>
              <span class="seq__tools">
                <button class="key key--text" data-seq-random>Shuffle ✶</button>
                <button class="key key--text" data-seq-clear>Clear</button>
              </span>
            </div>
            <div class="seq__grid" data-seq-grid role="grid" aria-label="Step sequencer"></div>
          </div>
        </div>
      </section>

      <!-- 09 BOOKING (small, last) -->
      <section class="booking sec sec--tight" id="booking" aria-labelledby="booking-title">
        <div class="gradient gradient--hot" aria-hidden="true"><i></i><i></i><i></i></div>
        <div class="wrap booking__inner">
          <div class="booking__lead" data-ring>
            <img class="booking__phone" src={icon('phone')} alt="" width="256" height="256" />
            <header class="sh reveal"><span class="sh__n">09</span><span class="sh__k">Booking worldwide</span></header>
            <h2 id="booking-title" class="booking__title reveal">Pick up the phone.</h2>
            <p class="booking__sub reveal">Clubs, festivals, private events, radio. Send the date and the city.</p>
            <div class="booking__contact">
              <a class="lnk lnk--big booking__mail" href={`mailto:${artist.bookingEmail}`}>{artist.bookingEmail}</a>
              <button class="key key--text" data-copy={artist.bookingEmail}>Copy</button>
            </div>
          </div>
          <form class="form reveal" data-booking-form>
            <div class="form__row">
              <label><span class="mono">Name</span><input name="name" required autocomplete="name" /></label>
              <label><span class="mono">Email</span><input name="email" type="email" required autocomplete="email" /></label>
            </div>
            <div class="form__row">
              <label><span class="mono">Date</span><input name="date" type="date" /></label>
              <label><span class="mono">City or venue</span><input name="venue" /></label>
            </div>
            <fieldset class="form__type">
              <legend class="mono">Type</legend>
              {['Club', 'Festival', 'Private', 'Radio'].map((t, i) => (
                <label class="tog"><input type="radio" name="type" value={t} checked={i === 0} /><span>{t}</span></label>
              ))}
            </fieldset>
            <Btn type="submit" variant="ink" end="→" class="form__send">Send request</Btn>
          </form>
        </div>
      </section>
    </main>

    <!-- FOOTER -->
    <footer class="footer">
      <div class="wrap footer__inner">
        <div class="footer__top">
          <a class="footer__mail" href={`mailto:${artist.bookingEmail}`}>{artist.bookingEmail}</a>
          <Socials />
        </div>
        <span class="logo-mask footer__logo" aria-hidden="true"></span>
        <p class="footer__legal mono"><span>© {new Date().getFullYear()} {artist.name}</span><span>Morocco / France</span><a class="lnk" href="#top">Back to top ↑</a></p>
      </div>
    </footer>

    <div class="fab" data-fab><Btn href="#booking" variant="red" end="→">Book {artist.name}</Btn></div>

    <dialog class="modal" data-press-modal aria-labelledby="pk-title">
      <form method="dialog" class="modal__close"><button class="key" aria-label="Close">✕</button></form>
      <span class="modal__lock mono" aria-hidden="true">Press kit</span>
      <h3 id="pk-title">Members only</h3>
      <p>Enter the password to download.</p>
      <form class="modal__form" data-press-form>
        <label class="visually-hidden" for="pk-pass">Password</label>
        <input id="pk-pass" type="password" autocomplete="off" placeholder="Password" required />
        <Btn type="submit" variant="red" end="→">Unlock</Btn>
      </form>
      <p class="modal__msg mono" data-press-msg role="status" aria-live="polite"></p>
    </dialog>

    <script type="application/json" id="presskit-data" set:html={JSON.stringify(presskit)} />
    <script>
      import '../scripts/main.ts';
      import '../scripts/ux.ts';
    </script>
  </body>
</html>
