---
import { socials } from '../data/naim';
interface Props { title?: string; tone?: 'light' | 'dark' }
const { title = 'Find me on', tone = 'light' } = Astro.props;
---
<div class:list={['socials', `socials--${tone}`]}>
  <p class="socials__title">{title}</p>
  <ul class="socials__list">
    {socials.map((s) => (
      <li>
        <a class="social" href={s.href} target="_blank" rel="noopener" aria-label={`${title} ${s.label}`}>
          <span class="social__ring" aria-hidden="true">
            {s.icon === 'instagram' && (
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><rect x="3.5" y="3.5" width="17" height="17" rx="5" /><circle cx="12" cy="12" r="4" /><circle cx="17.2" cy="6.8" r=".9" fill="currentColor" stroke="none" /></svg>
            )}
            {s.icon === 'soundcloud' && (
              <svg viewBox="0 0 24 24" fill="currentColor"><path d="M10 9.2v7.3h8.2a3.3 3.3 0 0 0 .5-6.6 5 5 0 0 0-8.7-.7Z" /><rect x="7.6" y="10.4" width="1.3" height="6.1" rx=".6" /><rect x="5.3" y="11.6" width="1.3" height="4.9" rx=".6" /><rect x="3" y="13" width="1.3" height="3.5" rx=".6" /></svg>
            )}
            {s.icon === 'spotify' && (
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"><path d="M6.2 9.4c3.9-1.2 8.3-.9 11.6 1" /><path d="M7 12.6c3.2-.9 6.6-.6 9.3.9" /><path d="M7.8 15.6c2.5-.6 4.9-.4 6.9.7" /></svg>
            )}
            {s.icon === 'ra' && (
              <svg viewBox="0 0 24 24" fill="currentColor"><text x="12" y="16" text-anchor="middle" font-family="Space Mono, monospace" font-weight="700" font-size="11" letter-spacing=".3">RA</text></svg>
            )}
          </span>
          <span class="social__label">{s.label}</span>
        </a>
      </li>
    ))}
  </ul>
</div>
